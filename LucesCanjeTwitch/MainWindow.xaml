<Window x:Class="LucesCanjeTwitch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Luces Canje Twitch"
        Height="760"
        Width="1120"
        MinHeight="520"
        MinWidth="760"
        Background="#F7F4EF"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged">
    <Window.Resources>
        <SolidColorBrush x:Key="ThemeTextBrush" Color="#1F2933" />
        <SolidColorBrush x:Key="ThemeMutedTextBrush" Color="#667085" />
        <SolidColorBrush x:Key="ThemeInputBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ThemeBorderBrush" Color="#E4DED4" />
        <SolidColorBrush x:Key="ThemeSelectionBrush" Color="#216869" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,4,0,10" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Margin" Value="0,4,0,10" />
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource ThemeInputBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ThemeSelectionBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ThemeSelectionBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource ThemeInputBrush}" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,4,8,4" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#216869" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#216869" />
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#FDF2F2" />
            <Setter Property="Foreground" Value="#B42318" />
            <Setter Property="BorderBrush" Value="#F4A7A0" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,5,18,5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#667085" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid MinHeight="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="CheckBoxFrame"
                                    Width="16"
                                    Height="16"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1.5"
                                    CornerRadius="3" />
                            <Path x:Name="CheckMark"
                                  Grid.Column="0"
                                  Data="M 3 8 L 7 12 L 13 4"
                                  Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Visibility="Collapsed" />
                            <ContentPresenter Grid.Column="1"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Margin" Value="0,3,0,10" />
        </Style>
    </Window.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto">
    <Grid Margin="18" MinWidth="900">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="310" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="#FFFCF7"
                BorderBrush="#E4DED4"
                BorderThickness="1"
                CornerRadius="8"
                Padding="18">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Luces Canje Twitch"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Margin="0,0,0,3" />
                    <TextBlock Text="Panel de stream"
                               Foreground="#667085"
                               Margin="0,0,0,18" />

                    <TextBlock Text="Twitch" FontWeight="SemiBold" FontSize="15" />
                    <TextBlock Text="Client ID" Foreground="#667085" Margin="0,8,0,0" />
                    <TextBox x:Name="ClientIdBox" TextChanged="GlobalSettingsChanged" />
                    <Button x:Name="TwitchButton"
                            Style="{StaticResource PrimaryButton}"
                            Content="Conectar Twitch"
                            Click="TwitchButton_Click" />
                    <TextBlock x:Name="TwitchStatusText"
                               Foreground="#667085"
                               TextWrapping="Wrap"
                               Margin="0,6,0,18" />

                    <Separator Margin="0,4,0,16" />

                    <TextBlock Text="Arduino" FontWeight="SemiBold" FontSize="15" />
                    <TextBlock Text="Puerto COM del Arduino" Foreground="#667085" Margin="0,8,0,0" />
                    <ComboBox x:Name="PortComboBox"
                              IsEditable="True"
                              SelectionChanged="GlobalSettingsChanged"
                              DropDownOpened="PortComboBox_DropDownOpened"
                              ToolTip="Escoge el puerto que diga Arduino, CH340, CP210 o USB Serial." />
                    <WrapPanel>
                        <Button Content="Detectar" Click="DetectPortsButton_Click" />
                        <Button Content="Conectar" Click="ConnectArduinoButton_Click" />
                    </WrapPanel>

                    <TextBlock Text="Baudios" Foreground="#667085" Margin="0,8,0,0" />
                    <TextBox x:Name="BaudRateBox" TextChanged="GlobalSettingsChanged" />

                    <TextBlock x:Name="ArduinoStatusText"
                               Foreground="#667085"
                               TextWrapping="Wrap"
                               Margin="0,4,0,18" />

                    <Separator Margin="0,4,0,16" />

                    <TextBlock Text="Inicio" FontWeight="SemiBold" FontSize="15" />
                    <CheckBox x:Name="AutoTwitchCheck"
                              Content="Conectar Twitch al abrir"
                              Checked="GlobalSettingsChanged"
                              Unchecked="GlobalSettingsChanged" />
                    <CheckBox x:Name="AutoArduinoCheck"
                              Content="Conectar Arduino al abrir"
                              Checked="GlobalSettingsChanged"
                              Unchecked="GlobalSettingsChanged" />
                    <CheckBox x:Name="StartHiddenCheck"
                              Content="Abrir minimizada"
                              Checked="GlobalSettingsChanged"
                              Unchecked="GlobalSettingsChanged" />
                    <CheckBox x:Name="DarkModeCheck"
                              Content="Modo oscuro"
                              Checked="ThemeModeChanged"
                              Unchecked="ThemeModeChanged" />

                    <Button Content="Guardar configuracion"
                            Style="{StaticResource PrimaryButton}"
                            Margin="0,14,8,4"
                            Click="SaveButton_Click" />
                    <TextBlock x:Name="SettingsPathText"
                               Foreground="#667085"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <TabControl Grid.Column="2"
                    x:Name="MainTabs"
                    Background="Transparent"
                    BorderBrush="#E4DED4"
                    Padding="0"
                    SelectionChanged="MainTabs_SelectionChanged">
            <TabItem Header="Reglas">
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="310" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Background="#FFFFFF"
                            BorderBrush="#E4DED4"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                                <WrapPanel>
                                    <Button Content="Nueva" Click="AddRuleButton_Click" />
                                    <Button Content="Duplicar" Click="DuplicateRuleButton_Click" />
                                    <Button Content="Eliminar"
                                            Style="{StaticResource DangerButton}"
                                            Click="RemoveRuleButton_Click" />
                                </WrapPanel>
                                <Button Content="Probar regla"
                                        Style="{StaticResource PrimaryButton}"
                                        Click="TestRuleButton_Click" />
                                <Button Content="Parar prueba"
                                        Style="{StaticResource DangerButton}"
                                        Click="StopTestButton_Click" />
                            </StackPanel>

                            <ListBox x:Name="RulesList"
                                     BorderBrush="#E4DED4"
                                     SelectionChanged="RulesList_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="9" Margin="2,3" CornerRadius="6">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding DisplayLabel}"
                                                           Foreground="#667085"
                                                           FontSize="12"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="2"
                            Background="#FFFFFF"
                            BorderBrush="#E4DED4"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="18">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="RuleEditorPanel">
                                <TextBlock Text="Detalle de regla"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,12" />

                                <CheckBox x:Name="RuleEnabledCheck"
                                          Content="Regla activa"
                                          Checked="RuleFieldChanged"
                                          Unchecked="RuleFieldChanged" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Nombre" Foreground="#667085" />
                                        <TextBox x:Name="RuleNameBox" TextChanged="RuleFieldChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Evento" Foreground="#667085" />
                                        <ComboBox x:Name="EventKindBox"
                                                  SelectionChanged="RuleFieldChanged" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Canje especifico" Foreground="#667085" />
                                <TextBox x:Name="RewardTitleBox"
                                         TextChanged="RuleFieldChanged"
                                         ToolTip="Dejalo vacio para aceptar cualquier canje personalizado." />

                                <TextBlock Text="Bits minimos" Foreground="#667085" />
                                <TextBox x:Name="MinimumBitsBox"
                                         TextChanged="RuleFieldChanged"
                                         ToolTip="Para bits, usa el mayor umbral que sea menor o igual a la cantidad recibida." />

                                <StackPanel Orientation="Horizontal" Margin="0,2,0,10">
                                    <CheckBox x:Name="UseLightsCheck"
                                              Content="Activar luces"
                                              Checked="RuleFieldChanged"
                                              Unchecked="RuleFieldChanged" />
                                    <CheckBox x:Name="PlayAudioCheck"
                                              Content="Reproducir audio"
                                              Checked="RuleFieldChanged"
                                              Unchecked="RuleFieldChanged" />
                                </StackPanel>

                                <TextBlock Text="Audio" Foreground="#667085" />
                                <DockPanel LastChildFill="True" Margin="0,4,0,10">
                                    <Button DockPanel.Dock="Right"
                                            Content="Buscar"
                                            Margin="8,0,0,0"
                                            Click="BrowseAudioButton_Click" />
                                    <TextBox x:Name="AudioPathBox"
                                             IsReadOnly="True"
                                             Margin="0" />
                                </DockPanel>

                                <Separator Margin="0,8,0,16" />

                                <TextBlock Text="Pines de salida" Foreground="#667085" />
                                <TextBox x:Name="TargetPinsBox"
                                         TextChanged="RuleFieldChanged"
                                         ToolTip="Dejalo vacio para usar todas las tiras. Ejemplo: 6, 7" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Patron" Foreground="#667085" />
                                        <ComboBox x:Name="PatternBox"
                                                  SelectionChanged="RuleFieldChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Color principal" Foreground="#667085" />
                                        <DockPanel LastChildFill="True" Margin="0,4,0,10">
                                            <Button x:Name="PrimaryColorButton"
                                                    DockPanel.Dock="Right"
                                                    Width="38"
                                                    Margin="8,0,0,0"
                                                    ToolTip="Escoger color"
                                                    Click="PrimaryColorButton_Click" />
                                            <TextBox x:Name="PrimaryColorBox"
                                                     Margin="0"
                                                     TextChanged="RuleFieldChanged" />
                                        </DockPanel>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Color secundario" Foreground="#667085" />
                                <DockPanel LastChildFill="True" Margin="0,4,0,12">
                                    <Button x:Name="SecondaryColorButton"
                                            DockPanel.Dock="Right"
                                            Width="38"
                                            Margin="8,0,0,0"
                                            ToolTip="Escoger color"
                                            Click="SecondaryColorButton_Click" />
                                    <TextBox x:Name="SecondaryColorBox"
                                             Margin="0"
                                             TextChanged="RuleFieldChanged" />
                                </DockPanel>

                                <TextBlock Text="Tercer color" Foreground="#667085" />
                                <DockPanel LastChildFill="True" Margin="0,4,0,12">
                                    <Button x:Name="TertiaryColorButton"
                                            DockPanel.Dock="Right"
                                            Width="38"
                                            Margin="8,0,0,0"
                                            ToolTip="Escoger color"
                                            Click="TertiaryColorButton_Click" />
                                    <TextBox x:Name="TertiaryColorBox"
                                             Margin="0"
                                             TextChanged="RuleFieldChanged" />
                                </DockPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="60" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Brillo" Foreground="#667085" />
                                    <TextBlock x:Name="BrightnessValueText"
                                               Grid.Column="1"
                                               HorizontalAlignment="Right"
                                               Foreground="#667085" />
                                </Grid>
                                <Slider x:Name="BrightnessSlider"
                                        Minimum="0"
                                        Maximum="255"
                                        TickFrequency="1"
                                        ValueChanged="RuleFieldChanged" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Duracion sin audio" Foreground="#667085" />
                                    <TextBlock x:Name="DurationValueText"
                                               Grid.Column="1"
                                               HorizontalAlignment="Right"
                                               Foreground="#667085" />
                                </Grid>
                                <Slider x:Name="DurationSlider"
                                        Minimum="250"
                                        Maximum="60000"
                                        TickFrequency="250"
                                        ValueChanged="RuleFieldChanged" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Delay entre pasos" Foreground="#667085" />
                                    <TextBlock x:Name="CycleValueText"
                                               Grid.Column="1"
                                               HorizontalAlignment="Right"
                                               Foreground="#667085" />
                                </Grid>
                                <Slider x:Name="CycleSlider"
                                        Minimum="10"
                                        Maximum="2000"
                                        TickFrequency="10"
                                        ValueChanged="RuleFieldChanged" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Duracion del paso" Foreground="#667085" />
                                    <TextBlock x:Name="StepValueText"
                                               Grid.Column="1"
                                               HorizontalAlignment="Right"
                                               Foreground="#667085" />
                                </Grid>
                                <Slider x:Name="StepSlider"
                                        Minimum="10"
                                        Maximum="5000"
                                        TickFrequency="10"
                                        ValueChanged="RuleFieldChanged" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Tiras LED">
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="330" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Background="#FFFFFF"
                            BorderBrush="#E4DED4"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                                <WrapPanel>
                                    <Button Content="Nueva" Click="AddStripButton_Click" />
                                    <Button Content="Duplicar" Click="DuplicateStripButton_Click" />
                                    <Button Content="Eliminar"
                                            Style="{StaticResource DangerButton}"
                                            Click="RemoveStripButton_Click" />
                                </WrapPanel>
                            </StackPanel>

                            <ListBox x:Name="StripsList"
                                     BorderBrush="#E4DED4"
                                     SelectionChanged="StripsList_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="9" Margin="2,3" CornerRadius="6">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding DisplayLabel}"
                                                           Foreground="#667085"
                                                           FontSize="12"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="2"
                            Background="#FFFFFF"
                            BorderBrush="#E4DED4"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="18">
                        <StackPanel x:Name="StripEditorPanel">
                            <TextBlock Text="Detalle de tira"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,12" />

                            <TextBlock Text="Nombre" Foreground="#667085" />
                            <TextBox x:Name="StripNameBox" TextChanged="StripFieldChanged" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Pin Arduino" Foreground="#667085" />
                                    <TextBox x:Name="StripPinBox"
                                             TextChanged="StripFieldChanged"
                                             ToolTip="Pin digital donde esta conectado DIN de la tira." />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Cantidad de LEDs" Foreground="#667085" />
                                    <TextBox x:Name="StripLedCountBox" TextChanged="StripFieldChanged" />
                                </StackPanel>
                            </Grid>

                            <Separator Margin="0,16,0,16" />

                            <TextBlock Text="Fondo" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                            <CheckBox x:Name="BackgroundEnabledCheck"
                                      Content="Mantener luces de fondo"
                                      Checked="BackgroundFieldChanged"
                                      Unchecked="BackgroundFieldChanged" />

                            <TextBlock Text="Pines de fondo" Foreground="#667085" />
                            <TextBox x:Name="BackgroundPinsBox"
                                     TextChanged="BackgroundFieldChanged"
                                     ToolTip="Dejalo vacio para usar todas las tiras." />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Patron de fondo" Foreground="#667085" />
                                    <ComboBox x:Name="BackgroundPatternBox"
                                              SelectionChanged="BackgroundFieldChanged" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Brillo de fondo" Foreground="#667085" />
                                    <TextBlock x:Name="BackgroundBrightnessValueText"
                                               HorizontalAlignment="Right"
                                               Foreground="#667085" />
                                    <Slider x:Name="BackgroundBrightnessSlider"
                                            Minimum="0"
                                            Maximum="255"
                                            TickFrequency="1"
                                            ValueChanged="BackgroundFieldChanged" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Color principal de fondo" Foreground="#667085" />
                            <DockPanel LastChildFill="True" Margin="0,4,0,12">
                                <Button x:Name="BackgroundPrimaryColorButton"
                                        DockPanel.Dock="Right"
                                        Width="38"
                                        Margin="8,0,0,0"
                                        ToolTip="Escoger color"
                                        Click="BackgroundPrimaryColorButton_Click" />
                                <TextBox x:Name="BackgroundPrimaryColorBox"
                                         Margin="0"
                                         TextChanged="BackgroundFieldChanged" />
                            </DockPanel>

                            <TextBlock Text="Color secundario de fondo" Foreground="#667085" />
                            <DockPanel LastChildFill="True" Margin="0,4,0,12">
                                <Button x:Name="BackgroundSecondaryColorButton"
                                        DockPanel.Dock="Right"
                                        Width="38"
                                        Margin="8,0,0,0"
                                        ToolTip="Escoger color"
                                        Click="BackgroundSecondaryColorButton_Click" />
                                <TextBox x:Name="BackgroundSecondaryColorBox"
                                         Margin="0"
                                         TextChanged="BackgroundFieldChanged" />
                            </DockPanel>

                            <TextBlock Text="Tercer color de fondo" Foreground="#667085" />
                            <DockPanel LastChildFill="True" Margin="0,4,0,12">
                                <Button x:Name="BackgroundTertiaryColorButton"
                                        DockPanel.Dock="Right"
                                        Width="38"
                                        Margin="8,0,0,0"
                                        ToolTip="Escoger color"
                                        Click="BackgroundTertiaryColorButton_Click" />
                                <TextBox x:Name="BackgroundTertiaryColorBox"
                                         Margin="0"
                                         TextChanged="BackgroundFieldChanged" />
                            </DockPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Delay de fondo" Foreground="#667085" />
                                <TextBlock x:Name="BackgroundCycleValueText"
                                           Grid.Column="1"
                                           HorizontalAlignment="Right"
                                           Foreground="#667085" />
                            </Grid>
                            <Slider x:Name="BackgroundCycleSlider"
                                    Minimum="10"
                                    Maximum="2000"
                                    TickFrequency="10"
                                    ValueChanged="BackgroundFieldChanged" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Duracion del paso de fondo" Foreground="#667085" />
                                <TextBlock x:Name="BackgroundStepValueText"
                                           Grid.Column="1"
                                           HorizontalAlignment="Right"
                                           Foreground="#667085" />
                            </Grid>
                            <Slider x:Name="BackgroundStepSlider"
                                    Minimum="10"
                                    Maximum="5000"
                                    TickFrequency="10"
                                    ValueChanged="BackgroundFieldChanged" />

                            <WrapPanel Margin="0,8,0,0">
                                <Button Content="Aplicar fondo"
                                        Style="{StaticResource PrimaryButton}"
                                        Click="ApplyBackgroundButton_Click" />
                                <Button Content="Apagar tiras"
                                        Style="{StaticResource DangerButton}"
                                        Click="StopLightsButton_Click" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Actividad">
