<Window x:Class="NeoTwitch.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Instalador Neo Twitch"
        Icon="Assets/AppIcon.ico"
        WindowStyle="None"
        ResizeMode="CanMinimize"
        Width="660"
        Height="440"
        MinWidth="560"
        MinHeight="390"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Background="Transparent"
        AllowsTransparency="True"
        Loaded="Window_Loaded"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#14B8A6" />
        <SolidColorBrush x:Key="AccentBrightBrush" Color="#00E5D4" />
        <SolidColorBrush x:Key="PanelBrush" Color="#07121A" />
        <SolidColorBrush x:Key="PanelAltBrush" Color="#0B151D" />
        <SolidColorBrush x:Key="TextBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="MutedBrush" Color="#A9B6C5" />
        <SolidColorBrush x:Key="BorderBrush" Color="#203343" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>

        <Style x:Key="MutedText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>

        <Style x:Key="TitleButton" TargetType="Button">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Frame"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="#1B2A36" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Width" Value="172" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#101C27" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Frame"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource AccentBrightBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Frame" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#14B8A6" Offset="0" />
                        <GradientStop Color="#006A78" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#00E5D4" />
        </Style>

        <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="120" />
            <Setter Property="Height" Value="38" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#09141D" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Margin" Value="0,7,0,0" />
        </Style>
    </Window.Resources>

    <Border BorderBrush="#1D5260"
            BorderThickness="1"
            CornerRadius="14"
            Background="{StaticResource PanelBrush}"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#07121A"
                    CornerRadius="14,14,0,0"
                    BorderBrush="#172A36"
                    BorderThickness="0,0,0,1">
                <Grid Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="42" />
                        <ColumnDefinition Width="42" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Image Source="Assets/AppIcon.png"
                               Width="22"
                               Height="22"
                               Stretch="Uniform"
                               Margin="0,0,8,0" />
                        <TextBlock Text="Neo Twitch"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Style="{StaticResource TitleButton}"
                            Content="−"
                            FontSize="20"
                            Click="MinimizeButton_Click" />
                    <Button Grid.Column="2"
                            Style="{StaticResource TitleButton}"
                            Content="×"
                            FontSize="18"
                            Click="CloseButton_Click" />
                </Grid>
            </Border>

            <Grid Grid.Row="1"
                  Margin="28,24,28,18">
                <Grid x:Name="WelcomePanel">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <Border Width="148"
                                Height="148"
                                CornerRadius="74"
                                Background="#111A23"
                                BorderBrush="#284B58"
                                BorderThickness="1"
                                Margin="0,0,0,14">
                            <Image Source="Assets/AppIcon.png"
                                   Stretch="Uniform"
                                   Margin="8" />
                        </Border>
                        <TextBlock Text="Neo Twitch"
                                   FontSize="25"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock x:Name="VersionText"
                                   Text="Versión 2.2.2"
                                   Style="{StaticResource MutedText}"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <Border Grid.Column="1"
                            Background="{StaticResource BorderBrush}" />

                    <StackPanel Grid.Column="3"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="WelcomeTitleText"
                                   Text="¡Bienvenido a Neo Twitch!"
                                   FontSize="28"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="La app para Windows que conecta tu stream de Twitch con sonidos, luces NeoPixel por Arduino y acciones opcionales con Alexa."
                                   Style="{StaticResource MutedText}"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   Margin="0,15,0,0" />
                        <TextBlock Text="Configura alertas que reaccionan automáticamente a tus eventos."
                                   Style="{StaticResource MutedText}"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   Margin="0,12,0,22" />
                        <Button x:Name="WelcomeInstallButton"
                                Content="Instalar →"
                                Style="{StaticResource PrimaryButton}"
                                Click="NextButton_Click"
                                Margin="0,0,0,10" />
                        <Button x:Name="WelcomeCancelButton"
                                Content="Cancelar"
                                Click="CancelButton_Click" />
                    </StackPanel>
                </Grid>

                <Grid x:Name="OptionsPanel"
                      Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="120" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Opciones de instalación"
                                   FontSize="25"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Personaliza tu instalación para que Neo Twitch se adapte a tu stream."
                                   Style="{StaticResource MutedText}"
                                   TextWrapping="Wrap"
                                   Margin="0,5,0,16" />

                        <TextBlock Text="Carpeta de destino"
                                   FontWeight="SemiBold" />
                        <Grid Margin="0,7,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="104" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="InstallPathBox" />
                            <Button Grid.Column="1"
                                    Style="{StaticResource SmallButton}"
                                    Width="96"
                                    Content="Cambiar..."
                                    Margin="8,0,0,0"
                                    Click="BrowseButton_Click" />
                        </Grid>

                        <TextBlock Text="Accesos directos"
                                   FontWeight="SemiBold" />
                        <CheckBox x:Name="DesktopShortcutCheck"
                                  Content="Crear acceso directo en el escritorio"
                                  IsChecked="True" />
                        <CheckBox x:Name="StartMenuShortcutCheck"
                                  Content="Crear acceso directo en el menú inicio"
                                  IsChecked="True" />
                        <CheckBox x:Name="StartWithWindowsCheck"
                                  Content="Ejecutar Neo Twitch al iniciar Windows" />
                        <CheckBox x:Name="LaunchAfterInstallCheck"
                                  Content="Abrir Neo Twitch al finalizar la instalación"
                                  IsChecked="True"
                                  Margin="0,16,0,0" />
                    </StackPanel>

                    <Image Grid.Column="1"
                           Source="Assets/AppIcon.png"
                           Opacity="0.22"
                           Stretch="Uniform"
                           VerticalAlignment="Top"
                           Margin="8,18,0,0" />
                </Grid>

                <Grid x:Name="InstallingPanel"
                      Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Width="160"
                            Height="160"
                            CornerRadius="80"
                            Background="#07131B"
                            BorderBrush="#1D5260"
                            BorderThickness="1"
                            VerticalAlignment="Center">
                        <Image Source="Assets/AppIcon.png"
                               Stretch="Uniform"
                               Margin="10" />
                    </Border>

                    <StackPanel Grid.Column="2"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="InstallingTitleText"
                                   Text="Instalando Neo Twitch"
                                   FontSize="27"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Prepara tu stream con alertas, luces y más."
                                   Style="{StaticResource MutedText}"
                                   Margin="0,6,0,22" />
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ProgressMessageText"
                                       Text="Preparando instalación"
                                       Style="{StaticResource MutedText}" />
                            <TextBlock x:Name="ProgressPercentText"
                                       Grid.Column="1"
                                       Text="0%"
                                       Foreground="{StaticResource AccentBrightBrush}"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Right" />
                        </Grid>
                        <ProgressBar x:Name="InstallProgressBar"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="0"
                                     Height="10"
                                     Foreground="{StaticResource AccentBrush}"
                                     Background="#132231" />
                        <ItemsControl x:Name="ProgressStepsList"
                                      Margin="0,18,0,0" />
                    </StackPanel>
                </Grid>

                <Grid x:Name="CompletePanel"
                      Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <Image Source="Assets/Icons/appstate_ok.png"
                               Width="92"
                               Height="92"
                               Stretch="Uniform"
                               Margin="0,0,0,16" />
                        <TextBlock x:Name="CompleteTitleText"
                                   Text="¡Instalación completada!"
                                   FontSize="27"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock x:Name="CompleteDescriptionText"
                                   Text="Neo Twitch está listo para acompañar tu próximo stream."
                                   Style="{StaticResource MutedText}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Width="380"
                                   Margin="0,8,0,12" />
                        <Border x:Name="ReleaseNotesPanel"
                                Visibility="Collapsed"
                                Width="430"
                                MaxHeight="105"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12"
                                Background="#081722"
                                Margin="0,0,0,12">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="Qué cambió"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,6" />
                                    <TextBlock x:Name="ReleaseNotesText"
                                               Style="{StaticResource MutedText}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                        <CheckBox x:Name="OpenAfterCompleteCheck"
                                  Content="Abrir Neo Twitch al finalizar"
                                  IsChecked="True"
                                  HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>

            <DockPanel x:Name="FooterPanel"
                       Grid.Row="2"
                       LastChildFill="False"
                       Margin="28,0,28,22">
                <TextBlock x:Name="StatusText"
                           DockPanel.Dock="Left"
                                   Style="{StaticResource MutedText}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Width="145" />
                <StackPanel x:Name="ActionButtonsPanel"
                            DockPanel.Dock="Right"
                            Orientation="Horizontal">
                    <Button x:Name="NotesButton"
                            Content="Ver notas"
                            Visibility="Collapsed"
                            Click="NotesButton_Click"
                            Margin="0,0,16,0" />
                    <Button x:Name="CancelButton"
                            Content="Cancelar"
                            Click="CancelButton_Click"
                            Margin="0,0,10,0" />
                    <Button x:Name="NextButton"
                            Content="Instalar ahora →"
                            Style="{StaticResource PrimaryButton}"
                            Click="NextButton_Click" />
                </StackPanel>
            </DockPanel>
        </Grid>
    </Border>
</Window>
