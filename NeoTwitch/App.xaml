<Application x:Class="NeoTwitch.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NeoTwitch">
    <Application.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="Resources/Styles/TypographyStyles.xaml" />
            <ResourceDictionary Source="Resources/Styles/ButtonStyles.xaml" />
            <ResourceDictionary Source="Resources/Styles/InputStyles.xaml" />
            <ResourceDictionary Source="Resources/Styles/ActivityStyles.xaml" />
        </ResourceDictionary.MergedDictionaries>

        <SolidColorBrush x:Key="ThemeWindowBrush" Color="#F7FAFC" />
        <SolidColorBrush x:Key="ThemeSidebarBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ThemeSurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ThemeInputBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="ThemeButtonBrush" Color="#EEF2F6" />
        <SolidColorBrush x:Key="ThemeBorderBrush" Color="#E2E8F0" />
        <SolidColorBrush x:Key="ThemeTextBrush" Color="#0B1117" />
        <SolidColorBrush x:Key="ThemeMutedTextBrush" Color="#475569" />
        <SolidColorBrush x:Key="ThemeSidebarTextBrush" Color="#0B1117" />
        <SolidColorBrush x:Key="ThemeSidebarMutedTextBrush" Color="#64748B" />
        <SolidColorBrush x:Key="ThemeSelectionBrush" Color="#14B8A6" />
        <SolidColorBrush x:Key="ThemeConsoleBrush" Color="#0B1117" />
        <SolidColorBrush x:Key="ThemeScrollThumbBrush" Color="#14B8A6" />
        <SolidColorBrush x:Key="ThemeScrollTrackBrush" Color="#E2E8F0" />

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="18" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,5,18,5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource ThemeInputBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeMutedTextBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid MinHeight="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="CheckBoxFrame"
                                    Width="16"
                                    Height="16"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1.5"
                                    CornerRadius="3" />
                            <Path x:Name="CheckMark"
                                  Grid.Column="0"
                                  Data="M 3 8 L 7 12 L 13 4"
                                  Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Visibility="Collapsed" />
                            <ContentPresenter Grid.Column="1"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                                <Setter TargetName="CheckBoxFrame" Property="BorderBrush" Value="{DynamicResource ThemeSelectionBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid MinHeight="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="RadioFrame"
                                     Width="16"
                                     Height="16"
                                     Stroke="{DynamicResource ThemeMutedTextBrush}"
                                     StrokeThickness="1.6"
                                     Fill="Transparent"
                                     VerticalAlignment="Center" />
                            <Ellipse x:Name="RadioDot"
                                     Width="8"
                                     Height="8"
                                     Fill="{DynamicResource ThemeSelectionBrush}"
                                     Visibility="Collapsed"
                                     VerticalAlignment="Center"
                                     HorizontalAlignment="Left"
                                     Margin="4,0,0,0" />
                            <ContentPresenter Grid.Column="1"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="RadioFrame" Property="Stroke" Value="{DynamicResource ThemeSelectionBrush}" />
                                <Setter TargetName="RadioDot" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Margin" Value="0,3,0,10" />
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="{DynamicResource ThemeScrollTrackBrush}" />
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="MinWidth" Value="12" />
            <Setter Property="MinHeight" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="6"
                                    Opacity="0.55" />
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                  Opacity="0" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb MinHeight="44" MinWidth="44">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{DynamicResource ThemeScrollThumbBrush}"
                                                        CornerRadius="6"
                                                        Margin="2"
                                                        Opacity="0.92" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                  Opacity="0" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HiddenTabItem" TargetType="TabItem">
            <Setter Property="Width" Value="0" />
            <Setter Property="Height" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid Width="0" Height="0" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
