                                                    CornerRadius="12"
                                                    Padding="12"
                                                    Margin="0,0,0,10"
                                                    Background="{DynamicResource ThemeInputBrush}">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="42" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Image Source="/Assets/Icons/service_alexa.png"
                                                               Width="26"
                                                               Height="26"
                                                               Stretch="Uniform" />
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="Alexa"
                                                                       FontWeight="SemiBold" />
                                                            <TextBlock Text="Dispara una rutina o dispositivo."
                                                                       Style="{StaticResource MutedText}"
                                                                       FontSize="12" />
                                                        </StackPanel>
                                                        <CheckBox x:Name="AlexaEventCheck"
                                                                  Grid.Column="2"
                                                                  Content=""
                                                                  IsChecked="{Binding Editor.SendAlexaEvent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  Checked="RuleFieldChanged"
                                                                  Unchecked="RuleFieldChanged" />
                                                    </Grid>
                                                    <StackPanel x:Name="AlexaDetailsPanel"
                                                                Margin="42,12,0,0">
                                                        <TextBlock x:Name="AlexaRuleHintText"
                                                                   Text="Se enviara a Alexa el nombre de esta regla."
                                                                   Style="{StaticResource MutedText}"
                                                                   FontSize="11"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>

                                            <Border x:Name="ObsActionCard"
                                                    BorderBrush="{DynamicResource ThemeBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="12"
                                                    Padding="12"
                                                    Margin="0,0,0,10"
                                                    Background="{DynamicResource ThemeInputBrush}">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="42" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Image Source="/Assets/ServiceObs.png"
                                                               Width="26"
                                                               Height="26"
                                                               Stretch="Uniform" />
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="OBS"
                                                                       FontWeight="SemiBold" />
                                                            <TextBlock Text="Cambia escenas o muestra imagenes/videos."
                                                                       Style="{StaticResource MutedText}"
                                                                       FontSize="12" />
                                                        </StackPanel>
                                                        <CheckBox x:Name="ObsSceneCheck"
                                                                  Grid.Column="2"
                                                                  Content=""
                                                                  IsChecked="{Binding Editor.SendObsScene, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  Checked="RuleFieldChanged"
                                                                  Unchecked="RuleFieldChanged" />
                                                    </Grid>
                                                    <StackPanel x:Name="ObsDetailsPanel"
                                                                Margin="42,12,0,0">
                                                        <StackPanel x:Name="ObsSceneDetailsPanel">
                                                            <TextBlock Text="Escena de OBS"
                                                                       Style="{StaticResource MutedText}" />
                                                            <ComboBox x:Name="RuleObsSceneBox"
                                                                      ItemsSource="{Binding ObsSceneChoices}"
                                                                      DisplayMemberPath="Label"
                                                                      SelectedValuePath="Name"
                                                                      SelectedValue="{Binding Editor.ObsSceneName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                      Margin="0,4,0,0"
                                                                      SelectionChanged="RuleFieldChanged" />

                                                            <Grid x:Name="ObsSceneTimingGrid"
                                                                  Margin="0,10,0,0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="12" />
                                                                    <ColumnDefinition Width="150" />
                                                                    <ColumnDefinition Width="12" />
                                                                    <ColumnDefinition Width="170" />
                                                                </Grid.ColumnDefinitions>
                                                                <CheckBox x:Name="ObsReturnCheck"
                                                                          Content="Volver a la escena anterior"
                                                                          VerticalAlignment="Center"
                                                                          MinHeight="34"
                                                                          IsChecked="{Binding Editor.ObsReturnToPreviousScene, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                          Checked="RuleFieldChanged"
                                                                          Unchecked="RuleFieldChanged" />
                                                                <StackPanel Grid.Column="2">
                                                                    <TextBlock Text="Esperar antes (ms)"
                                                                               Style="{StaticResource MutedText}" />
                                                                    <TextBox x:Name="ObsSceneDelayBox"
                                                                             Text="{Binding Editor.ObsSceneDelayText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                             TextChanged="RuleFieldChanged" />
                                                                </StackPanel>
                                                                <StackPanel x:Name="ObsReturnDelayPanel"
                                                                            Grid.Column="4">
                                                                    <TextBlock Text="Regresar despues de (ms)"
                                                                               Style="{StaticResource MutedText}" />
                                                                    <TextBox x:Name="ObsReturnDelayBox"
                                                                             Text="{Binding Editor.ObsReturnDelayText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                             TextChanged="RuleFieldChanged" />
                                                                </StackPanel>
                                                            </Grid>

                                                            <TextBlock x:Name="RuleObsEmptyHintText"
                                                                       Text="Conecta OBS desde Conexiones para cargar las escenas disponibles."
                                                                       Style="{StaticResource MutedText}"
                                                                       FontSize="11"
                                                                       TextWrapping="Wrap"
                                                                       Margin="0,8,0,0" />
                                                        </StackPanel>

                                                        <CheckBox x:Name="ObsMediaCheck"
                                                                  Content="Mostrar imagen o video"
                                                                  Margin="0,14,0,0"
                                                                  IsChecked="{Binding Editor.SendObsMedia, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  Checked="RuleFieldChanged"
                                                                  Unchecked="RuleFieldChanged" />

                                                        <StackPanel x:Name="ObsMediaDetailsPanel"
                                                                    Margin="22,8,0,0">
                                                            <TextBlock Text="Tipo de medio"
                                                                       Style="{StaticResource MutedText}" />
                                                            <Grid Margin="0,4,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="10" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <Button x:Name="RuleObsImageModeButton"
                                                                        Content="Imagen"
                                                                        Tag="Image"
                                                                        Command="{Binding SelectObsMediaKindCommand}"
                                                                        CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}" />
                                                                <Button x:Name="RuleObsVideoModeButton"
                                                                        Grid.Column="2"
                                                                        Content="Video"
                                                                        Tag="Video"
                                                                        Command="{Binding SelectObsMediaKindCommand}"
                                                                        CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}" />
                                                            </Grid>
                                                            <ComboBox x:Name="RuleObsMediaKindBox"
                                                                      ItemsSource="{Binding ObsMediaKindChoices}"
                                                                      DisplayMemberPath="Label"
                                                                      SelectedValuePath="Value"
                                                                      SelectedValue="{Binding Editor.ObsMediaKind, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                      Visibility="Collapsed"
                                                                      SelectionChanged="RuleFieldChanged" />

                                                            <TextBlock Text="Seleccion"
                                                                       Style="{StaticResource MutedText}" />
                                                            <Grid Margin="0,4,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="10" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <Button x:Name="RuleObsSingleMediaModeButton"
                                                                        Content="Individual"
                                                                        Tag="Single"
                                                                        Command="{Binding SelectObsMediaSourceModeCommand}"
                                                                        CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}" />
                                                                <Button x:Name="RuleObsGroupMediaModeButton"
                                                                        Grid.Column="2"
                                                                        Content="Grupo aleatorio"
                                                                        Tag="Group"
                                                                        Command="{Binding SelectObsMediaSourceModeCommand}"
                                                                        CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}" />
                                                            </Grid>
                                                            <ComboBox x:Name="RuleObsMediaSourceModeBox"
                                                                      ItemsSource="{Binding ObsMediaSourceModeChoices}"
                                                                      DisplayMemberPath="Label"
                                                                      SelectedValuePath="Value"
                                                                      SelectedValue="{Binding Editor.ObsMediaSourceMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                      Visibility="Collapsed"
                                                                      SelectionChanged="RuleFieldChanged" />

                                                            <StackPanel x:Name="ObsMediaDurationPanel">
                                                                <TextBlock Text="Duracion (ms)"
                                                                           Style="{StaticResource MutedText}" />
                                                                <TextBox x:Name="ObsMediaDurationBox"
                                                                         Text="{Binding Editor.ObsMediaDurationText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                         TextChanged="RuleFieldChanged" />
                                                            </StackPanel>

                                                            <StackPanel x:Name="RuleObsMediaAssetPanel"
                                                                        Margin="0,10,0,0">
                                                                <TextBlock Text="Archivo"
                                                                           Style="{StaticResource MutedText}" />
                                                                <ComboBox x:Name="RuleObsMediaAssetBox"
                                                                          ItemsSource="{Binding ObsMediaAssetChoices}"
                                                                          DisplayMemberPath="DisplayName"
                                                                          SelectedValuePath="Id"
                                                                          SelectedValue="{Binding Editor.ObsMediaAssetId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                          SelectionChanged="RuleFieldChanged" />
                                                            </StackPanel>

                                                            <StackPanel x:Name="RuleObsMediaGroupPanel"
                                                                        Margin="0,10,0,0">
                                                                <TextBlock Text="Grupo"
                                                                           Style="{StaticResource MutedText}" />
                                                                <ComboBox x:Name="RuleObsMediaGroupBox"
                                                                          ItemsSource="{Binding ObsMediaGroupChoices}"
                                                                          DisplayMemberPath="Name"
                                                                          SelectedValuePath="Id"
                                                                          SelectedValue="{Binding Editor.ObsMediaGroupId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                          SelectionChanged="RuleFieldChanged" />
                                                            </StackPanel>

                                                            <TextBlock x:Name="RuleObsMediaEmptyHintText"
                                                                       Text="Agrega imagenes o videos en sus bibliotecas para usarlos en OBS."
                                                                       Style="{StaticResource MutedText}"
                                                                       FontSize="11"
                                                                       TextWrapping="Wrap"
                                                                       Margin="0,8,0,0" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>

                                            <Button Content="Eliminar alerta"
                                                    Style="{StaticResource DangerButton}"
                                                    HorizontalContentAlignment="Center"
                                                    Margin="0"
                                                    Command="{Binding RemoveRuleCommand}" />
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>
</views:NeoTwitchView>
