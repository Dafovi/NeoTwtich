<views:NeoTwitchView x:Class="NeoTwitch.Views.AlertsView"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     xmlns:views="clr-namespace:NeoTwitch.Views"
                     mc:Ignorable="d">
    <views:NeoTwitchView.Resources>
        <Style x:Key="AlertToggleSwitchStyle" TargetType="{x:Type CheckBox}">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Grid Width="{TemplateBinding Width}"
                              Height="{TemplateBinding Height}">
                            <Border x:Name="Track"
                                    CornerRadius="13"
                                    Background="{DynamicResource ThemeBorderBrush}"
                                    BorderBrush="{DynamicResource ThemeBorderBrush}"
                                    BorderThickness="1" />
                            <Ellipse x:Name="Thumb"
                                     Width="20"
                                     Height="20"
                                     Margin="3,0,0,0"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center"
                                     Fill="{DynamicResource ThemeMutedTextBrush}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource ThemeSelectionBrush}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource ThemeSelectionBrush}" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0" />
                                <Setter TargetName="Thumb" Property="Fill" Value="#FFFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Opacity" Value="0.45" />
                                <Setter TargetName="Thumb" Property="Opacity" Value="0.65" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AlertLightPatternButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="MinWidth" Value="74" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </views:NeoTwitchView.Resources>

                    <Grid Margin="24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="430" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.ColumnSpan="3" Margin="0,0,0,16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal">
                                <Image Source="/Assets/Icons/activity_notification_lime.png"
                                       Width="30"
                                       Height="30"
                                       Margin="0,3,12,0" />
                                <StackPanel>
                                    <TextBlock Text="Alertas"
                                               FontSize="28"
                                               Style="{StaticResource TitleText}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="Crea y personaliza alertas para interactuar con tu comunidad."
                                               Style="{StaticResource MutedText}"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </StackPanel>

                            <Border Grid.Row="1"
                                    Grid.ColumnSpan="2"
                                    Style="{StaticResource Card}"
                                    Margin="0,16,0,0"
                                    Padding="18">
                                <StackPanel>
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                                  VerticalScrollBarVisibility="Disabled"
                                                  Padding="0,0,0,4">
                                        <StackPanel Orientation="Horizontal">
                                            <Button x:Name="EventFollowTileButton"
                                                    Tag="Follow"
                                                    MinWidth="190"
                                                    MinHeight="50"
                                                    Padding="12,6"
                                                    Margin="0,0,8,0"
                                                    Command="{Binding SelectCategoryFilterCommand}"
                                                    CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Image Source="/Assets/Icons/action_follower_teal.png" Width="30" Height="30" Margin="0,0,10,0" />
                                                    <TextBlock Text="Nuevo seguidor" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="EventSubscriptionTileButton"
                                                    Tag="Subscription"
                                                    MinWidth="190"
                                                    MinHeight="50"
                                                    Padding="12,6"
                                                    Margin="0,0,8,0"
                                                    Command="{Binding SelectCategoryFilterCommand}"
                                                    CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Image Source="/Assets/Icons/action_subscription_purple.png" Width="30" Height="30" Margin="0,0,10,0" />
                                                    <TextBlock Text="Nueva suscripcion" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="EventRaidTileButton"
                                                    Tag="Raid"
                                                    MinWidth="170"
                                                    MinHeight="50"
                                                    Padding="12,6"
                                                    Margin="0,0,8,0"
                                                    Command="{Binding SelectCategoryFilterCommand}"
                                                    CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Image Source="/Assets/Icons/activity_notification.png" Width="30" Height="30" Margin="0,0,10,0" />
                                                    <TextBlock Text="Raid recibida" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="EventCheerTileButton"
                                                    Tag="Cheer"
                                                    MinWidth="150"
                                                    MinHeight="50"
                                                    Padding="12,6"
                                                    Margin="0,0,8,0"
                                                    Command="{Binding SelectCategoryFilterCommand}"
                                                    CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Image Source="/Assets/Icons/action_bits_blue.png" Width="30" Height="30" Margin="0,0,10,0" />
                                                    <TextBlock Text="Bits" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="EventChatCommandTileButton"
                                                    Tag="ChatCommand"
                                                    MinWidth="190"
                                                    MinHeight="50"
                                                    Padding="12,6"
                                                    Margin="0,0,8,0"
                                                    Command="{Binding SelectCategoryFilterCommand}"
                                                    CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Image Source="/Assets/Icons/action_message_green.png" Width="30" Height="30" Margin="0,0,10,0" />
                                                    <TextBlock Text="Comando de chat" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="EventRedemptionTileButton"
                                                    Tag="ChannelPointRedemption"
                                                    MinWidth="190"
                                                    MinHeight="50"
                                                    Padding="12,6"
                                                    Command="{Binding SelectCategoryFilterCommand}"
                                                    CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Image Source="/Assets/Icons/activity_notification_lime.png" Width="30" Height="30" Margin="0,0,10,0" />
                                                    <TextBlock Text="Canje de puntos" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </ScrollViewer>

                                    <Border BorderBrush="{DynamicResource ThemeBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="12"
                                            Margin="0,16,0,0"
                                            Background="{DynamicResource ThemeInputBrush}">
                                        <TextBlock Text="{Binding SelectedCategoryHint}"
                                                   Style="{StaticResource MutedText}"
                                                   TextAlignment="Center" />
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Grid.Row="1"
                                Grid.Column="0"
                                Style="{StaticResource Card}">
                            <DockPanel LastChildFill="True">
                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                    <Grid Margin="0,0,0,12">
                                        <TextBlock Text="{Binding SelectedCategoryListTitle}"
                                                   FontSize="18"
                                                   Style="{StaticResource TitleText}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                        <Button Content="{Binding CreateSelectedCategoryRuleText}"
                                                Style="{StaticResource PrimaryButton}"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Command="{Binding AddRuleCommand}" />
                                    </Grid>

                                    <TextBox MinHeight="38"
                                             Margin="0,0,0,10"
                                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Buscar alertas por nombre, evento o comando." />

                                    <WrapPanel Margin="0,0,0,8">
                                        <ToggleButton Content="Todas"
                                                      Command="{Binding SelectStatusFilterCommand}"
                                                      CommandParameter="ALL"
                                                      IsChecked="{Binding IsAllStatusSelected, Mode=OneWay}"
                                                      Style="{StaticResource ActivityFilterButton}"
                                                      Tag="ALL" />
                                        <ToggleButton Content="Activas"
                                                      Command="{Binding SelectStatusFilterCommand}"
                                                      CommandParameter="ACTIVE"
                                                      IsChecked="{Binding IsActiveStatusSelected, Mode=OneWay}"
                                                      Style="{StaticResource ActivityFilterButton}"
                                                      Tag="ACTIVE" />
                                        <ToggleButton Content="Inactivas"
                                                      Command="{Binding SelectStatusFilterCommand}"
                                                      CommandParameter="INACTIVE"
                                                      IsChecked="{Binding IsInactiveStatusSelected, Mode=OneWay}"
                                                      Style="{StaticResource ActivityFilterButton}"
                                                      Tag="INACTIVE" />
                                    </WrapPanel>

                                    <TextBlock Text="La lista se filtra por el tipo seleccionado arriba."
                                               Style="{StaticResource MutedText}"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,0" />
                                </StackPanel>

                                <TextBlock DockPanel.Dock="Bottom"
                                           Text="{Binding RulesCountText}"
                                           Style="{StaticResource MutedText}"
                                           FontSize="12"
                                           Margin="0,8,0,0" />

                                <ListBox x:Name="RulesList"
                                         ItemsSource="{Binding RulesView}"
                                         SelectedItem="{Binding SelectedRuleRow, Mode=TwoWay}"
                                         BorderBrush="{DynamicResource ThemeBorderBrush}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}" />
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="SelectedRuleFrame"
                                                                BorderBrush="Transparent"
                                                                BorderThickness="2"
                                                                CornerRadius="14"
                                                                Padding="2"
                                                                Margin="0,0,0,6">
                                                            <ContentPresenter />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="SelectedRuleFrame" Property="BorderBrush" Value="{DynamicResource ThemeSelectionBrush}" />
                                                                <Setter TargetName="SelectedRuleFrame" Property="Background" Value="#2214B8A6" />
                                                            </Trigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="SelectedRuleFrame" Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
                                                            </Trigger>
                                                            <MultiTrigger>
                                                                <MultiTrigger.Conditions>
                                                                    <Condition Property="IsSelected" Value="True" />
                                                                    <Condition Property="IsMouseOver" Value="True" />
                                                                </MultiTrigger.Conditions>
                                                                <Setter TargetName="SelectedRuleFrame" Property="BorderBrush" Value="{DynamicResource ThemeSelectionBrush}" />
                                                                <Setter TargetName="SelectedRuleFrame" Property="Background" Value="#2214B8A6" />
                                                            </MultiTrigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource ThemeBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="12"
                                                    Padding="10"
                                                    Margin="0"
                                                    Background="{DynamicResource ThemeInputBrush}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="44" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border Width="36"
                                                            Height="36"
                                                            CornerRadius="12"
                                                            Background="{Binding EventAccentColor}"
                                                            Opacity="0.18" />
                                                    <Image Width="24"
                                                           Height="24"
                                                           Source="{Binding EventIconPath}"
                                                           Stretch="Uniform"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />

                                                    <StackPanel Grid.Column="1"
                                                                Margin="8,0,10,0">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding DisplayLabel}"
                                                                   Style="{StaticResource MutedText}"
                                                                   FontSize="12"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding DisplayLabel}"
                                                                   Margin="0,2,0,0" />
                                                        <WrapPanel Margin="0,6,0,0">
                                                            <Image Source="/Assets/Icons/nav_lights.png"
                                                                   Width="16"
                                                                   Height="16"
                                                                   Margin="0,0,10,0"
                                                                   Opacity="{Binding LightsActionOpacity}"
                                                                   ToolTip="{Binding LightsActionToolTip}"
                                                                   Visibility="{Binding LightsActionVisibility}" />
                                                            <Image Source="/Assets/Icons/lights_fx_rave.png"
                                                                   Width="16"
                                                                   Height="16"
                                                                   Margin="0,0,10,0"
                                                                   Opacity="{Binding VirtualLightsActionOpacity}"
                                                                   ToolTip="{Binding VirtualLightsActionToolTip}"
                                                                   Visibility="{Binding VirtualLightsActionVisibility}" />
                                                            <Image Source="/Assets/Icons/action_message_green.png"
                                                                   Width="16"
                                                                   Height="16"
                                                                   Margin="0,0,10,0"
                                                                   Visibility="{Binding ChatActionVisibility}" />
                                                            <Image Source="/Assets/Icons/service_audio.png"
                                                                   Width="16"
                                                                   Height="16"
                                                                   Margin="0,0,10,0"
                                                                   Visibility="{Binding AudioActionVisibility}" />
                                                            <Image Source="/Assets/Icons/media_video.png"
                                                                   Width="16"
                                                                   Height="16"
                                                                   Margin="0,0,10,0"
                                                                   Opacity="{Binding ObsMediaActionOpacity}"
                                                                   ToolTip="{Binding ObsMediaActionToolTip}"
                                                                   Visibility="{Binding VideoActionVisibility}" />
                                                            <Image Source="/Assets/Icons/media_image.png"
                                                                   Width="16"
                                                                   Height="16"
                                                                   Margin="0,0,10,0"
                                                                   Opacity="{Binding ObsMediaActionOpacity}"
                                                                   ToolTip="{Binding ObsMediaActionToolTip}"
                                                                   Visibility="{Binding ImageActionVisibility}" />
                                                            <Image Source="/Assets/ServiceObs.png"
                                                                   Width="16"
                                                                   Height="16"
                                                                   Margin="0,0,10,0"
                                                                   Opacity="{Binding ObsActionOpacity}"
                                                                   ToolTip="{Binding ObsActionToolTip}"
                                                                   Visibility="{Binding ObsActionVisibility}" />
                                                            <Image Source="/Assets/Icons/service_alexa.png"
                                                                   Width="16"
                                                                   Height="16"
                                                                   Margin="0,0,10,0"
                                                                   Opacity="{Binding AlexaActionOpacity}"
                                                                   ToolTip="{Binding AlexaActionToolTip}"
                                                                   Visibility="{Binding AlexaActionVisibility}" />
                                                        </WrapPanel>
                                                    </StackPanel>

                                                    <Border Grid.Column="2"
                                                            Padding="8,3"
                                                            CornerRadius="10"
                                                            Background="{Binding StatusColor}"
                                                            Opacity="0.92"
                                                            VerticalAlignment="Top">
                                                        <TextBlock Text="{Binding StatusText}"
                                                                   Foreground="White"
                                                                   Tag="StaticBrush"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>

                        <Border Grid.Row="1"
                                Grid.Column="2"
                                Style="{StaticResource Card}">
                            <DockPanel LastChildFill="True">
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Configuracion de la alerta"
                                                   FontSize="18"
                                                   Style="{StaticResource TitleText}"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding EditorContextText}"
                                                   Style="{StaticResource MutedText}"
                                                   FontSize="12"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                    <WrapPanel Grid.Column="1"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Top">
                                        <Button Content="Duplicar" Command="{Binding DuplicateRuleCommand}" />
                                        <Button x:Name="RuleTestButton"
                                                Content="Probar alerta"
                                                Style="{StaticResource PrimaryButton}"
                                                Command="{Binding TestRuleCommand}" />
                                    </WrapPanel>
                                </Grid>

                                <Grid DockPanel.Dock="Bottom"
                                      Margin="0,14,0,0"
                                      IsEnabled="{Binding IsEditorEnabled}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Content="Eliminar alerta"
                                            Style="{StaticResource DangerButton}"
                                            HorizontalContentAlignment="Center"
                                            MinWidth="150"
                                            Command="{Binding RemoveRuleCommand}" />
                                    <Button Grid.Column="2"
                                            Content="Guardar cambios"
                                            Style="{StaticResource PrimaryButton}"
                                            HorizontalContentAlignment="Center"
                                            MinWidth="280"
                                            Opacity="{Binding SaveButtonOpacity}"
                                            ToolTip="{Binding SaveButtonToolTip}"
                                            Command="{Binding SaveRuleCommand}" />
                                </Grid>

                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel IsEnabled="{Binding IsEditorEnabled}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="18" />
                                                <ColumnDefinition Width="170" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Nombre de la alerta"
                                                           Style="{StaticResource MutedText}" />
                                                <TextBox x:Name="RuleNameBox"
                                                         Text="{Binding Editor.RuleNameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         TextChanged="RuleFieldChanged" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Estado"
                                                           Style="{StaticResource MutedText}" />
                                                <CheckBox x:Name="RuleEnabledCheck"
                                                          Content="Activa"
                                                          IsChecked="{Binding Editor.IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Checked="RuleFieldChanged"
                                                          Unchecked="RuleFieldChanged" />
                                            </StackPanel>
                                        </Grid>

                                        <ComboBox x:Name="EventKindBox"
                                                  ItemsSource="{Binding EventKindChoices}"
                                                  DisplayMemberPath="Label"
                                                  SelectedValuePath="Value"
                                                  SelectedValue="{Binding Editor.EventKind, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Visibility="Collapsed"
                                                  SelectionChanged="RuleFieldChanged" />

                                        <StackPanel Margin="0,0,0,10">
                                            <TextBlock x:Name="RewardTitleLabel"
                                                       Text="Canje especifico"
                                                       Style="{StaticResource MutedText}" />
                                            <TextBox x:Name="RewardTitleBox"
                                                     Text="{Binding Editor.CustomRewardTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     TextChanged="RuleFieldChanged"
                                                     ToolTip="Dejalo vacio para aceptar cualquier canje personalizado." />

                                            <TextBlock x:Name="MinimumBitsLabel"
                                                       Text="Bits minimos"
                                                       Style="{StaticResource MutedText}" />
                                            <TextBox x:Name="MinimumBitsBox"
                                                     Text="{Binding Editor.MinimumBitsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     TextChanged="RuleFieldChanged"
                                                     ToolTip="Para bits, usa el mayor umbral que sea menor o igual a la cantidad recibida." />
                                        </StackPanel>

                                        <TextBlock x:Name="ChatCommandLabel"
                                                   Text="Comando de chat"
                                                   Style="{StaticResource MutedText}" />
                                        <TextBox x:Name="ChatCommandBox"
                                                 Text="{Binding Editor.ChatCommand, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 TextChanged="RuleFieldChanged"
                                                 ToolTip="Ejemplo: !baile. La regla se activa cuando el mensaje empieza con ese comando." />

                                        <StackPanel Margin="0,10,0,0">
                                            <TextBlock Text="Acciones opcionales"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,0,2" />
                                            <TextBlock Text="Activa lo que quieres ejecutar cuando llegue el evento."
                                                       Style="{StaticResource MutedText}"
                                                       FontSize="12"
                                                       Margin="0,0,0,8" />

                                            <Border x:Name="UseLightsActionCard"
                                                    BorderBrush="{DynamicResource ThemeBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="12"
                                                    Padding="12"
                                                    Margin="0,0,0,10"
                                                    Background="{DynamicResource ThemeInputBrush}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="220" />
                                                        <ColumnDefinition Width="16" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <Grid MinWidth="190" VerticalAlignment="Center">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="42" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Image Source="/Assets/Icons/nav_lights.png"
                                                               Width="26"
                                                               Height="26"
                                                               Stretch="Uniform"
                                                               VerticalAlignment="Center" />
                                                        <StackPanel Grid.Column="1"
                                                                    VerticalAlignment="Center">
                                                            <TextBlock Text="Luces"
                                                                       FontWeight="SemiBold" />
                                                            <TextBlock Text="Efectos y colores dinamicos."
                                                                       Style="{StaticResource MutedText}"
                                                                       FontSize="12"
                                                                       TextWrapping="Wrap" />
                                                        </StackPanel>
                                                        <CheckBox x:Name="UseLightsCheck"
                                                                  Grid.Column="2"
                                                                  Content=""
                                                                  Style="{StaticResource AlertToggleSwitchStyle}"
                                                                  IsChecked="{Binding Editor.UseLights, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  Checked="RuleFieldChanged"
                                                                  Unchecked="RuleFieldChanged" />
                                                    </Grid>

                                                    <StackPanel x:Name="LightConfigurationPanel"
                                                                Grid.Column="2"
                                                                Margin="0">
                                                            <Separator x:Name="LightOptionsSeparator"
                                                                       Height="0"
                                                                       Margin="0"
                                                                       Opacity="0" />

                                                            <TextBlock x:Name="TargetPinsLabel"
                                                                       Text="Pines de salida"
                                                                       Style="{StaticResource MutedText}" />
                                                            <ComboBox x:Name="TargetPinsChoiceBox"
                                                                      ItemsSource="{Binding TargetPinChoices}"
                                                                      DisplayMemberPath="Label"
                                                                      SelectedValuePath="Value"
                                                                      SelectedValue="{Binding Editor.TargetPins, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                      SelectionChanged="RuleFieldChanged"
                                                                      Margin="0,4,0,8" />
                                                            <TextBox x:Name="TargetPinsBox"
                                                                     Visibility="Collapsed"
                                                                     Height="0"
                                                                     Margin="0"
                                                                     Text="{Binding Editor.TargetPins, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                     TextChanged="RuleFieldChanged"
                                                                     ToolTip="Dejalo vacio para usar todas las tiras. Ejemplo: 6, 7" />

                                                            <StackPanel x:Name="PatternGrid">
                                                                <TextBlock Text="Patron" Style="{StaticResource MutedText}" />
                                                                <ComboBox x:Name="PatternBox"
                                                                          ItemsSource="{Binding LightPatternChoices}"
                                                                          DisplayMemberPath="Label"
                                                                          SelectedValuePath="Value"
                                                                          Visibility="Collapsed"
                                                                          SelectedValue="{Binding Editor.Pattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                          SelectionChanged="RuleFieldChanged" />
                                                                <UniformGrid Columns="7" Margin="-3,4,-3,10">
