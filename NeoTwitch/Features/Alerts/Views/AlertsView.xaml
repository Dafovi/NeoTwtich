                                                                    Tag="Image:Single"
                                                                    Command="{Binding SelectObsMediaSourceModeCommand}"
                                                                    CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}"
                                                                    ToolTip="Imagen individual">
                                                                <Image Source="/Assets/Icons/sound_file.png"
                                                                       Width="22"
                                                                       Height="22"
                                                                       Stretch="Uniform" />
                                                            </Button>
                                                            <Button x:Name="RuleObsImageGroupMediaModeButton"
                                                                    Grid.Column="2"
                                                                    Tag="Image:Group"
                                                                    Command="{Binding SelectObsMediaSourceModeCommand}"
                                                                    CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}"
                                                                    ToolTip="Grupo aleatorio de imagenes">
                                                                <Image Source="/Assets/Icons/media_group.png"
                                                                       Width="22"
                                                                       Height="22"
                                                                       Stretch="Uniform" />
                                                            </Button>
                                                        </Grid>
                                                        <ComboBox x:Name="RuleObsImageSourceModeBox"
                                                                  ItemsSource="{Binding ObsMediaSourceModeChoices}"
                                                                  DisplayMemberPath="Label"
                                                                  SelectedValuePath="Value"
                                                                  SelectedValue="{Binding Editor.ObsImageSourceMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  Visibility="Collapsed"
                                                                  SelectionChanged="RuleFieldChanged" />
                                                        <StackPanel x:Name="ObsImageDurationPanel">
                                                            <TextBlock Text="Duracion (ms)"
                                                                       Style="{StaticResource MutedText}" />
                                                            <TextBox x:Name="ObsImageDurationBox"
                                                                     Text="{Binding Editor.ObsImageDurationText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                     TextChanged="RuleFieldChanged" />
                                                        </StackPanel>
                                                        <StackPanel x:Name="RuleObsImageAssetPanel"
                                                                    Margin="0,10,0,0">
                                                            <TextBlock Text="Archivo"
                                                                       Style="{StaticResource MutedText}" />
                                                            <ComboBox x:Name="RuleObsImageAssetBox"
                                                                      ItemsSource="{Binding ObsImageAssetChoices}"
                                                                      DisplayMemberPath="DisplayName"
                                                                      SelectedValuePath="Id"
                                                                      SelectedValue="{Binding Editor.ObsImageAssetId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                      SelectionChanged="RuleFieldChanged" />
                                                        </StackPanel>
                                                        <StackPanel x:Name="RuleObsImageGroupPanel"
                                                                    Margin="0,10,0,0">
                                                            <TextBlock Text="Grupo"
                                                                       Style="{StaticResource MutedText}" />
                                                            <ComboBox x:Name="RuleObsImageGroupBox"
                                                                      ItemsSource="{Binding ObsImageGroupChoices}"
                                                                      DisplayMemberPath="Name"
                                                                      SelectedValuePath="Id"
                                                                      SelectedValue="{Binding Editor.ObsImageGroupId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                      SelectionChanged="RuleFieldChanged" />
                                                        </StackPanel>
                                                        <TextBlock x:Name="RuleObsImageEmptyHintText"
                                                                   Text="Agrega imagenes en la biblioteca para usarlas en OBS."
                                                                   Style="{StaticResource MutedText}"
                                                                   FontSize="11"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,8,0,0" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <Border x:Name="ObsActionCard"
                                                    BorderBrush="{DynamicResource ThemeBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="12"
                                                    Padding="12"
                                                    Margin="0,0,0,10"
                                                    Background="{DynamicResource ThemeInputBrush}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="220" />
                                                        <ColumnDefinition Width="16" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <Grid MinWidth="190" VerticalAlignment="Center">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="42" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Image Source="/Assets/ServiceObs.png"
                                                               Width="26"
                                                               Height="26"
                                                               Stretch="Uniform"
                                                               VerticalAlignment="Center" />
                                                        <StackPanel Grid.Column="1"
                                                                    VerticalAlignment="Center">
                                                            <TextBlock Text="OBS"
                                                                       FontWeight="SemiBold" />
                                                            <TextBlock Text="Cambia escenas o muestra imagenes/videos."
                                                                       Style="{StaticResource MutedText}"
                                                                       FontSize="12"
                                                                       TextWrapping="Wrap" />
                                                        </StackPanel>
                                                        <CheckBox x:Name="ObsSceneCheck"
                                                                  Grid.Column="2"
                                                                  Content=""
                                                                  Style="{StaticResource AlertToggleSwitchStyle}"
                                                                  IsChecked="{Binding Editor.SendObsScene, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  Checked="RuleFieldChanged"
                                                                  Unchecked="RuleFieldChanged" />
                                                    </Grid>
                                                    <StackPanel x:Name="ObsDetailsPanel"
                                                                Grid.Column="2"
                                                                Margin="0">
                                                        <StackPanel x:Name="ObsSceneDetailsPanel">
                                                            <TextBlock Text="Escena de OBS"
                                                                       Style="{StaticResource MutedText}" />
                                                            <ComboBox x:Name="RuleObsSceneBox"
                                                                      ItemsSource="{Binding ObsSceneChoices}"
                                                                      DisplayMemberPath="Label"
                                                                      SelectedValuePath="Name"
                                                                      SelectedValue="{Binding Editor.ObsSceneName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                      Margin="0,4,0,0"
                                                                      SelectionChanged="RuleFieldChanged" />

                                                            <Grid x:Name="ObsSceneTimingGrid"
                                                                  Margin="0,10,0,0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="12" />
                                                                    <ColumnDefinition Width="150" />
                                                                    <ColumnDefinition Width="12" />
                                                                    <ColumnDefinition Width="170" />
                                                                </Grid.ColumnDefinitions>
                                                                <CheckBox x:Name="ObsReturnCheck"
                                                                          Content="Volver a la escena anterior"
                                                                          VerticalAlignment="Center"
                                                                          MinHeight="34"
                                                                          IsChecked="{Binding Editor.ObsReturnToPreviousScene, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                          Checked="RuleFieldChanged"
                                                                          Unchecked="RuleFieldChanged" />
                                                                <StackPanel Grid.Column="2">
                                                                    <TextBlock Text="Esperar antes (ms)"
                                                                               Style="{StaticResource MutedText}" />
                                                                    <TextBox x:Name="ObsSceneDelayBox"
                                                                             Text="{Binding Editor.ObsSceneDelayText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                             TextChanged="RuleFieldChanged" />
                                                                </StackPanel>
                                                                <StackPanel x:Name="ObsReturnDelayPanel"
                                                                            Grid.Column="4">
                                                                    <TextBlock Text="Regresar despues de (ms)"
                                                                               Style="{StaticResource MutedText}" />
                                                                    <TextBox x:Name="ObsReturnDelayBox"
                                                                             Text="{Binding Editor.ObsReturnDelayText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                             TextChanged="RuleFieldChanged" />
                                                                </StackPanel>
                                                            </Grid>

                                                            <TextBlock x:Name="RuleObsEmptyHintText"
                                                                       Text="Conecta OBS desde Conexiones para cargar las escenas disponibles."
                                                                       Style="{StaticResource MutedText}"
                                                                       FontSize="11"
                                                                       TextWrapping="Wrap"
                                                                       Margin="0,8,0,0" />
                                                        </StackPanel>

                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <Border x:Name="AlexaActionCard"
                                                    BorderBrush="{DynamicResource ThemeBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="12"
                                                    Padding="12"
                                                    Margin="0,0,0,10"
                                                    Background="{DynamicResource ThemeInputBrush}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="220" />
                                                        <ColumnDefinition Width="16" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <Grid MinWidth="190" VerticalAlignment="Center">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="42" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Image Source="/Assets/Icons/service_alexa.png"
                                                               Width="26"
                                                               Height="26"
                                                               Stretch="Uniform"
                                                               VerticalAlignment="Center" />
                                                        <StackPanel Grid.Column="1"
                                                                    VerticalAlignment="Center">
                                                            <TextBlock Text="Alexa"
                                                                       FontWeight="SemiBold" />
                                                            <TextBlock Text="Dispara una rutina o dispositivo."
                                                                       Style="{StaticResource MutedText}"
                                                                       FontSize="12"
                                                                       TextWrapping="Wrap" />
                                                        </StackPanel>
                                                        <CheckBox x:Name="AlexaEventCheck"
                                                                  Grid.Column="2"
                                                                  Content=""
                                                                  Style="{StaticResource AlertToggleSwitchStyle}"
                                                                  IsChecked="{Binding Editor.SendAlexaEvent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  Checked="RuleFieldChanged"
                                                                  Unchecked="RuleFieldChanged" />
                                                    </Grid>
                                                    <StackPanel x:Name="AlexaDetailsPanel"
                                                                Grid.Column="2"
                                                                Margin="0">
                                                        <TextBlock x:Name="AlexaRuleHintText"
                                                                   Text="Se enviara a Alexa el nombre de esta regla."
                                                                   Style="{StaticResource MutedText}"
                                                                   FontSize="11"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>
</views:NeoTwitchView>
