<views:NeoTwitchView x:Class="NeoTwitch.Views.ConnectionsView"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     xmlns:connections="clr-namespace:NeoTwitch.ViewModels.Connections"
                     xmlns:views="clr-namespace:NeoTwitch.Views"
                     mc:Ignorable="d">
                <views:NeoTwitchView.Resources>
                    <Style x:Key="ConnectionStateBadgeText" TargetType="{x:Type TextBlock}">
                        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Foreground" Value="#94A3B8" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="Conectado">
                                <Setter Property="Foreground" Value="#22C55E" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="Listo">
                                <Setter Property="Foreground" Value="#22C55E" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="Activo">
                                <Setter Property="Foreground" Value="#22C55E" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="Revisar">
                                <Setter Property="Foreground" Value="#FFB020" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="Configurado">
                                <Setter Property="Foreground" Value="#FFB020" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="Conectando">
                                <Setter Property="Foreground" Value="#FFB020" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="Desconectado">
                                <Setter Property="Foreground" Value="#F43F5E" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="Error">
                                <Setter Property="Foreground" Value="#F43F5E" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="Desactivado">
                                <Setter Property="Foreground" Value="#94A3B8" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>

                    <DataTemplate DataType="{x:Type connections:ConnectionButtonViewModel}">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <Path Width="15"
                                  Height="15"
                                  Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.9"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Data="{Binding IconGeometry}" />
                            <TextBlock Text="{Binding Text}"
                                       Margin="7,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </DataTemplate>
                </views:NeoTwitchView.Resources>
                <Grid Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="180" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Conexiones"
                                       FontSize="28"
                                       Style="{StaticResource TitleText}"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Conecta tus servicios y dispositivos para que Neo Twitch pueda reaccionar al stream."
                                       Style="{StaticResource MutedText}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="Guardar todo"
                                Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Top"
                                Command="{Binding SaveCommand}" />
                    </Grid>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  CanContentScroll="False"
                                  Padding="0,0,8,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Style="{StaticResource Card}"
                            Padding="18">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="66" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="150" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="52"
                                            Height="52"
                                            CornerRadius="14"
                                            Background="#1A9146FF"
                                            HorizontalAlignment="Left">
                                        <Image Source="/Assets/Icons/service_twitch.png"
                                               Stretch="Uniform"
                                               Margin="8" />
                                    </Border>
                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="Conectar Twitch"
                                                   FontSize="18"
                                                   Style="{StaticResource TitleText}"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="Autoriza tu cuenta de Twitch desde el navegador."
                                                   Style="{StaticResource MutedText}"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                    <Border x:Name="TwitchBadgeBorder"
                                            Grid.Column="2"
                                            Tag="StaticBrush"
                                            CornerRadius="14"
                                            Padding="11,5"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Background="{Binding TwitchBadge.BackgroundBrush}"
                                            BorderBrush="{Binding TwitchBadge.BorderBrush}"
                                            BorderThickness="1">
                                        <TextBlock Text="{Binding TwitchBadge.Text}"
                                                   Style="{StaticResource ConnectionStateBadgeText}"
                                                   Foreground="{Binding TwitchBadge.ForegroundBrush}"
                                                   Tag="StaticBrush" />
                                    </Border>
                                </Grid>

                                <Grid Grid.Row="1"
                                      Margin="0,18,0,8"
                                      Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Client ID"
                                                   Style="{StaticResource MutedText}" />
                                        <Grid Margin="0,4,0,0">
                                            <TextBox x:Name="ClientIdBox"
                                                     Margin="0"
                                                     Padding="10,6,76,6"
                                                     Text="{Binding TwitchClientId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     TextChanged="GlobalSettingsChanged" />
                                            <TextBlock x:Name="ClientIdMaskText"
                                                       Margin="1,1,72,1"
                                                       Padding="9,6"
                                                       VerticalAlignment="Stretch"
                                                       Background="{DynamicResource ThemeInputBrush}"
                                                       Foreground="{DynamicResource ThemeMutedTextBrush}"
                                                       Visibility="Collapsed" />
                                            <Button x:Name="ClientIdRevealButton"
                                                    Content="Ver"
                                                    Width="64"
                                                    MinHeight="0"
                                                    Padding="8,0"
                                                    Margin="0"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Stretch"
                                                    ToolTip="Mostrar u ocultar Client ID"
                                                    Command="{Binding ToggleClientIdVisibilityCommand}" />
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Client Secret opcional"
                                                   Style="{StaticResource MutedText}" />
                                        <Grid Margin="0,4,0,0">
                                            <TextBox x:Name="ClientSecretBox"
                                                     Margin="0"
                                                     Padding="10,6,76,6"
                                                     Text="{Binding TwitchClientSecret, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     TextChanged="GlobalSettingsChanged"
                                                     ToolTip="Se usa para refrescar el token de Twitch. Si lo dejas vacio, la app puede pedir autorizar de nuevo cuando expire." />
                                            <TextBlock x:Name="ClientSecretMaskText"
                                                       Margin="1,1,72,1"
                                                       Padding="9,6"
                                                       VerticalAlignment="Stretch"
                                                       Background="{DynamicResource ThemeInputBrush}"
                                                       Foreground="{DynamicResource ThemeMutedTextBrush}"
                                                       Visibility="Collapsed" />
                                            <Button x:Name="ClientSecretRevealButton"
                                                    Content="Ver"
                                                    Width="64"
                                                    MinHeight="0"
                                                    Padding="8,0"
                                                    Margin="0"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Stretch"
                                                    ToolTip="Mostrar u ocultar Client Secret"
                                                    Command="{Binding ToggleClientSecretVisibilityCommand}" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>

                                <WrapPanel Grid.Row="2"
                                           HorizontalAlignment="Right"
                                           Margin="0,18,0,0">
                                    <Button Content="Abrir Twitch Console"
                                            Visibility="Collapsed"
                                            Command="{Binding OpenTwitchConsoleCommand}" />
                                    <Button x:Name="TwitchButton"
                                            Style="{StaticResource PrimaryButton}"
                                            Content="{Binding TwitchButton}"
                                            IsEnabled="{Binding TwitchButton.IsEnabled}"
                                            Command="{Binding ToggleTwitchCommand}" />
                                </WrapPanel>
                            </Grid>
                    </Border>

                    <Border Grid.Row="4"
                            Style="{StaticResource Card}"
                            Padding="18">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="66" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="150" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="52"
                                            Height="52"
                                            CornerRadius="14"
                                            Background="#1A148A86"
                                            HorizontalAlignment="Left">
                                        <Image Source="/Assets/Icons/service_arduino.png"
                                               Stretch="Uniform"
                                               Margin="7" />
                                    </Border>
                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="Conectar Arduino"
                                                   FontSize="18"
                                                   Style="{StaticResource TitleText}"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="Escoge el puerto COM y baudios para enviar comandos a las tiras LED."
                                                   Style="{StaticResource MutedText}"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                    <Border x:Name="ArduinoBadgeBorder"
                                            Grid.Column="2"
                                            Tag="StaticBrush"
                                            CornerRadius="14"
                                            Padding="11,5"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Background="{Binding ArduinoBadge.BackgroundBrush}"
                                            BorderBrush="{Binding ArduinoBadge.BorderBrush}"
                                            BorderThickness="1">
                                        <TextBlock Text="{Binding ArduinoBadge.Text}"
                                                   Style="{StaticResource ConnectionStateBadgeText}"
                                                   Foreground="{Binding ArduinoBadge.ForegroundBrush}"
                                                   Tag="StaticBrush" />
                                    </Border>
                                </Grid>

                                <CheckBox x:Name="ArduinoEnabledCheck"
                                          Grid.Row="1"
                                          Content="Activar Arduino"
                                          IsChecked="{Binding ArduinoEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Checked="GlobalSettingsChanged"
                                          Unchecked="GlobalSettingsChanged"
                                          Margin="0,14,0,8" />

                                <Grid Grid.Row="2"
                                      Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="260" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Puerto COM del Arduino"
                                                   Style="{StaticResource MutedText}" />
                                        <ComboBox x:Name="PortComboBox"
                                                  ItemsSource="{Binding PortChoices}"
                                                  DisplayMemberPath="DisplayName"
                                                  SelectedValuePath="PortName"
                                                  SelectedValue="{Binding SerialPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Text="{Binding SerialPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEditable="True"
                                                  SelectionChanged="GlobalSettingsChanged"
                                                  DropDownOpened="PortComboBox_DropDownOpened"
                                                  ToolTip="Escoge el puerto que diga Arduino, CH340, CP210 o USB Serial."
                                                  Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Baudios"
                                                   Style="{StaticResource MutedText}" />
                                        <TextBox x:Name="BaudRateBox"
                                                 Text="{Binding BaudRateText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 TextChanged="GlobalSettingsChanged"
                                                 Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>

                                <WrapPanel Grid.Row="3"
                                           HorizontalAlignment="Right"
                                           Margin="0,8,0,0">
                                    <Button Content="Detectar puertos"
                                            Command="{Binding DetectPortsCommand}" />
                                    <Button x:Name="ConnectArduinoButton"
                                            Content="{Binding ArduinoButton}"
                                            IsEnabled="{Binding ArduinoButton.IsEnabled}"
                                            Style="{StaticResource PrimaryButton}"
                                            Command="{Binding ConnectArduinoCommand}" />
                                </WrapPanel>
                            </Grid>
                    </Border>

                    <Border Grid.Row="6"
                            Style="{StaticResource Card}"
                            Padding="18">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="66" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="150" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="52"
                                            Height="52"
                                            CornerRadius="14"
                                            Background="#1A2FB4E9"
                                            HorizontalAlignment="Left">
                                        <Image Source="/Assets/Icons/service_alexa.png"
                                               Stretch="Uniform"
                                               Margin="8" />
                                    </Border>
                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="Conectar Alexa"
                                                   FontSize="18"
                                                   Style="{StaticResource TitleText}"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="Activa el relay para enviar eventos desde Neo Twitch a Alexa."
                                                   Style="{StaticResource MutedText}"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                    <Border x:Name="AlexaBadgeBorder"
                                            Grid.Column="2"
                                            Tag="StaticBrush"
                                            CornerRadius="14"
                                            Padding="11,5"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Background="{Binding AlexaBadge.BackgroundBrush}"
                                            BorderBrush="{Binding AlexaBadge.BorderBrush}"
                                            BorderThickness="1">
                                        <TextBlock Text="{Binding AlexaBadge.Text}"
                                                   Style="{StaticResource ConnectionStateBadgeText}"
                                                   Foreground="{Binding AlexaBadge.ForegroundBrush}"
                                                   Tag="StaticBrush" />
                                    </Border>
                                </Grid>

                                <CheckBox x:Name="AlexaEnabledCheck"
                                          Grid.Row="1"
                                          Content="Activar integracion con Alexa"
                                          IsChecked="{Binding AlexaEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Checked="AlexaSettingsChanged"
                                          Unchecked="AlexaSettingsChanged"
                                          Margin="0,18,0,8" />

                                <Grid Grid.Row="2"
                                      Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="URL de Skill / relay"
                                                   Style="{StaticResource MutedText}" />
                                        <Grid Margin="0,4,0,0">
                                            <TextBox x:Name="AlexaRelayUrlBox"
                                                     Margin="0"
                                                     Padding="10,6,76,6"
                                                     Text="{Binding AlexaRelayUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     TextChanged="AlexaSettingsChanged"
                                                     ToolTip="Endpoint HTTPS que recibe eventos de Neo Twitch y los envia a Alexa." />
                                            <TextBlock x:Name="AlexaRelayUrlMaskText"
                                                       Margin="1,1,72,1"
                                                       Padding="9,6"
                                                       VerticalAlignment="Stretch"
                                                       Background="{DynamicResource ThemeInputBrush}"
                                                       Foreground="{DynamicResource ThemeMutedTextBrush}"
                                                       Visibility="Collapsed" />
                                            <Button x:Name="AlexaRelayUrlRevealButton"
                                                    Content="Ver"
                                                    Width="64"
                                                    MinHeight="0"
                                                    Padding="8,0"
                                                    Margin="0"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Stretch"
                                                    ToolTip="Mostrar u ocultar URL de Alexa"
                                                    Command="{Binding ToggleAlexaRelayUrlVisibilityCommand}" />
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Token opcional"
                                                   Style="{StaticResource MutedText}" />
                                        <Grid Margin="0,4,0,0">
                                            <TextBox x:Name="AlexaAuthTokenBox"
                                                     Margin="0"
                                                     Padding="10,6,76,6"
                                                     Text="{Binding AlexaAuthToken, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     TextChanged="AlexaSettingsChanged"
                                                     ToolTip="Token/API key opcional para proteger el relay." />
                                            <TextBlock x:Name="AlexaAuthTokenMaskText"
                                                       Margin="1,1,72,1"
                                                       Padding="9,6"
                                                       VerticalAlignment="Stretch"
                                                       Background="{DynamicResource ThemeInputBrush}"
                                                       Foreground="{DynamicResource ThemeMutedTextBrush}"
                                                       Visibility="Collapsed" />
                                            <Button x:Name="AlexaAuthTokenRevealButton"
                                                    Content="Ver"
                                                    Width="64"
                                                    MinHeight="0"
                                                    Padding="8,0"
                                                    Margin="0"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Stretch"
                                                    ToolTip="Mostrar u ocultar token de Alexa"
                                                    Command="{Binding ToggleAlexaAuthTokenVisibilityCommand}" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="3"
                                      Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="360" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource MutedText}"
                                               Text="{Binding AlexaStatusText}"
                                               TextWrapping="Wrap"
                                               Foreground="{Binding AlexaBadge.ForegroundBrush}"
                                               Tag="StaticBrush"
                                               VerticalAlignment="Center" />
                                    <WrapPanel Grid.Column="1"
                                               HorizontalAlignment="Right">
                                        <Button Content="Abrir Alexa Console"
                                                Command="{Binding OpenAlexaConsoleCommand}" />
                                        <Button x:Name="TestAlexaButton"
                                                Content="{Binding AlexaTestButton}"
                                                IsEnabled="{Binding AlexaTestButton.IsEnabled}"
                                                Style="{StaticResource PrimaryButton}"
                                                Command="{Binding TestAlexaCommand}" />
                                    </WrapPanel>
                                </Grid>
                            </Grid>
                    </Border>

                    <Border Grid.Row="2"
                            Style="{StaticResource Card}"
                            Padding="18">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="66" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="150" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="52"
                                            Height="52"
                                            CornerRadius="14"
                                            Background="#1A22C55E"
                                            HorizontalAlignment="Left">
                                        <Image Source="/Assets/ServiceObs.png"
                                               Stretch="Uniform"
                                               Margin="8" />
                                    </Border>
                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="Conectar OBS"
                                                   FontSize="18"
                                                   Style="{StaticResource TitleText}"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="Controla escenas y automatizaciones de OBS Studio por WebSocket."
                                                   Style="{StaticResource MutedText}"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                    <Border x:Name="ObsBadgeBorder"
                                            Grid.Column="2"
                                            Tag="StaticBrush"
                                            CornerRadius="14"
                                            Padding="11,5"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Background="{Binding ObsBadge.BackgroundBrush}"
                                            BorderBrush="{Binding ObsBadge.BorderBrush}"
                                            BorderThickness="1">
                                        <TextBlock Text="{Binding ObsBadge.Text}"
                                                   Style="{StaticResource ConnectionStateBadgeText}"
                                                   Foreground="{Binding ObsBadge.ForegroundBrush}"
                                                   Tag="StaticBrush" />
                                    </Border>
                                </Grid>

                                <CheckBox x:Name="ObsEnabledCheck"
                                          Grid.Row="1"
                                          Content="Activar integracion con OBS"
                                          IsChecked="{Binding ObsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Checked="ObsSettingsChanged"
                                          Unchecked="ObsSettingsChanged"
                                          Margin="0,18,0,8"
                                          Visibility="Collapsed" />

                                <Grid Grid.Row="2"
                                      Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Visibility="Collapsed">
                                        <TextBlock Text="Host / URL"
                                                   Style="{StaticResource MutedText}" />
                                        <TextBox x:Name="ObsHostBox"
                                                 Text="{Binding ObsHost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 TextChanged="ObsSettingsChanged"
                                                 ToolTip="Normalmente 127.0.0.1 si OBS esta en este mismo PC." />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Visibility="Collapsed">
                                        <TextBlock Text="Puerto"
                                                   Style="{StaticResource MutedText}" />
                                        <TextBox x:Name="ObsPortBox"
                                                 Text="{Binding ObsPortText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 TextChanged="ObsSettingsChanged"
                                                 ToolTip="OBS WebSocket usa 4455 por defecto." />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4"
                                                Grid.ColumnSpan="5">
                                        <TextBlock Text="Contraseña de OBS"
                                                   Style="{StaticResource MutedText}" />
                                        <Grid Margin="0,4,0,0">
                                            <TextBox x:Name="ObsPasswordBox"
                                                     Margin="0"
                                                     Padding="10,6,76,6"
                                                     Text="{Binding ObsPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     TextChanged="ObsSettingsChanged"
                                                     ToolTip="Solo es necesaria si OBS tiene activada la autenticación WebSocket." />
                                            <TextBlock x:Name="ObsPasswordMaskText"
                                                       Margin="1,1,72,1"
                                                       Padding="9,6"
                                                       VerticalAlignment="Stretch"
                                                       Background="{DynamicResource ThemeInputBrush}"
                                                       Foreground="{DynamicResource ThemeMutedTextBrush}"
                                                       Visibility="Collapsed" />
                                            <Button x:Name="ObsPasswordRevealButton"
                                                    Content="Ver"
                                                    Width="64"
                                                    MinHeight="0"
                                                    Padding="8,0"
                                                    Margin="0"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Stretch"
                                                    ToolTip="Mostrar u ocultar contraseña de OBS"
                                                    Command="{Binding ToggleObsPasswordVisibilityCommand}" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="3"
                                      Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="360" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource MutedText}"
                                               Text="{Binding ObsConnectionHelpText}"
                                               TextWrapping="Wrap"
                                               Foreground="{Binding ObsBadge.ForegroundBrush}"
                                               Tag="StaticBrush"
                                               VerticalAlignment="Center" />
                                    <WrapPanel Grid.Column="1"
                                               HorizontalAlignment="Right">
                                        <Button Content="Ver guia OBS"
                                                Command="{Binding OpenObsGuideCommand}" />
                                        <Button x:Name="TestObsButton"
                                                Content="{Binding ObsTestButton}"
                                                IsEnabled="{Binding ObsTestButton.IsEnabled}"
                                                Command="{Binding TestObsCommand}" />
                                        <Button x:Name="ConnectObsButton"
                                                Content="{Binding ObsButton}"
                                                IsEnabled="{Binding ObsButton.IsEnabled}"
                                                Style="{StaticResource PrimaryButton}"
                                                Command="{Binding ConnectObsCommand}" />
                                    </WrapPanel>
                                </Grid>
                            </Grid>
                    </Border>
                    </Grid>
                </ScrollViewer>
                </Grid>
</views:NeoTwitchView>
