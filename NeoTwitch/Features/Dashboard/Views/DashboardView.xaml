<views:NeoTwitchView x:Class="NeoTwitch.Views.DashboardView"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:views="clr-namespace:NeoTwitch.Views">
                <Grid Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="0,0,0,18">
                        <TextBlock Text="¡Todo listo para tu stream!"
                                   FontSize="30"
                                   Style="{StaticResource TitleText}"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Estado general, resumen de Twitch y actividad reciente."
                                   Style="{StaticResource MutedText}"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Style="{StaticResource Card}"
                                Padding="20"
                                MinHeight="96">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="58" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="30" />
                                </Grid.ColumnDefinitions>
                                <Border Width="48"
                                        Height="48"
                                        CornerRadius="14"
                                        Background="#1A9146FF"
                                        HorizontalAlignment="Left">
                                    <Image Source="/Assets/Icons/service_twitch.png"
                                           Stretch="Uniform"
                                           Margin="8" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Twitch"
                                               FontSize="17"
                                               Style="{StaticResource TitleText}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding TwitchState.Text}"
                                               Foreground="{Binding TwitchState.Brush}"
                                               FontWeight="SemiBold"
                                               Margin="0,5,0,0" />
                                </StackPanel>
                                <Rectangle Grid.Column="2"
                                           Width="24"
                                           Height="24"
                                           Fill="{Binding TwitchState.Brush}"
                                           OpacityMask="{Binding TwitchState.IconMask}"
                                           ToolTip="{Binding TwitchState.ToolTip}"
                                           VerticalAlignment="Top" />
                            </Grid>
                        </Border>

                        <Border Grid.Column="4"
                                Style="{StaticResource Card}"
                                Padding="20"
                                MinHeight="96">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="58" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="30" />
                                </Grid.ColumnDefinitions>
                                <Border Width="48"
                                        Height="48"
                                        CornerRadius="14"
                                        Background="#1A148A86"
                                        HorizontalAlignment="Left">
                                    <Image Source="/Assets/Icons/service_arduino.png"
                                           Stretch="Uniform"
                                           Margin="7" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Arduino"
                                               FontSize="17"
                                               Style="{StaticResource TitleText}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ArduinoState.Text}"
                                               Foreground="{Binding ArduinoState.Brush}"
                                               FontWeight="SemiBold"
                                               Margin="0,5,0,0" />
                                </StackPanel>
                                <Rectangle Grid.Column="2"
                                           Width="24"
                                           Height="24"
                                           Fill="{Binding ArduinoState.Brush}"
                                           OpacityMask="{Binding ArduinoState.IconMask}"
                                           ToolTip="{Binding ArduinoState.ToolTip}"
                                           VerticalAlignment="Top" />
                            </Grid>
                        </Border>

                        <Border Grid.Column="6"
                                Style="{StaticResource Card}"
                                Padding="20"
                                MinHeight="96">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="58" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="30" />
                                </Grid.ColumnDefinitions>
                                <Border Width="48"
                                        Height="48"
                                        CornerRadius="14"
                                        Background="#1A2FB4E9"
                                        HorizontalAlignment="Left">
                                    <Image Source="/Assets/Icons/service_alexa.png"
                                           Stretch="Uniform"
                                           Margin="8" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Alexa"
                                               FontSize="17"
                                               Style="{StaticResource TitleText}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding AlexaState.Text}"
                                               Foreground="{Binding AlexaState.Brush}"
                                               FontWeight="SemiBold"
                                               Margin="0,5,0,0" />
                                </StackPanel>
                                <Rectangle Grid.Column="2"
                                           Width="24"
                                           Height="24"
                                           Fill="{Binding AlexaState.Brush}"
                                           OpacityMask="{Binding AlexaState.IconMask}"
                                           ToolTip="{Binding AlexaState.ToolTip}"
                                           VerticalAlignment="Top" />
                            </Grid>
                        </Border>

                        <Border Grid.Column="2"
                                Style="{StaticResource Card}"
                                Padding="20"
                                MinHeight="96">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="58" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="30" />
                                </Grid.ColumnDefinitions>
                                <Border Width="48"
                                        Height="48"
                                        CornerRadius="14"
                                        Background="#1A22C55E"
                                        HorizontalAlignment="Left">
                                    <Image Source="/Assets/ServiceObs.png"
                                           Stretch="Uniform"
                                           Margin="8" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="OBS"
                                               FontSize="17"
                                               Style="{StaticResource TitleText}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ObsState.Text}"
                                               Foreground="{Binding ObsState.Brush}"
                                               FontWeight="SemiBold"
                                               Margin="0,5,0,0" />
                                </StackPanel>
                                <Rectangle Grid.Column="2"
                                           Width="24"
                                           Height="24"
                                           Fill="{Binding ObsState.Brush}"
                                           OpacityMask="{Binding ObsState.IconMask}"
                                           ToolTip="{Binding ObsState.ToolTip}"
                                           VerticalAlignment="Top" />
                            </Grid>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Row="2" Margin="0,0,0,18">
                        <TextBlock Text="Resumen rapido"
                                   FontSize="18"
                                   Style="{StaticResource TitleText}"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Style="{StaticResource Card}"
                                    Padding="14">
                                <StackPanel>
                                    <Image Source="/Assets/Icons/action_follower_teal.png"
                                           Width="22"
                                           Height="22"
                                           Stretch="Uniform"
                                           HorizontalAlignment="Left" />
                                    <TextBlock Text="Nuevos seguidores"
                                               Style="{StaticResource MutedText}"
                                               FontSize="12"
                                               Margin="0,9,0,0" />
                                    <TextBlock Text="{Binding Followers.Text}"
                                               Foreground="{Binding Followers.Brush}"
                                               FontSize="24"
                                               FontWeight="SemiBold"
                                               Margin="0,5,0,0" />
                                    <TextBlock Text="Hoy"
                                               Style="{StaticResource MutedText}"
                                               FontSize="11" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2"
                                    Style="{StaticResource Card}"
                                    Padding="14">
                                <StackPanel>
                                    <Image Source="/Assets/Icons/action_subscription_purple.png"
                                           Width="22"
                                           Height="22"
                                           Stretch="Uniform"
                                           HorizontalAlignment="Left" />
                                    <TextBlock Text="Suscripciones"
                                               Style="{StaticResource MutedText}"
                                               FontSize="12"
                                               Margin="0,9,0,0" />
                                    <TextBlock Text="{Binding Subscriptions.Text}"
                                               Foreground="{Binding Subscriptions.Brush}"
                                               FontSize="24"
                                               FontWeight="SemiBold"
                                               Margin="0,5,0,0" />
                                    <TextBlock Text="Hoy"
                                               Style="{StaticResource MutedText}"
                                               FontSize="11" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="4"
                                    Style="{StaticResource Card}"
                                    Padding="14">
                                <StackPanel>
                                    <Image Source="/Assets/Icons/action_bits_blue.png"
                                           Width="22"
                                           Height="22"
                                           Stretch="Uniform"
                                           HorizontalAlignment="Left" />
                                    <TextBlock Text="Bits recibidos"
                                               Style="{StaticResource MutedText}"
                                               FontSize="12"
                                               Margin="0,9,0,0" />
                                    <TextBlock Text="{Binding Bits.Text}"
                                               Foreground="{Binding Bits.Brush}"
                                               FontSize="24"
                                               FontWeight="SemiBold"
                                               Margin="0,5,0,0" />
                                    <TextBlock Text="Hoy"
                                               Style="{StaticResource MutedText}"
                                               FontSize="11" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="6"
                                    Style="{StaticResource Card}"
                                    Padding="14">
                                <StackPanel>
                                    <Image Source="/Assets/Icons/action_message_green.png"
                                           Width="22"
                                           Height="22"
                                           Stretch="Uniform"
                                           HorizontalAlignment="Left" />
                                    <TextBlock Text="Mensajes en chat"
                                               Style="{StaticResource MutedText}"
                                               FontSize="12"
                                               Margin="0,9,0,0" />
                                    <TextBlock Text="{Binding ChatMessages.Text}"
                                               Foreground="{Binding ChatMessages.Brush}"
                                               FontSize="24"
                                               FontWeight="SemiBold"
                                               Margin="0,5,0,0" />
                                    <TextBlock Text="Hoy"
                                               Style="{StaticResource MutedText}"
                                               FontSize="11" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="8"
                                    Style="{StaticResource Card}"
                                    Padding="14">
                                <StackPanel>
                                    <Image Source="/Assets/Icons/activity_notification_lime.png"
                                           Width="22"
                                           Height="22"
                                           Stretch="Uniform"
                                           HorizontalAlignment="Left" />
                                    <TextBlock Text="Eventos activados"
                                               Style="{StaticResource MutedText}"
                                               FontSize="12"
                                               Margin="0,9,0,0" />
                                    <TextBlock Text="{Binding Events.Text}"
                                               Foreground="{Binding Events.Brush}"
                                               FontSize="24"
                                               FontWeight="SemiBold"
                                               Margin="0,5,0,0" />
                                    <TextBlock Text="Hoy"
                                               Style="{StaticResource MutedText}"
                                               FontSize="11" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <Border Grid.Row="3"
                            Style="{StaticResource Card}">
                        <DockPanel LastChildFill="True">
                            <Grid DockPanel.Dock="Top"
                                  Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="160" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Actividad reciente"
                                               FontSize="18"
                                               Style="{StaticResource TitleText}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="Mensajes importantes, Twitch, Alexa y sistema."
                                               Style="{StaticResource MutedText}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="Ir a actividad"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Top"
                                        Command="{Binding GoToActivityCommand}" />
                            </Grid>
                            <ListBox x:Name="DashboardActivityList"
                                     ItemsSource="{Binding RecentActivityEntries}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     ItemContainerStyle="{StaticResource ActivityListItem}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ItemTemplate="{StaticResource ActivityTemplate}" />
                        </DockPanel>
                    </Border>
                </Grid>
</views:NeoTwitchView>
