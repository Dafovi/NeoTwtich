                                    <TextBox x:Name="BackgroundPrimaryColorBox"
                                             Margin="0"
                                             TextChanged="BackgroundFieldChanged" />
                                </DockPanel>

                                <TextBlock x:Name="BackgroundSecondaryColorLabel"
                                           Text="Color secundario de fondo"
                                           Style="{StaticResource MutedText}" />
                                <DockPanel x:Name="BackgroundSecondaryColorPanel"
                                           LastChildFill="True"
                                           Margin="0,4,0,12">
                                    <Button x:Name="BackgroundSecondaryColorButton"
                                            DockPanel.Dock="Right"
                                            Width="38"
                                            Margin="8,0,0,0"
                                            ToolTip="Escoger color"
                                            Click="BackgroundSecondaryColorButton_Click" />
                                    <TextBox x:Name="BackgroundSecondaryColorBox"
                                             Margin="0"
                                             TextChanged="BackgroundFieldChanged" />
                                </DockPanel>

                                <TextBlock x:Name="BackgroundTertiaryColorLabel"
                                           Text="Tercer color de fondo"
                                           Style="{StaticResource MutedText}" />
                                <DockPanel x:Name="BackgroundTertiaryColorPanel"
                                           LastChildFill="True"
                                           Margin="0,4,0,12">
                                    <Button x:Name="BackgroundTertiaryColorButton"
                                            DockPanel.Dock="Right"
                                            Width="38"
                                            Margin="8,0,0,0"
                                            ToolTip="Escoger color"
                                            Click="BackgroundTertiaryColorButton_Click" />
                                    <TextBox x:Name="BackgroundTertiaryColorBox"
                                             Margin="0"
                                             TextChanged="BackgroundFieldChanged" />
                                </DockPanel>

                                <Grid x:Name="BackgroundCycleGrid">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Delay de fondo" Style="{StaticResource MutedText}" />
                                    <TextBlock x:Name="BackgroundCycleValueText"
                                               Grid.Column="1"
                                               HorizontalAlignment="Right"
                                               Style="{StaticResource MutedText}" />
                                </Grid>
                                <Slider x:Name="BackgroundCycleSlider"
                                        Minimum="10"
                                        Maximum="2000"
                                        TickFrequency="10"
                                        ValueChanged="BackgroundFieldChanged" />

                                <Grid x:Name="BackgroundStepGrid">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Duracion del paso de fondo" Style="{StaticResource MutedText}" />
                                    <TextBlock x:Name="BackgroundStepValueText"
                                               Grid.Column="1"
                                               HorizontalAlignment="Right"
                                               Style="{StaticResource MutedText}" />
                                </Grid>
                                <Slider x:Name="BackgroundStepSlider"
                                        Minimum="10"
                                        Maximum="5000"
                                        TickFrequency="10"
                                        ValueChanged="BackgroundFieldChanged" />

                                <TextBlock Text="Simulacion"
                                           FontWeight="SemiBold"
                                           Margin="0,8,0,6" />
                                <Border x:Name="BackgroundLedPreviewPanel"
                                        BorderBrush="{DynamicResource ThemeBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="10"
                                        Background="{DynamicResource ThemeSurfaceBrush}"
                                        IsVisibleChanged="BackgroundLedPreviewPanel_IsVisibleChanged">
                                    <ItemsControl x:Name="BackgroundLedPreviewList">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Ellipse Width="16"
                                                         Height="16"
                                                         Fill="{Binding Fill}"
                                                         Stroke="#80FFFFFF"
                                                         StrokeThickness="1"
                                                         Margin="4">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect Color="{Binding GlowColor}"
                                                                          BlurRadius="{Binding GlowRadius}"
                                                                          ShadowDepth="0"
                                                                          Opacity="{Binding GlowOpacity}" />
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>

                                <WrapPanel Margin="0,8,0,0">
                                    <Button x:Name="ApplyArduinoBackgroundButton"
                                            Content="Aplicar fondo LED"
                                            Style="{StaticResource PrimaryButton}"
                                            Click="ApplyArduinoBackgroundButton_Click" />
                                    <Button Content="Apagar tiras"
                                            Style="{StaticResource DangerButton}"
                                            Click="StopArduinoBackgroundButton_Click" />
                                    <Button Content="Borrar salida"
                                            Style="{StaticResource DangerButton}"
                                            Click="RemoveStripButton_Click" />
                                </WrapPanel>

                                <Button Content="Agregar salida de pin digital"
                                        Style="{StaticResource PrimaryButton}"
                                        HorizontalContentAlignment="Center"
                                        Margin="0,12,0,0"
                                        Click="AddStripButton_Click" />

                                <Grid Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border BorderBrush="{DynamicResource ThemeBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="14"
                                            Background="{DynamicResource ThemeInputBrush}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="46" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Image Source="Assets/Icons/nav_arduino.png"
                                                   Width="30"
                                                   Height="30"
                                                   Stretch="Uniform"
                                                   VerticalAlignment="Top" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Sketch"
                                                           FontWeight="SemiBold"
                                                           FontSize="15" />
                                                <TextBlock Text="Tu Arduino necesita el sketch instalado para funcionar con Neo Twitch."
                                                           Style="{StaticResource MutedText}"
                                                           TextWrapping="Wrap"
                                                           FontSize="12"
                                                           Margin="0,4,0,10" />
                                                <WrapPanel>
                                                    <Button Content="Descargar ultimo sketch"
                                                            Style="{StaticResource PrimaryButton}"
                                                            Click="OpenArduinoSketchButton_Click" />
                                                    <Button Content="Ver guia"
                                                            Click="OpenArduinoGuideButton_Click" />
                                                </WrapPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Border Grid.Column="2"
                                            BorderBrush="{DynamicResource ThemeBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="14"
                                            Background="{DynamicResource ThemeInputBrush}">
                                        <StackPanel>
                                            <TextBlock Text="Estado actual"
                                                       FontWeight="SemiBold"
                                                       FontSize="15"
                                                       Margin="0,0,0,8" />
                                            <Grid Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Dispositivo" Style="{StaticResource MutedText}" />
                                                <TextBlock x:Name="LightsArduinoDeviceText"
                                                           Grid.Column="1"
                                                           FontWeight="SemiBold" />
                                            </Grid>
                                            <Grid Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Puerto actual" Style="{StaticResource MutedText}" />
                                                <TextBlock x:Name="LightsArduinoPortText"
                                                           Grid.Column="1"
                                                           FontWeight="SemiBold" />
                                            </Grid>
                                            <Grid Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="LEDs configurados" Style="{StaticResource MutedText}" />
                                                <TextBlock x:Name="LightsArduinoLedCountText"
                                                           Grid.Column="1"
                                                           FontWeight="SemiBold" />
                                            </Grid>
                                            <Grid Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Pines activos" Style="{StaticResource MutedText}" />
                                                <TextBlock x:Name="LightsArduinoPinsText"
                                                           Grid.Column="1"
                                                           FontWeight="SemiBold" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
            </TabItem>

            <TabItem Header="Alexa">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                    <Grid Margin="24" MinWidth="780">
                        <Border Style="{StaticResource Card}">
                            <StackPanel x:Name="AlexaBackgroundPanel">
                                    <TextBlock Text="Fondo Alexa"
                                               FontSize="18"
                                               Style="{StaticResource TitleText}"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,12" />
                                    <TextBlock Text="Esta salida envia eventos al relay de Alexa para controlar rutinas o dispositivos configurados en tu skill."
                                               Style="{StaticResource MutedText}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,12" />
                                    <TextBlock x:Name="AlexaBackgroundUnavailableText"
                                               Text="Primero activa y configura Alexa en Conexiones para usar este fondo."
                                               Style="{StaticResource MutedText}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,12" />
                                    <CheckBox x:Name="BackgroundAlexaEnabledCheck"
                                              Content="Mantener fondo Alexa encendido"
                                              Checked="BackgroundFieldChanged"
                                              Unchecked="BackgroundFieldChanged" />
                                    <CheckBox x:Name="BackgroundAlexaTurnOffAfterEventCheck"
                                              Content="Apagar fondo Alexa al finalizar evento"
                                              Checked="BackgroundFieldChanged"
                                              Unchecked="BackgroundFieldChanged" />

                                    <Grid x:Name="BackgroundAlexaEventsGrid">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Evento Alexa encendido"
                                                       Style="{StaticResource MutedText}" />
                                            <TextBox x:Name="BackgroundAlexaOnEventBox"
                                                     TextChanged="BackgroundFieldChanged"
                                                     ToolTip="Evento que recibira el relay cuando el fondo Alexa debe quedar encendido." />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Evento Alexa apagado"
                                                       Style="{StaticResource MutedText}" />
                                            <TextBox x:Name="BackgroundAlexaOffEventBox"
                                                     TextChanged="BackgroundFieldChanged"
                                                     ToolTip="Evento que recibira el relay cuando el fondo Alexa debe quedar apagado." />
                                        </StackPanel>
                                    </Grid>

                                    <WrapPanel Margin="0,8,0,0">
                                        <Button x:Name="ApplyAlexaBackgroundButton"
                                                Content="Aplicar fondo Alexa"
                                                Style="{StaticResource PrimaryButton}"
                                                Click="ApplyAlexaBackgroundButton_Click" />
                                        <Button Content="Apagar fondo Alexa"
                                                x:Name="StopAlexaBackgroundButton"
                                                Style="{StaticResource DangerButton}"
                                                Click="StopAlexaBackgroundButton_Click" />
                                    </WrapPanel>
                                </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Configuracion">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                    <Grid Margin="24" MinWidth="780">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,18">
                            <TextBlock Text="Configuracion"
                                       FontSize="28"
                                       Style="{StaticResource TitleText}"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Ajusta el comportamiento general, audio y cola de alertas."
                                       Style="{StaticResource MutedText}"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <Border Grid.Row="1"
                                Grid.Column="0"
                                Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Ventana y apariencia"
                                           FontSize="18"
                                           Style="{StaticResource TitleText}"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,10" />
                                <CheckBox x:Name="StartHiddenCheck"
                                          Content="Abrir minimizada"
                                          Checked="GlobalSettingsChanged"
                                          Unchecked="GlobalSettingsChanged" />
                                <CheckBox x:Name="CloseToTrayCheck"
                                          Content="Cerrar con X envia a segundo plano"
                                          Checked="GlobalSettingsChanged"
                                          Unchecked="GlobalSettingsChanged" />
                                <TextBlock Text="Tema"
                                           Style="{StaticResource MutedText}" />
                                <ComboBox x:Name="ThemeModeBox"
                                          SelectionChanged="ThemeModeChanged" />
                                <TextBlock x:Name="SettingsPathText"
                                           Style="{StaticResource MutedText}"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,0" />
                                <TextBlock x:Name="BackupPathText"
                                           Style="{StaticResource MutedText}"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,8" />
                                <WrapPanel>
                                    <Button Content="Exportar configuracion"
                                            Click="ExportSettingsButton_Click" />
                                    <Button Content="Importar configuracion"
                                            Click="ImportSettingsButton_Click" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1"
                                Grid.Column="2"
                                Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Audio"
                                           FontSize="18"
                                           Style="{StaticResource TitleText}"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,10" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="70" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Volumen de alertas" Style="{StaticResource MutedText}" />
                                    <TextBlock x:Name="AlertVolumeValueText"
                                               Grid.Column="1"
                                               HorizontalAlignment="Right"
                                               Style="{StaticResource MutedText}" />
                                </Grid>
                                <Slider x:Name="AlertVolumeSlider"
                                        Minimum="0"
                                        Maximum="100"
                                        TickFrequency="1"
                                        ValueChanged="GlobalSettingsChanged" />
                                <TextBlock Text="Este volumen se aplica a todos los audios reproducidos por las reglas."
                                           Style="{StaticResource MutedText}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2"
                                Grid.ColumnSpan="3"
                                Style="{StaticResource Card}"
                                Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="Cola de alertas"
                                           FontSize="18"
                                           Style="{StaticResource TitleText}"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,10" />
                                <TextBlock Text="Controla cuantas alertas se acumulan cuando Twitch manda muchas seguidas."
                                           Style="{StaticResource MutedText}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,12" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="Repetidas maximas en cola"
                                                   Style="{StaticResource MutedText}" />
                                        <TextBox x:Name="MaxQueuedSameRuleAlertsBox"
                                                 TextChanged="GlobalSettingsChanged"
                                                 ToolTip="Cuantas alertas de la misma regla pueden esperar mientras otra se reproduce. 1 es el valor recomendado." />

                                        <TextBlock Text="Tiempo minimo para repetir"
                                                   Style="{StaticResource MutedText}" />
                                        <TextBox x:Name="SameRuleQueueCooldownBox"
                                                 TextChanged="GlobalSettingsChanged"
                                                 ToolTip="Milisegundos desde que empezo una regla antes de permitir otra igual. Usa 0 para desactivar este filtro." />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Distintas maximas en cola"
                                                   Style="{StaticResource MutedText}" />
                                        <TextBox x:Name="MaxQueuedDifferentRuleAlertsBox"
                                                 TextChanged="GlobalSettingsChanged"
                                                 ToolTip="Cuantas alertas de reglas distintas pueden esperar mientras otra se reproduce." />

                                        <TextBlock Text="Tiempo minimo para distintas"
                                                   Style="{StaticResource MutedText}" />
                                        <TextBox x:Name="DifferentRuleQueueCooldownBox"
                                                 TextChanged="GlobalSettingsChanged"
                                                 ToolTip="Milisegundos desde que empezo una regla antes de permitir otra distinta. Usa 0 para desactivar este filtro." />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="3"
                                Grid.ColumnSpan="3"
                                Style="{StaticResource Card}"
                                Margin="0,18,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="66" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="220" />
                                </Grid.ColumnDefinitions>
                                <Border Width="52"
                                        Height="52"
                                        CornerRadius="14"
                                        Background="#1A14B8A6"
                                        HorizontalAlignment="Left">
                                    <Border Width="28"
                                            Height="28"
                                            Background="#14B8A6"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                        <Border.OpacityMask>
                                            <ImageBrush ImageSource="Assets/Icons/nav_connections.png"
                                                        Stretch="Uniform" />
                                        </Border.OpacityMask>
                                    </Border>
                                </Border>
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Conexion automatica"
                                               FontSize="18"
                                               Style="{StaticResource TitleText}"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,10" />
                                    <WrapPanel>
                                        <CheckBox x:Name="AutoTwitchCheck"
                                                  Content="Conectar Twitch al abrir"
                                                  Checked="GlobalSettingsChanged"
                                                  Unchecked="GlobalSettingsChanged" />
                                        <CheckBox x:Name="AutoArduinoCheck"
                                                  Content="Conectar Arduino al abrir"
                                                  Checked="GlobalSettingsChanged"
                                                  Unchecked="GlobalSettingsChanged" />
                                    </WrapPanel>
                                    <TextBlock Text="Estas opciones intentan conectar los servicios apenas abre Neo Twitch."
                                               Style="{StaticResource MutedText}"
                                               TextWrapping="Wrap"
                                               Margin="0,8,0,0" />
                                </StackPanel>
                                <Button Grid.Column="2"
                                        Content="Guardar configuracion"
                                        Style="{StaticResource PrimaryButton}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Click="SaveButton_Click" />
                            </Grid>
                        </Border>

                        <Border Grid.Row="4"
                                Grid.ColumnSpan="3"
                                Style="{StaticResource Card}"
                                Margin="0,18,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="220" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Diagnostico"
                                               FontSize="18"
                                               Style="{StaticResource TitleText}"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,10" />
                                    <TextBlock Text="Revisa configuracion, conexiones, reglas, audios y version sin ejecutar alertas."
                                               Style="{StaticResource MutedText}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="Ejecutar diagnostico"
                                        Style="{StaticResource PrimaryButton}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Click="RunDiagnosticsButton_Click" />
                            </Grid>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Actividad">
                <Grid Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Consola en vivo"
                                       FontSize="28"
                                       Style="{StaticResource TitleText}"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Monitorea todo lo que sucede en tiempo real."
                                       Style="{StaticResource MutedText}"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <TextBox x:Name="ActivitySearchBox"
                                 Grid.Column="1"
                                 VerticalAlignment="Bottom"
                                 Margin="0"
                                 ToolTip="Buscar en la consola"
                                 TextChanged="ActivitySearchBox_TextChanged" />

                        <Button Grid.Column="3"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Content="Limpiar filtros"
                                Click="ClearActivityFiltersButton_Click" />
                    </Grid>

                    <WrapPanel Grid.Row="1"
                               Margin="0,0,0,12">
                        <ToggleButton x:Name="ActivityFilterTwitchButton"
                                      Tag="TWITCH"
                                      IsChecked="True"
                                      Style="{StaticResource ActivityFilterButton}"
                                      Checked="ActivityFilterButton_CheckedChanged"
                                      Unchecked="ActivityFilterButton_CheckedChanged">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="Assets/Icons/service_twitch.png"
                                       Width="16"
                                       Height="16"
                                       Margin="0,0,7,0" />
                                <TextBlock Text="Twitch"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="ActivityFilterArduinoButton"
                                      Tag="ARDUINO"
                                      IsChecked="True"
                                      Style="{StaticResource ActivityFilterButton}"
                                      Checked="ActivityFilterButton_CheckedChanged"
                                      Unchecked="ActivityFilterButton_CheckedChanged">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="Assets/Icons/service_arduino.png"
                                       Width="18"
                                       Height="16"
                                       Margin="0,0,7,0" />
                                <TextBlock Text="Arduino"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="ActivityFilterAlexaButton"
                                      Tag="ALEXA"
                                      IsChecked="True"
                                      Style="{StaticResource ActivityFilterButton}"
                                      Checked="ActivityFilterButton_CheckedChanged"
                                      Unchecked="ActivityFilterButton_CheckedChanged">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="Assets/Icons/service_alexa.png"
                                       Width="16"
                                       Height="16"
                                       Margin="0,0,7,0" />
                                <TextBlock Text="Alexa"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="ActivityFilterAudioButton"
                                      Tag="AUDIO"
                                      IsChecked="True"
                                      Style="{StaticResource ActivityFilterButton}"
                                      Checked="ActivityFilterButton_CheckedChanged"
                                      Unchecked="ActivityFilterButton_CheckedChanged">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="Assets/Icons/service_audio.png"
                                       Width="16"
                                       Height="16"
                                       Margin="0,0,7,0" />
                                <TextBlock Text="Audio"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="ActivityFilterEventButton"
                                      Tag="EVENTO"
                                      IsChecked="True"
                                      Style="{StaticResource ActivityFilterButton}"
                                      Checked="ActivityFilterButton_CheckedChanged"
                                      Unchecked="ActivityFilterButton_CheckedChanged">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="16" Height="16" Margin="0,0,7,0">
                                    <Path Data="M5,4 L19,4 L19,18 L5,18 Z M8,2 L8,6 M16,2 L16,6 M5,9 L19,9"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                          StrokeThickness="2.2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" />
                                </Viewbox>
                                <TextBlock Text="Evento"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="ActivityFilterSystemButton"
                                      Tag="SISTEMA"
                                      IsChecked="True"
                                      Style="{StaticResource ActivityFilterButton}"
                                      Checked="ActivityFilterButton_CheckedChanged"
                                      Unchecked="ActivityFilterButton_CheckedChanged">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="16" Height="16" Margin="0,0,7,0">
                                    <Path Data="M12,8 A4,4 0 1 1 12,16 A4,4 0 1 1 12,8 M12,2 L14,2 L15,5 L18,4 L20,6 L19,9 L22,11 L22,13 L19,15 L20,18 L18,20 L15,19 L14,22 L10,22 L9,19 L6,20 L4,18 L5,15 L2,13 L2,11 L5,9 L4,6 L6,4 L9,5 L10,2 Z"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                          StrokeThickness="2.1"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" />
                                </Viewbox>
                                <TextBlock Text="Sistema"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="ActivityFilterImportantButton"
                                      Tag="IMPORTANTE"
                                      IsChecked="True"
                                      Style="{StaticResource ActivityFilterButton}"
                                      Checked="ActivityFilterButton_CheckedChanged"
                                      Unchecked="ActivityFilterButton_CheckedChanged">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="16"
                                        Height="16"
                                        Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                        Margin="0,0,7,0">
                                    <Border.OpacityMask>
                                        <ImageBrush ImageSource="Assets/Icons/status_important.png"
                                                    Stretch="Uniform" />
                                    </Border.OpacityMask>
                                </Border>
                                <TextBlock Text="Importante"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                            </StackPanel>
                        </ToggleButton>
                    </WrapPanel>

                    <Border Grid.Row="2"
                            Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Margin="14,0,14,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="72" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Hora"
                                           Style="{StaticResource MutedText}"
                                           FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1"
                                           Text="Fuente"
                                           Style="{StaticResource MutedText}"
                                           FontWeight="SemiBold" />
                                <TextBlock Grid.Column="2"
                                           Text="Evento"
                                           Style="{StaticResource MutedText}"
                                           FontWeight="SemiBold" />
                                <TextBlock Grid.Column="3"
                                           Text="Estado"
                                           Style="{StaticResource MutedText}"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Right" />
                            </Grid>
                            <ListBox x:Name="ActivityList"
                                     Grid.Row="1"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     ItemContainerStyle="{StaticResource ActivityListItem}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ItemTemplate="{StaticResource ActivityTemplate}" />
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

    </Grid>
</Window>
