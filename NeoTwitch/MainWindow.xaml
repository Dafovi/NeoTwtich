                                                                           TextTrimming="CharacterEllipsis"
                                                                           ToolTip="{Binding FilePath}" />
                                                                <TextBlock Text="{Binding FilePath}"
                                                                           Style="{StaticResource MutedText}"
                                                                           FontSize="11"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <ComboBox Grid.Column="1"
                                                                  Tag="{Binding Id}"
                                                                  ItemsSource="{Binding DataContext.ImageGroupChoices, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  DisplayMemberPath="Name"
                                                                  SelectedValuePath="Id"
                                                                  SelectedValue="{Binding GroupId}"
                                                                  DropDownClosed="ImageLibraryGroupBox_DropDownClosed" />
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding MetadataText}"
                                                                   Style="{StaticResource MutedText}"
                                                                   VerticalAlignment="Center" />
                                                        <Button Grid.Column="3"
                                                                Width="34"
                                                                Height="32"
                                                                Padding="0"
                                                                Background="{DynamicResource ThemeInputBrush}"
                                                                BorderBrush="#F43F5E"
                                                                Tag="{Binding Id}"
                                                                ToolTip="Eliminar imagen"
                                                                Click="DeleteImageButton_Click">
                                                            <Border Width="16"
                                                                    Height="16"
                                                                    Background="#F43F5E"
                                                                    Tag="StaticBrush">
                                                                <Border.OpacityMask>
                                                                    <ImageBrush ImageSource="Assets/Icons/icon_delete.png"
                                                                                Stretch="Uniform" />
                                                                </Border.OpacityMask>
                                                            </Border>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <TextBlock x:Name="ImageLibraryFooterText"
                                           Grid.Row="3"
                                           Text="Mostrando 0 imagenes"
                                           Style="{StaticResource MutedText}"
                                           Margin="0,12,0,0" />
                            </Grid>
                        </Border>

                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="1.1*" />
                                <RowDefinition Height="18" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Style="{StaticResource Card}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel>
                                        <TextBlock Text="Añadir nueva imagen"
                                                   FontSize="18"
                                                   Style="{StaticResource TitleText}"
                                                   FontWeight="SemiBold" />
                                        <Button Margin="0,12,0,12"
                                                MinHeight="92"
                                                BorderBrush="#5537C7F3"
                                                Background="{DynamicResource ThemeInputBrush}"
