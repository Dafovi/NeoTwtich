                                                                   FontSize="11"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>

                                            <Button Content="Eliminar alerta"
                                                    Style="{StaticResource DangerButton}"
