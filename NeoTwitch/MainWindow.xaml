                                               Margin="8" />
                                    </Border>
                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="Conectar Alexa"
                                                   FontSize="18"
                                                   Style="{StaticResource TitleText}"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="Activa el relay para enviar eventos desde Neo Twitch a Alexa."
                                                   Style="{StaticResource MutedText}"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                    <Border x:Name="ConnectionsAlexaBadge"
                                            Grid.Column="2"
                                            CornerRadius="14"
                                            Padding="11,5"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top">
                                        <TextBlock x:Name="ConnectionsAlexaBadgeText"
                                                   Text="Desconectado"
                                                   FontSize="12"
                                                   FontWeight="SemiBold" />
                                    </Border>
                                </Grid>

                                <CheckBox x:Name="AlexaEnabledCheck"
                                          Grid.Row="1"
                                          Content="Activar integracion con Alexa"
                                          Checked="AlexaSettingsChanged"
                                          Unchecked="AlexaSettingsChanged"
                                          Margin="0,18,0,8" />

                                <Grid Grid.Row="2"
                                      Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="URL de Skill / relay"
                                                   Style="{StaticResource MutedText}" />
                                        <Grid Margin="0,4,0,0">
                                            <TextBox x:Name="AlexaRelayUrlBox"
                                                     Margin="0"
                                                     Padding="10,6,76,6"
                                                     TextChanged="AlexaSettingsChanged"
                                                     ToolTip="Endpoint HTTPS que recibe eventos de Neo Twitch y los envia a Alexa." />
                                            <TextBlock x:Name="AlexaRelayUrlMaskText"
                                                       Margin="1,1,72,1"
                                                       Padding="9,6"
                                                       VerticalAlignment="Stretch"
                                                       Background="{DynamicResource ThemeInputBrush}"
                                                       Foreground="{DynamicResource ThemeMutedTextBrush}"
                                                       Visibility="Collapsed" />
                                            <Button x:Name="AlexaRelayUrlRevealButton"
                                                    Content="Ver"
                                                    Width="64"
                                                    MinHeight="0"
                                                    Padding="8,0"
                                                    Margin="0"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Stretch"
                                                    ToolTip="Mostrar u ocultar URL de Alexa"
                                                    Click="ToggleAlexaRelayUrlVisibility_Click" />
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Token opcional"
                                                   Style="{StaticResource MutedText}" />
                                        <Grid Margin="0,4,0,0">
                                            <TextBox x:Name="AlexaAuthTokenBox"
                                                     Margin="0"
                                                     Padding="10,6,76,6"
                                                     TextChanged="AlexaSettingsChanged"
                                                     ToolTip="Token/API key opcional para proteger el relay." />
                                            <TextBlock x:Name="AlexaAuthTokenMaskText"
                                                       Margin="1,1,72,1"
                                                       Padding="9,6"
                                                       VerticalAlignment="Stretch"
                                                       Background="{DynamicResource ThemeInputBrush}"
                                                       Foreground="{DynamicResource ThemeMutedTextBrush}"
                                                       Visibility="Collapsed" />
                                            <Button x:Name="AlexaAuthTokenRevealButton"
                                                    Content="Ver"
                                                    Width="64"
                                                    MinHeight="0"
                                                    Padding="8,0"
                                                    Margin="0"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Stretch"
                                                    ToolTip="Mostrar u ocultar token de Alexa"
                                                    Click="ToggleAlexaAuthTokenVisibility_Click" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="3"
                                      Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="360" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="AlexaStatusText"
                                               Style="{StaticResource MutedText}"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center" />
                                    <WrapPanel Grid.Column="1"
                                               HorizontalAlignment="Right">
                                        <Button Content="Abrir Alexa Console"
                                                Click="OpenAlexaConsoleButton_Click" />
                                        <Button Content="Probar Alexa"
                                                Style="{StaticResource PrimaryButton}"
                                                Click="TestAlexaButton_Click" />
                                    </WrapPanel>
                                </Grid>
                            </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Reglas">
                    <Grid Margin="24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="0" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="430" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.ColumnSpan="3" Margin="0" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="Reglas y alertas"
                                           FontSize="28"
                                           Style="{StaticResource TitleText}"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="Crea reglas para seguidores, subs, raids, bits, chat y canjes."
                                           Style="{StaticResource MutedText}"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="1"
                                Grid.Column="0"
                                Style="{StaticResource Card}">
                            <DockPanel LastChildFill="True">
                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                    <Grid Margin="0,0,0,12">
                                        <TextBlock Text="Mis alertas"
                                                   FontSize="18"
                                                   Style="{StaticResource TitleText}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                        <Button Content="Nueva alerta"
                                                Style="{StaticResource PrimaryButton}"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Click="AddRuleButton_Click" />
                                    </Grid>

                                    <TextBox x:Name="RuleSearchBox"
                                             MinHeight="38"
                                             Margin="0,0,0,10"
                                             TextChanged="RuleSearchBox_TextChanged"
                                             ToolTip="Buscar alertas por nombre, evento o comando." />

                                    <WrapPanel Margin="0,0,0,8">
                                        <ToggleButton x:Name="RuleFilterAllButton"
                                                      Content="Todas"
                                                      Tag="ALL"
                                                      IsChecked="True"
                                                      Style="{StaticResource ActivityFilterButton}"
                                                      Click="RuleStatusFilterButton_Click" />
                                        <ToggleButton x:Name="RuleFilterActiveButton"
                                                      Content="Activas"
                                                      Tag="ACTIVE"
                                                      Style="{StaticResource ActivityFilterButton}"
                                                      Click="RuleStatusFilterButton_Click" />
                                        <ToggleButton x:Name="RuleFilterInactiveButton"
                                                      Content="Inactivas"
                                                      Tag="INACTIVE"
                                                      Style="{StaticResource ActivityFilterButton}"
                                                      Click="RuleStatusFilterButton_Click" />
                                    </WrapPanel>

                                    <ComboBox x:Name="RuleCategoryFilterBox"
                                              SelectionChanged="RuleCategoryFilterBox_SelectionChanged" />
                                </StackPanel>

                                <TextBlock x:Name="RulesCountText"
                                           DockPanel.Dock="Bottom"
                                           Style="{StaticResource MutedText}"
                                           FontSize="12"
                                           Margin="0,8,0,0" />

                                <ListBox x:Name="RulesList"
                                         BorderBrush="{DynamicResource ThemeBorderBrush}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         SelectionChanged="RulesList_SelectionChanged">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}" />
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="SelectedRuleFrame"
                                                                BorderBrush="Transparent"
                                                                BorderThickness="2"
                                                                CornerRadius="14"
                                                                Padding="2"
                                                                Margin="0,0,0,6">
                                                            <ContentPresenter />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="SelectedRuleFrame" Property="BorderBrush" Value="{DynamicResource ThemeSelectionBrush}" />
                                                                <Setter TargetName="SelectedRuleFrame" Property="Background" Value="{DynamicResource ThemeButtonBrush}" />
                                                            </Trigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="SelectedRuleFrame" Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource ThemeBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="12"
                                                    Padding="10"
                                                    Margin="0"
                                                    Background="{DynamicResource ThemeInputBrush}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="44" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border Width="36"
                                                            Height="36"
                                                            CornerRadius="12"
                                                            Background="{Binding EventAccentColor}"
                                                            Opacity="0.18" />
                                                    <Image Width="24"
                                                           Height="24"
                                                           Source="{Binding EventIconPath}"
                                                           Stretch="Uniform"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />

                                                    <StackPanel Grid.Column="1"
                                                                Margin="8,0,10,0">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding DisplayLabel}"
                                                                   Style="{StaticResource MutedText}"
                                                                   FontSize="12"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Margin="0,2,0,0" />
                                                        <WrapPanel Margin="0,6,0,0">
                                                            <Image Source="Assets/Icons/nav_lights.png"
                                                                   Width="16"
                                                                   Height="16"
                                                                   Margin="0,0,10,0"
                                                                   Visibility="{Binding LightsActionVisibility}" />
                                                            <Image Source="Assets/Icons/service_audio.png"
                                                                   Width="16"
                                                                   Height="16"
                                                                   Margin="0,0,10,0"
                                                                   Visibility="{Binding AudioActionVisibility}" />
                                                            <Image Source="Assets/Icons/action_message_green.png"
                                                                   Width="16"
                                                                   Height="16"
                                                                   Margin="0,0,10,0"
                                                                   Visibility="{Binding ChatActionVisibility}" />
                                                            <Image Source="Assets/Icons/service_alexa.png"
                                                                   Width="16"
                                                                   Height="16"
                                                                   Margin="0,0,10,0"
                                                                   Visibility="{Binding AlexaActionVisibility}" />
                                                        </WrapPanel>
                                                    </StackPanel>

                                                    <Border Grid.Column="2"
                                                            Padding="8,3"
                                                            CornerRadius="10"
                                                            Background="{Binding StatusColor}"
                                                            Opacity="0.92"
                                                            VerticalAlignment="Top">
                                                        <TextBlock Text="{Binding StatusText}"
                                                                   Foreground="White"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>

                        <Border Grid.Row="1"
                                Grid.Column="2"
                                Style="{StaticResource Card}">
                            <DockPanel LastChildFill="True">
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Configurar alerta"
                                                   FontSize="18"
                                                   Style="{StaticResource TitleText}"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="Define el evento y las acciones que se ejecutan."
                                                   Style="{StaticResource MutedText}"
                                                   FontSize="12"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                    <WrapPanel Grid.Column="1"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Top">
                                        <Button Content="Duplicar" Click="DuplicateRuleButton_Click" />
                                        <Button x:Name="RuleTestButton"
                                                Content="Probar alerta"
                                                Style="{StaticResource PrimaryButton}"
                                                Click="RuleTestButton_Click" />
                                        <Button Content="Guardar cambios"
                                                Style="{StaticResource PrimaryButton}"
                                                Click="SaveButton_Click" />
                                    </WrapPanel>
                                </Grid>

                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="RuleEditorPanel">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="18" />
                                                <ColumnDefinition Width="170" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Nombre de la alerta"
                                                           Style="{StaticResource MutedText}" />
                                                <TextBox x:Name="RuleNameBox"
                                                         TextChanged="RuleFieldChanged" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Estado"
                                                           Style="{StaticResource MutedText}" />
                                                <CheckBox x:Name="RuleEnabledCheck"
                                                          Content="Activa"
                                                          Checked="RuleFieldChanged"
                                                          Unchecked="RuleFieldChanged" />
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="Tipo de evento"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Margin="0,6,0,2" />
                                        <TextBlock Text="Elige cuando se activa esta alerta."
                                                   Style="{StaticResource MutedText}"
                                                   FontSize="12" />
                                        <ComboBox x:Name="EventKindBox"
                                                  Visibility="Collapsed"
                                                  SelectionChanged="RuleFieldChanged" />

                                        <Grid Margin="0,8,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="92" />
                                                <RowDefinition Height="10" />
                                                <RowDefinition Height="92" />
                                            </Grid.RowDefinitions>

                                            <Button x:Name="EventFollowTileButton"
                                                    Tag="Follow"
                                                    Click="EventKindTile_Click">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <Image Source="Assets/Icons/action_follower_teal.png"
                                                           Width="26"
                                                           Height="26"
                                                           Margin="0,0,0,8" />
                                                    <TextBlock Text="Nuevo seguidor"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               TextAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="EventSubscriptionTileButton"
                                                    Grid.Column="2"
                                                    Tag="Subscription"
                                                    Click="EventKindTile_Click">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <Image Source="Assets/Icons/action_subscription_purple.png"
                                                           Width="26"
                                                           Height="26"
                                                           Margin="0,0,0,8" />
                                                    <TextBlock Text="Nueva suscripcion"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               TextAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="EventRaidTileButton"
                                                    Grid.Column="4"
                                                    Tag="Raid"
                                                    Click="EventKindTile_Click">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <Image Source="Assets/Icons/activity_notification.png"
                                                           Width="26"
                                                           Height="26"
                                                           Margin="0,0,0,8" />
                                                    <TextBlock Text="Raid recibida"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               TextAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="EventCheerTileButton"
                                                    Grid.Row="2"
                                                    Tag="Cheer"
                                                    Click="EventKindTile_Click">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <Image Source="Assets/Icons/action_bits_blue.png"
                                                           Width="26"
                                                           Height="26"
                                                           Margin="0,0,0,8" />
                                                    <TextBlock Text="Bits"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               TextAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="EventChatCommandTileButton"
                                                    Grid.Row="2"
                                                    Grid.Column="2"
                                                    Tag="ChatCommand"
                                                    Click="EventKindTile_Click">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <Image Source="Assets/Icons/action_message_green.png"
                                                           Width="26"
                                                           Height="26"
                                                           Margin="0,0,0,8" />
                                                    <TextBlock Text="Comando de chat"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               TextAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="EventRedemptionTileButton"
                                                    Grid.Row="2"
                                                    Grid.Column="4"
                                                    Tag="ChannelPointRedemption"
                                                    Click="EventKindTile_Click">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <Image Source="Assets/Icons/activity_notification_lime.png"
                                                           Width="26"
                                                           Height="26"
                                                           Margin="0,0,0,8" />
                                                    <TextBlock Text="Canje de puntos"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               TextAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>

                                        <StackPanel>
                                            <TextBlock x:Name="RewardTitleLabel"
                                                       Text="Canje especifico"
                                                       Style="{StaticResource MutedText}" />
                                            <TextBox x:Name="RewardTitleBox"
                                                     TextChanged="RuleFieldChanged"
                                                     ToolTip="Dejalo vacio para aceptar cualquier canje personalizado." />

                                            <TextBlock x:Name="MinimumBitsLabel"
                                                       Text="Bits minimos"
                                                       Style="{StaticResource MutedText}" />
                                            <TextBox x:Name="MinimumBitsBox"
                                                     TextChanged="RuleFieldChanged"
                                                     ToolTip="Para bits, usa el mayor umbral que sea menor o igual a la cantidad recibida." />
