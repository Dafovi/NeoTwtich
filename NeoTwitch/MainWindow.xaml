                                        <Button x:Name="ImageFilterAllButton"
                                                Content="Todos"
                                                Tag="ALL"
                                                Click="ImageFilterButton_Click" />
                                        <Button x:Name="ImageFilterWithGroupButton"
                                                Content="Con grupo"
                                                Tag="WITH_GROUP"
                                                Click="ImageFilterButton_Click" />
                                        <Button x:Name="ImageFilterNoGroupButton"
                                                Content="Sin grupo"
                                                Tag="NO_GROUP"
                                                Click="ImageFilterButton_Click" />
                                    </WrapPanel>
                                </Grid>

                                <ScrollViewer Grid.Row="2"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl x:Name="ImageLibraryList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource ThemeBorderBrush}"
                                                        BorderThickness="0,1,0,0"
                                                        Padding="0,10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="2*" />
                                                            <ColumnDefinition Width="1.25*" />
                                                            <ColumnDefinition Width="1.05*" />
                                                            <ColumnDefinition Width="58" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal"
                                                                    VerticalAlignment="Center">
                                                            <Border Width="36"
                                                                    Height="36"
                                                                    CornerRadius="9"
                                                                    Background="{Binding AccentBackground}"
