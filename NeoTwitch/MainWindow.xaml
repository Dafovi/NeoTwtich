                    <Button x:Name="CloseWindowButton"
                            Content="&#xE8BB;"
                            Width="38"
                            MinHeight="30"
                            Padding="0"
                            Margin="0"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="11"
