        <Border x:Name="SidebarChrome"
                Grid.Row="1"
                Grid.Column="0"
                Background="{DynamicResource ThemeSidebarBrush}"
                Padding="10">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Top"
                            HorizontalAlignment="Stretch"
                            Margin="0,8,0,0">
                    <Rectangle Height="1"
                               Fill="#331A0B2E"
                               Margin="0,0,0,12" />

                    <Button x:Name="NavSettingsButton"
                            Tag="0"
                            Style="{StaticResource NavButton}"
                            ToolTip="Panel principal"
                            Click="NavButton_Click" />
                    <Button x:Name="NavConnectionsButton"
                            Tag="1"
                            Style="{StaticResource NavButton}"
                            ToolTip="Conexiones"
                            Click="NavButton_Click" />
                    <Button x:Name="NavRulesButton"
                            Tag="2"
                            Style="{StaticResource NavButton}"
                            ToolTip="Alertas"
                            Click="NavButton_Click" />
                    <Button x:Name="NavStripsButton"
                            Tag="3"
                            Style="{StaticResource NavButton}"
                            ToolTip="Luces de fondo"
                            Click="NavButton_Click" />
                    <Button x:Name="NavAlexaButton"
                            Tag="4"
                            Style="{StaticResource NavButton}"
                            ToolTip="Alexa"
                            Click="NavButton_Click" />
                    <Button x:Name="NavAudioButton"
                            Tag="5"
                            Style="{StaticResource NavButton}"
                            ToolTip="Audio"
                            Click="NavButton_Click" />
                    <Button x:Name="NavImagesButton"
                            Tag="6"
                            Style="{StaticResource NavButton}"
                            ToolTip="Imagenes"
                            Click="NavButton_Click" />
                    <Button x:Name="NavVideosButton"
                            Tag="7"
                            Style="{StaticResource NavButton}"
                            ToolTip="Videos"
                            Click="NavButton_Click" />
                    <Button x:Name="NavObsButton"
                            Tag="8"
                            Style="{StaticResource NavButton}"
                            ToolTip="OBS"
                            Click="NavButton_Click" />
                    <Button x:Name="NavPreferencesButton"
                            Tag="9"
                            Style="{StaticResource NavButton}"
                            ToolTip="Configuracion"
                            Click="NavButton_Click" />
                    <Button x:Name="NavActivityButton"
                            Tag="10"
                            Style="{StaticResource NavButton}"
                            ToolTip="Actividad"
                            Click="NavButton_Click" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom"
                            HorizontalAlignment="Stretch">
                    <Rectangle Height="1"
                               Fill="#331A0B2E"
                               Margin="0,0,0,12" />
                    <Border BorderBrush="{DynamicResource ThemeBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="10"
                            Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="34"
                                    Height="34"
                                    CornerRadius="17"
                                    ClipToBounds="True"
                                    HorizontalAlignment="Left">
                                <Image x:Name="ChannelAvatarImage"
                                       Source="Assets/AppIcon.png"
                                       Stretch="UniformToFill" />
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="ChannelNameText"
                                           Text="Sin Twitch"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="ChannelLoginText"
                                           Text="Sin login"
                                           Style="{StaticResource MutedText}"
                                           FontSize="11"
                                           TextTrimming="CharacterEllipsis" />
