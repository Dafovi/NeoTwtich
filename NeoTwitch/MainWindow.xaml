                                                        <StackPanel Margin="0,10,0,0">
                                                            <TextBlock Text="Se muestran solo las opciones que usa el patron."
                                                                       Style="{StaticResource MutedText}"
                                                                       FontSize="12"
                                                                       Margin="0,0,0,10" />

                                                            <Separator x:Name="LightOptionsSeparator"
                                                                       Margin="0,0,0,12" />

                                                            <TextBlock x:Name="TargetPinsLabel"
                                                                       Text="Pines de salida"
                                                                       Style="{StaticResource MutedText}" />
                                                            <TextBox x:Name="TargetPinsBox"
                                                                     TextChanged="RuleFieldChanged"
                                                                     ToolTip="Dejalo vacio para usar todas las tiras. Ejemplo: 6, 7" />

                                                            <StackPanel x:Name="PatternGrid">
                                                                <TextBlock Text="Patron" Style="{StaticResource MutedText}" />
                                                                <ComboBox x:Name="PatternBox"
                                                                          Visibility="Collapsed"
                                                                          SelectionChanged="RuleFieldChanged" />
                                                                <Grid Margin="0,4,0,12">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="8" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="8" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="8" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="72" />
                                                                        <RowDefinition Height="8" />
                                                                        <RowDefinition Height="72" />
                                                                    </Grid.RowDefinitions>

                                                                    <Button x:Name="PatternSolidTileButton"
                                                                            Tag="Solid"
                                                                            Click="PatternTile_Click">
                                                                        <StackPanel HorizontalAlignment="Center">
                                                                            <Image Source="Assets/Icons/lights_fx_static.png"
                                                                                   Width="22"
                                                                                   Height="22"
                                                                                   Margin="0,0,0,6" />
                                                                            <TextBlock Text="Fijo"
                                                                                       FontSize="12"
                                                                                       FontWeight="SemiBold"
                                                                                       TextAlignment="Center" />
                                                                        </StackPanel>
                                                                    </Button>
                                                                    <Button x:Name="PatternPulseTileButton"
                                                                            Grid.Column="2"
                                                                            Tag="Pulse"
                                                                            Click="PatternTile_Click">
                                                                        <StackPanel HorizontalAlignment="Center">
                                                                            <Image Source="Assets/Icons/lights_fx_pulse.png"
                                                                                   Width="22"
                                                                                   Height="22"
                                                                                   Margin="0,0,0,6" />
                                                                            <TextBlock Text="Pulso"
                                                                                       FontSize="12"
                                                                                       FontWeight="SemiBold"
                                                                                       TextAlignment="Center" />
                                                                        </StackPanel>
                                                                    </Button>
                                                                    <Button x:Name="PatternRainbowTileButton"
                                                                            Grid.Column="4"
                                                                            Tag="Rainbow"
                                                                            Click="PatternTile_Click">
                                                                        <StackPanel HorizontalAlignment="Center">
                                                                            <Image Source="Assets/Icons/lights_fx_rainbow.png"
                                                                                   Width="22"
                                                                                   Height="22"
                                                                                   Margin="0,0,0,6" />
                                                                            <TextBlock Text="Arcoiris"
                                                                                       FontSize="12"
                                                                                       FontWeight="SemiBold"
                                                                                       TextAlignment="Center" />
                                                                        </StackPanel>
                                                                    </Button>
                                                                    <Button x:Name="PatternChaseTileButton"
                                                                            Grid.Column="6"
                                                                            Tag="Chase"
                                                                            Click="PatternTile_Click">
                                                                        <StackPanel HorizontalAlignment="Center">
                                                                            <Image Source="Assets/Icons/lights_fx_wave.png"
                                                                                   Width="22"
                                                                                   Height="22"
                                                                                   Margin="0,0,0,6" />
                                                                            <TextBlock Text="Carrera"
                                                                                       FontSize="12"
                                                                                       FontWeight="SemiBold"
                                                                                       TextAlignment="Center" />
                                                                        </StackPanel>
                                                                    </Button>
                                                                    <Button x:Name="PatternTheaterTileButton"
                                                                            Grid.Row="2"
                                                                            Tag="Theater"
                                                                            Click="PatternTile_Click">
                                                                        <StackPanel HorizontalAlignment="Center">
                                                                            <Image Source="Assets/Icons/lights_fx_breathe.png"
