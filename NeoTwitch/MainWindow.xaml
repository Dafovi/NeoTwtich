<Window x:Class="NeoTwitch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Neo Twitch"
        Icon="Assets/AppIcon.ico"
        Height="800"
        Width="1220"
        MinHeight="620"
        MinWidth="920"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Background="{DynamicResource ThemeWindowBrush}"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged">
    <Window.Resources>
        <SolidColorBrush x:Key="ThemeWindowBrush" Color="#F7F4FF" />
        <SolidColorBrush x:Key="ThemeSidebarBrush" Color="#8652F6" />
        <SolidColorBrush x:Key="ThemeSurfaceBrush" Color="#EFE8FF" />
        <SolidColorBrush x:Key="ThemeInputBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ThemeButtonBrush" Color="#F5F3FF" />
        <SolidColorBrush x:Key="ThemeBorderBrush" Color="#CDBBFF" />
        <SolidColorBrush x:Key="ThemeTextBrush" Color="#1F2330" />
        <SolidColorBrush x:Key="ThemeMutedTextBrush" Color="#6B647A" />
        <SolidColorBrush x:Key="ThemeSidebarTextBrush" Color="#1A0B2E" />
        <SolidColorBrush x:Key="ThemeSidebarMutedTextBrush" Color="#2E1855" />
        <SolidColorBrush x:Key="ThemeSelectionBrush" Color="#00A7A5" />
        <SolidColorBrush x:Key="ThemeConsoleBrush" Color="#171224" />
        <SolidColorBrush x:Key="ThemeScrollThumbBrush" Color="#8652F6" />
        <SolidColorBrush x:Key="ThemeScrollTrackBrush" Color="#1A0B2E20" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        </Style>

        <Style x:Key="TitleText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="MutedText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource ThemeMutedTextBrush}" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,4,0,10" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource ThemeInputBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Margin" Value="0,4,0,10" />
            <Setter Property="Background" Value="{DynamicResource ThemeInputBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          ClickMode="Press"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="1">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ComboFrame"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="4" />
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ComboFrame" Property="BorderBrush" Value="{DynamicResource ThemeSelectionBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="ComboFrame" Property="BorderBrush" Value="{DynamicResource ThemeSelectionBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Margin="10,0,34,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                            <TextBox x:Name="PART_EditableTextBox"
                                     Margin="8,0,34,0"
                                     VerticalAlignment="Center"
                                     Visibility="Hidden"
                                     Focusable="True"
                                     Background="{DynamicResource ThemeInputBrush}"
                                     Foreground="{DynamicResource ThemeTextBrush}"
                                     BorderThickness="0"
                                     IsReadOnly="{TemplateBinding IsReadOnly}" />
                            <Path Width="8"
                                  Height="5"
                                  Stretch="Fill"
                                  Fill="{DynamicResource ThemeTextBrush}"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  Margin="0,0,12,0"
                                  Data="M 0 0 L 4 4 L 8 0 Z" />
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Background="{DynamicResource ThemeInputBrush}"
                                        BorderBrush="{DynamicResource ThemeBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="260"
                                                  CanContentScroll="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden" />
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource ThemeInputBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ThemeSelectionBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ThemeSelectionBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemFrame"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="2">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemFrame" Property="Background" Value="{DynamicResource ThemeButtonBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemFrame" Property="Background" Value="{DynamicResource ThemeButtonBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{DynamicResource ThemeInputBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,4,8,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{DynamicResource ThemeButtonBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonFrame"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonFrame" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonFrame" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonFrame" Property="Opacity" Value="0.48" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#00A7A5" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#00A7A5" />
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#FFF0F1" />
            <Setter Property="Foreground" Value="#B42318" />
            <Setter Property="BorderBrush" Value="#F4A7A0" />
        </Style>

        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Margin" Value="0,4,0,4" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,5,18,5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource ThemeInputBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeMutedTextBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid MinHeight="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="CheckBoxFrame"
                                    Width="16"
                                    Height="16"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1.5"
                                    CornerRadius="3" />
                            <Path x:Name="CheckMark"
                                  Grid.Column="0"
                                  Data="M 3 8 L 7 12 L 13 4"
                                  Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Visibility="Collapsed" />
                            <ContentPresenter Grid.Column="1"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                                <Setter TargetName="CheckBoxFrame" Property="BorderBrush" Value="{DynamicResource ThemeSelectionBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Margin" Value="0,3,0,10" />
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="{DynamicResource ThemeScrollTrackBrush}" />
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="5" />
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                  Opacity="0" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb MinHeight="28" MinWidth="28">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{DynamicResource ThemeScrollThumbBrush}"
                                                        CornerRadius="5"
                                                        Opacity="0.82" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                  Opacity="0" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HiddenTabItem" TargetType="TabItem">
            <Setter Property="Width" Value="0" />
            <Setter Property="Height" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid Width="0" Height="0" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ActivityTemplate">
            <Grid Margin="0,2,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="68" />
                    <ColumnDefinition Width="86" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Rectangle Grid.Column="0"
                           Fill="{Binding AccentBrush}"
                           RadiusX="2"
                           RadiusY="2"
                           Margin="0,3,8,3" />
                <TextBlock Grid.Column="1"
                           Text="{Binding Time}"
                           FontFamily="Cascadia Mono, Consolas"
                           FontSize="12"
                           Foreground="{DynamicResource ThemeMutedTextBrush}"
                           VerticalAlignment="Top" />
                <TextBlock Grid.Column="2"
                           Text="{Binding Category}"
                           FontFamily="Cascadia Mono, Consolas"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{Binding AccentBrush}"
                           VerticalAlignment="Top" />
                <TextBlock Grid.Column="3"
                           Text="{Binding Message}"
                           FontFamily="Cascadia Mono, Consolas"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource ThemeTextBrush}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="MiniActivityTemplate">
            <Grid Margin="0,1,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="62" />
                    <ColumnDefinition Width="82" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Rectangle Grid.Column="0"
                           Fill="{Binding AccentBrush}"
                           RadiusX="2"
                           RadiusY="2"
                           Margin="0,3,8,3" />
                <TextBlock Grid.Column="1"
                           Text="{Binding Time}"
                           FontFamily="Cascadia Mono, Consolas"
                           FontSize="12"
                           Foreground="#AFA4CC"
                           VerticalAlignment="Top" />
                <TextBlock Grid.Column="2"
                           Text="{Binding Category}"
                           FontFamily="Cascadia Mono, Consolas"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{Binding AccentBrush}"
                           VerticalAlignment="Top" />
                <TextBlock Grid.Column="3"
                           Text="{Binding Message}"
                           FontFamily="Cascadia Mono, Consolas"
                           FontSize="12"
                           TextTrimming="CharacterEllipsis"
                           Foreground="White" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{DynamicResource ThemeWindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="166" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="224" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border x:Name="SidebarChrome"
                Grid.RowSpan="2"
                Grid.Column="0"
                Background="{DynamicResource ThemeSidebarBrush}"
                Padding="18">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top">
                    <Image Source="Assets/AppIcon.png"
                           Width="66"
                           Height="66"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10" />
                    <TextBlock Text="NeoTwitch"
                               FontSize="24"
                               Style="{StaticResource TitleText}"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource ThemeSidebarTextBrush}" />
                    <TextBlock Text="Arduino + stream"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource ThemeSidebarMutedTextBrush}"
                               Margin="0,2,0,18" />
                    <Rectangle Height="1"
                               Fill="#331A0B2E"
                               Margin="0,0,0,14" />

                    <Button x:Name="NavSettingsButton"
                            Content="Conexiones"
                            Tag="0"
                            Style="{StaticResource NavButton}"
                            Click="NavButton_Click" />
                    <Button x:Name="NavRulesButton"
                            Content="Reglas"
                            Tag="1"
                            Style="{StaticResource NavButton}"
                            Click="NavButton_Click" />
                    <Button x:Name="NavStripsButton"
                            Content="Luces de fondo"
                            Tag="2"
                            Style="{StaticResource NavButton}"
                            Click="NavButton_Click" />
                    <Button x:Name="NavPreferencesButton"
                            Content="Configuracion"
                            Tag="3"
                            Style="{StaticResource NavButton}"
                            ToolTip="Preferencias generales de la app"
                            Click="NavButton_Click" />
                    <Button x:Name="NavActivityButton"
                            Content="Actividad"
                            Tag="4"
                            Style="{StaticResource NavButton}"
                            Click="NavButton_Click" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <Rectangle Height="1"
                               Fill="#331A0B2E"
                               Margin="0,0,0,12" />
                    <TextBlock Text="Estado"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource ThemeSidebarTextBrush}"
                               Margin="0,0,0,8" />
                    <Border x:Name="SidebarTwitchStatusCard"
                            Background="#24FFFFFF"
                            BorderBrush="#3AFFFFFF"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10"
                            Margin="0,0,0,10">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="36"
                                        Height="36"
                                        CornerRadius="8"
                                        Background="#2BFFFFFF"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top">
                                    <Image x:Name="ChannelAvatarImage"
                                           Source="Assets/AppIcon.png"
                                           Stretch="UniformToFill" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Name="ChannelNameText"
                                               Text="Sin Twitch"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource ThemeSidebarTextBrush}" />
                                    <TextBlock x:Name="ChannelLoginText"
                                               Text="Sin login"
                                               FontSize="11"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource ThemeSidebarMutedTextBrush}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="TwitchConnectionText"
                                       Text="Sin conectar"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource ThemeSidebarTextBrush}" />
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,8,0,0">
                                <Ellipse x:Name="TwitchLiveDot"
                                         Width="10"
                                         Height="10"
                                         StrokeThickness="1.5"
                                         VerticalAlignment="Center"
                                         Margin="0,0,7,0" />
                                <TextBlock x:Name="TwitchLiveStateText"
                                           Text="No esta en directo"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource ThemeSidebarTextBrush}" />
                            </StackPanel>
                            <TextBlock x:Name="TwitchStatusText"
                                       Foreground="{DynamicResource ThemeSidebarMutedTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="SidebarArduinoStatusCard"
                            Background="#24FFFFFF"
                            BorderBrush="#3AFFFFFF"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10"
                            Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Arduino"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource ThemeSidebarTextBrush}" />
                            <TextBlock x:Name="ArduinoConnectionText"
                                       Text="Sin conectar"
                                       FontWeight="SemiBold"
                                       Margin="0,6,0,0"
                                       Foreground="{DynamicResource ThemeSidebarTextBrush}" />
                            <TextBlock x:Name="ArduinoStatusText"
                                       Foreground="{DynamicResource ThemeSidebarMutedTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="SidebarAlexaStatusCard"
                            Background="#24FFFFFF"
                            BorderBrush="#3AFFFFFF"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10"
                            Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Alexa"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource ThemeSidebarTextBrush}" />
                            <TextBlock x:Name="AlexaConnectionText"
                                       Text="Sin conectar"
                                       FontWeight="SemiBold"
                                       Margin="0,6,0,0"
                                       Foreground="{DynamicResource ThemeSidebarTextBrush}" />
                            <TextBlock x:Name="AlexaSidebarStatusText"
                                       Foreground="{DynamicResource ThemeSidebarMutedTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="VersionText"
                               Text="V0.0.0"
                               FontSize="11"
                               Foreground="{DynamicResource ThemeSidebarMutedTextBrush}"
                               HorizontalAlignment="Left"
                               Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <TabControl Grid.Row="0"
                    Grid.Column="1"
                    x:Name="MainTabs"
                    ItemContainerStyle="{StaticResource HiddenTabItem}"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    SelectionChanged="MainTabs_SelectionChanged">
            <TabItem Header="Conexiones">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                    <Grid Margin="24" MinWidth="780">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,18">
                            <TextBlock Text="Centro de control"
                                       FontSize="28"
                                       Style="{StaticResource TitleText}"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Conecta Twitch, Arduino y deja lista la app para el stream."
                                       Style="{StaticResource MutedText}"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <Border Grid.Row="1"
                                Grid.Column="0"
                                Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Twitch"
                                           FontSize="18"
                                           Style="{StaticResource TitleText}"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,10" />
                                <TextBlock Text="Client ID"
                                           Style="{StaticResource MutedText}" />
                                <Grid Margin="0,4,0,10">
                                    <TextBox x:Name="ClientIdBox"
                                             Margin="0"
                                             Padding="10,6,76,6"
                                             TextChanged="GlobalSettingsChanged" />
                                    <TextBlock x:Name="ClientIdMaskText"
                                               Margin="1,1,72,1"
                                               Padding="9,6"
                                               VerticalAlignment="Stretch"
                                               Background="{DynamicResource ThemeInputBrush}"
                                               Foreground="{DynamicResource ThemeMutedTextBrush}"
                                               Visibility="Collapsed" />
                                    <Button x:Name="ClientIdRevealButton"
                                            Content="Ver"
                                            Width="64"
                                            MinHeight="0"
                                            Padding="8,0"
                                            Margin="0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Stretch"
                                            ToolTip="Mostrar u ocultar Client ID"
                                            Click="ToggleClientIdVisibility_Click" />
                                </Grid>
                                <TextBlock Text="Client Secret opcional"
                                           Style="{StaticResource MutedText}" />
                                <Grid Margin="0,4,0,10">
                                    <TextBox x:Name="ClientSecretBox"
                                             Margin="0"
                                             Padding="10,6,76,6"
                                             TextChanged="GlobalSettingsChanged"
                                             ToolTip="Se usa para refrescar el token de Twitch. Si lo dejas vacio, la app puede pedir autorizar de nuevo cuando expire." />
                                    <TextBlock x:Name="ClientSecretMaskText"
                                               Margin="1,1,72,1"
                                               Padding="9,6"
                                               VerticalAlignment="Stretch"
                                               Background="{DynamicResource ThemeInputBrush}"
                                               Foreground="{DynamicResource ThemeMutedTextBrush}"
                                               Visibility="Collapsed" />
                                    <Button x:Name="ClientSecretRevealButton"
                                            Content="Ver"
                                            Width="64"
                                            MinHeight="0"
                                            Padding="8,0"
                                            Margin="0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Stretch"
                                            ToolTip="Mostrar u ocultar Client Secret"
                                            Click="ToggleClientSecretVisibility_Click" />
                                </Grid>
                                <Button x:Name="TwitchButton"
                                        Style="{StaticResource PrimaryButton}"
                                        Content="Conectar Twitch"
                                        Click="TwitchButton_Click" />
                                <Button Content="Abrir Twitch Console"
                                        Click="OpenTwitchConsoleButton_Click" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1"
                                Grid.Column="2"
                                Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Arduino"
                                           FontSize="18"
                                           Style="{StaticResource TitleText}"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,10" />
                                <TextBlock Text="Puerto COM del Arduino"
                                           Style="{StaticResource MutedText}" />
                                <ComboBox x:Name="PortComboBox"
                                          IsEditable="True"
                                          SelectionChanged="GlobalSettingsChanged"
                                          DropDownOpened="PortComboBox_DropDownOpened"
                                          ToolTip="Escoge el puerto que diga Arduino, CH340, CP210 o USB Serial." />
                                <WrapPanel>
                                    <Button Content="Detectar" Click="DetectPortsButton_Click" />
                                    <Button Content="Conectar" Click="ConnectArduinoButton_Click" />
                                </WrapPanel>
                                <TextBlock Text="Baudios"
                                           Style="{StaticResource MutedText}"
                                           Margin="0,8,0,0" />
                                <TextBox x:Name="BaudRateBox" TextChanged="GlobalSettingsChanged" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2"
                                Grid.ColumnSpan="3"
                                Style="{StaticResource Card}"
                                Margin="0,18,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="220" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Alexa"
                                               FontSize="18"
                                               Style="{StaticResource TitleText}"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,10" />
                                    <CheckBox x:Name="AlexaEnabledCheck"
                                              Content="Activar integracion con Alexa"
                                              Checked="AlexaSettingsChanged"
                                              Unchecked="AlexaSettingsChanged" />
                                    <TextBlock Text="URL de Skill / relay"
                                               Style="{StaticResource MutedText}" />
                                    <Grid Margin="0,4,0,10">
                                        <TextBox x:Name="AlexaRelayUrlBox"
                                                 Margin="0"
                                                 Padding="10,6,76,6"
                                                 TextChanged="AlexaSettingsChanged"
                                                 ToolTip="Endpoint HTTPS que recibe eventos de Neo Twitch y los envia a Alexa." />
                                        <TextBlock x:Name="AlexaRelayUrlMaskText"
                                                   Margin="1,1,72,1"
                                                   Padding="9,6"
                                                   VerticalAlignment="Stretch"
                                                   Background="{DynamicResource ThemeInputBrush}"
                                                   Foreground="{DynamicResource ThemeMutedTextBrush}"
                                                   Visibility="Collapsed" />
                                        <Button x:Name="AlexaRelayUrlRevealButton"
                                                Content="Ver"
                                                Width="64"
                                                MinHeight="0"
                                                Padding="8,0"
                                                Margin="0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Stretch"
                                                ToolTip="Mostrar u ocultar URL de Alexa"
                                                Click="ToggleAlexaRelayUrlVisibility_Click" />
                                    </Grid>
                                    <TextBlock Text="Token opcional"
                                               Style="{StaticResource MutedText}" />
                                    <Grid Margin="0,4,0,10">
                                        <TextBox x:Name="AlexaAuthTokenBox"
                                                 Margin="0"
                                                 Padding="10,6,76,6"
                                                 TextChanged="AlexaSettingsChanged"
                                                 ToolTip="Token/API key opcional para proteger el relay." />
                                        <TextBlock x:Name="AlexaAuthTokenMaskText"
                                                   Margin="1,1,72,1"
                                                   Padding="9,6"
                                                   VerticalAlignment="Stretch"
                                                   Background="{DynamicResource ThemeInputBrush}"
                                                   Foreground="{DynamicResource ThemeMutedTextBrush}"
                                                   Visibility="Collapsed" />
                                        <Button x:Name="AlexaAuthTokenRevealButton"
                                                Content="Ver"
                                                Width="64"
                                                MinHeight="0"
                                                Padding="8,0"
                                                Margin="0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Stretch"
                                                ToolTip="Mostrar u ocultar token de Alexa"
                                                Click="ToggleAlexaAuthTokenVisibility_Click" />
                                    </Grid>
                                    <TextBlock x:Name="AlexaStatusText"
                                               Style="{StaticResource MutedText}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="Probar Alexa"
                                        Style="{StaticResource PrimaryButton}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Click="TestAlexaButton_Click" />
                                <Button Grid.Column="1"
                                        Content="Abrir Alexa Console"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Margin="0,44,8,4"
                                        Click="OpenAlexaConsoleButton_Click" />
                            </Grid>
                        </Border>

                        <Border Grid.Row="3"
                                Grid.ColumnSpan="3"
                                Style="{StaticResource Card}"
                                Margin="0,18,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="220" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Conexion automatica"
                                               FontSize="18"
                                               Style="{StaticResource TitleText}"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,10" />
                                    <WrapPanel>
                                        <CheckBox x:Name="AutoTwitchCheck"
                                                  Content="Conectar Twitch al abrir"
                                                  Checked="GlobalSettingsChanged"
                                                  Unchecked="GlobalSettingsChanged" />
                                        <CheckBox x:Name="AutoArduinoCheck"
                                                  Content="Conectar Arduino al abrir"
                                                  Checked="GlobalSettingsChanged"
                                                  Unchecked="GlobalSettingsChanged" />
                                    </WrapPanel>
                                    <TextBlock Text="Estas opciones intentan conectar los servicios apenas abre Neo Twitch."
                                               Style="{StaticResource MutedText}"
                                               TextWrapping="Wrap"
                                               Margin="0,8,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="Guardar configuracion"
                                        Style="{StaticResource PrimaryButton}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Click="SaveButton_Click" />
                            </Grid>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Reglas">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                    <Grid Margin="24" MinWidth="840">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,18">
                            <TextBlock Text="Reglas de stream"
                                       FontSize="28"
                                       Style="{StaticResource TitleText}"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Elige que pasa con seguidores, subs, raids, bits y canjes."
                                       Style="{StaticResource MutedText}"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <Border Grid.Row="1"
                                Grid.Column="0"
                                Style="{StaticResource Card}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                                    <WrapPanel>
                                        <Button Content="Nueva" Click="AddRuleButton_Click" />
                                        <Button Content="Duplicar" Click="DuplicateRuleButton_Click" />
                                        <Button Content="Eliminar"
                                                Style="{StaticResource DangerButton}"
                                                Click="RemoveRuleButton_Click" />
                                    </WrapPanel>
                                    <Button Content="Probar regla"
                                            Style="{StaticResource PrimaryButton}"
                                            Click="TestRuleButton_Click" />
                                    <Button Content="Parar prueba"
                                            Style="{StaticResource DangerButton}"
                                            Click="StopTestButton_Click" />
                                </StackPanel>

                                <StackPanel DockPanel.Dock="Top">
                                    <TextBlock Text="Eventos"
                                               FontSize="18"
                                               Style="{StaticResource TitleText}"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,10" />
                                </StackPanel>

                                <ListBox x:Name="RulesList"
                                         BorderBrush="{DynamicResource ThemeBorderBrush}"
                                         SelectionChanged="RulesList_SelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="9" Margin="2,3" CornerRadius="7">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding DisplayLabel}"
                                                               Style="{StaticResource MutedText}"
                                                               FontSize="12"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>

                        <Border Grid.Row="1"
                                Grid.Column="2"
                                Style="{StaticResource Card}">
                            <StackPanel x:Name="RuleEditorPanel">
                                <TextBlock Text="Detalle de regla"
                                           FontSize="18"
                                           Style="{StaticResource TitleText}"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,12" />

                                <CheckBox x:Name="RuleEnabledCheck"
                                          Content="Regla activa"
                                          Checked="RuleFieldChanged"
                                          Unchecked="RuleFieldChanged" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Nombre" Style="{StaticResource MutedText}" />
                                        <TextBox x:Name="RuleNameBox" TextChanged="RuleFieldChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Evento" Style="{StaticResource MutedText}" />
                                        <ComboBox x:Name="EventKindBox"
                                                  SelectionChanged="RuleFieldChanged" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock x:Name="RewardTitleLabel"
                                           Text="Canje especifico"
                                           Style="{StaticResource MutedText}" />
                                <TextBox x:Name="RewardTitleBox"
                                         TextChanged="RuleFieldChanged"
                                         ToolTip="Dejalo vacio para aceptar cualquier canje personalizado." />

                                <TextBlock x:Name="ChatCommandLabel"
                                           Text="Comando de chat"
                                           Style="{StaticResource MutedText}" />
                                <TextBox x:Name="ChatCommandBox"
                                         TextChanged="RuleFieldChanged"
                                         ToolTip="Ejemplo: !baile. La regla se activa cuando el mensaje empieza con ese comando." />

                                <TextBlock x:Name="MinimumBitsLabel"
                                           Text="Bits minimos"
                                           Style="{StaticResource MutedText}" />
                                <TextBox x:Name="MinimumBitsBox"
                                         TextChanged="RuleFieldChanged"
                                         ToolTip="Para bits, usa el mayor umbral que sea menor o igual a la cantidad recibida." />

                                <StackPanel Orientation="Horizontal" Margin="0,2,0,10">
                                    <CheckBox x:Name="UseLightsCheck"
                                              Content="Activar luces"
                                              Checked="RuleFieldChanged"
                                              Unchecked="RuleFieldChanged" />
                                    <CheckBox x:Name="PlayAudioCheck"
                                              Content="Reproducir audio"
                                              Checked="RuleFieldChanged"
                                              Unchecked="RuleFieldChanged" />
                                </StackPanel>

                                <TextBlock x:Name="AudioLabel"
                                           Text="Audio"
                                           Style="{StaticResource MutedText}" />
                                <DockPanel x:Name="AudioPanel"
                                           LastChildFill="True"
                                           Margin="0,4,0,10">
                                    <Button DockPanel.Dock="Right"
                                            Content="Buscar"
                                            Margin="8,0,0,0"
                                            Click="BrowseAudioButton_Click" />
                                    <TextBox x:Name="AudioPathBox"
                                             IsReadOnly="True"
                                             Margin="0" />
                                </DockPanel>

                                <CheckBox x:Name="ChatMessageCheck"
                                          Content="Enviar mensaje al chat"
                                          Checked="RuleFieldChanged"
                                          Unchecked="RuleFieldChanged" />
                                <TextBlock x:Name="ChatMessageLabel"
                                           Text="Mensaje al chat"
                                           Style="{StaticResource MutedText}" />
                                <TextBox x:Name="ChatMessageBox"
                                         TextChanged="RuleFieldChanged"
                                         ToolTip="Variables: {user}, {bits}, {reward}, {viewers}, {message}, {event}" />

                                <CheckBox x:Name="AlexaEventCheck"
                                          Content="Enviar evento a Alexa"
                                          Checked="RuleFieldChanged"
                                          Unchecked="RuleFieldChanged" />
                                <TextBlock x:Name="AlexaRuleHintText"
                                           Text="Se enviara a Alexa el nombre de esta regla. Configuralo tambien en el relay/Lambda para que aparezca como evento de rutina."
                                           Style="{StaticResource MutedText}"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,10" />

                                <Separator x:Name="LightOptionsSeparator"
                                           Margin="0,8,0,16" />

                                <TextBlock x:Name="TargetPinsLabel"
                                           Text="Pines de salida"
                                           Style="{StaticResource MutedText}" />
                                <TextBox x:Name="TargetPinsBox"
                                         TextChanged="RuleFieldChanged"
                                         ToolTip="Dejalo vacio para usar todas las tiras. Ejemplo: 6, 7" />

                                <Grid x:Name="PatternGrid">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Patron" Style="{StaticResource MutedText}" />
                                        <ComboBox x:Name="PatternBox"
                                                  SelectionChanged="RuleFieldChanged" />
                                    </StackPanel>
                                    <StackPanel x:Name="PrimaryColorPanel"
                                                Grid.Column="2">
                                        <TextBlock Text="Color principal" Style="{StaticResource MutedText}" />
                                        <DockPanel LastChildFill="True" Margin="0,4,0,10">
                                            <Button x:Name="PrimaryColorButton"
                                                    DockPanel.Dock="Right"
                                                    Width="38"
                                                    Margin="8,0,0,0"
                                                    ToolTip="Escoger color"
                                                    Click="PrimaryColorButton_Click" />
                                            <TextBox x:Name="PrimaryColorBox"
                                                     Margin="0"
                                                     TextChanged="RuleFieldChanged" />
                                        </DockPanel>
                                    </StackPanel>
                                </Grid>

                                <TextBlock x:Name="SecondaryColorLabel"
                                           Text="Color secundario"
                                           Style="{StaticResource MutedText}" />
                                <DockPanel x:Name="SecondaryColorPanel"
                                           LastChildFill="True"
                                           Margin="0,4,0,12">
                                    <Button x:Name="SecondaryColorButton"
                                            DockPanel.Dock="Right"
                                            Width="38"
                                            Margin="8,0,0,0"
                                            ToolTip="Escoger color"
                                            Click="SecondaryColorButton_Click" />
                                    <TextBox x:Name="SecondaryColorBox"
                                             Margin="0"
                                             TextChanged="RuleFieldChanged" />
                                </DockPanel>

                                <TextBlock x:Name="TertiaryColorLabel"
                                           Text="Tercer color"
                                           Style="{StaticResource MutedText}" />
                                <DockPanel x:Name="TertiaryColorPanel"
                                           LastChildFill="True"
                                           Margin="0,4,0,12">
                                    <Button x:Name="TertiaryColorButton"
                                            DockPanel.Dock="Right"
                                            Width="38"
                                            Margin="8,0,0,0"
                                            ToolTip="Escoger color"
                                            Click="TertiaryColorButton_Click" />
                                    <TextBox x:Name="TertiaryColorBox"
                                             Margin="0"
                                             TextChanged="RuleFieldChanged" />
                                </DockPanel>

                                <Grid x:Name="BrightnessGrid">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="60" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Brillo" Style="{StaticResource MutedText}" />
                                    <TextBlock x:Name="BrightnessValueText"
                                               Grid.Column="1"
                                               HorizontalAlignment="Right"
                                               Style="{StaticResource MutedText}" />
                                </Grid>
                                <Slider x:Name="BrightnessSlider"
                                        Minimum="0"
                                        Maximum="255"
                                        TickFrequency="1"
                                        ValueChanged="RuleFieldChanged" />

                                <Grid x:Name="DurationGrid">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Duracion sin audio" Style="{StaticResource MutedText}" />
                                    <TextBlock x:Name="DurationValueText"
                                               Grid.Column="1"
                                               HorizontalAlignment="Right"
                                               Style="{StaticResource MutedText}" />
                                </Grid>
                                <Slider x:Name="DurationSlider"
                                        Minimum="250"
                                        Maximum="60000"
                                        TickFrequency="250"
                                        ValueChanged="RuleFieldChanged" />

                                <Grid x:Name="CycleGrid">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Delay entre pasos" Style="{StaticResource MutedText}" />
                                    <TextBlock x:Name="CycleValueText"
                                               Grid.Column="1"
                                               HorizontalAlignment="Right"
                                               Style="{StaticResource MutedText}" />
                                </Grid>
                                <Slider x:Name="CycleSlider"
                                        Minimum="10"
                                        Maximum="2000"
                                        TickFrequency="10"
                                        ValueChanged="RuleFieldChanged" />

                                <Grid x:Name="StepGrid">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Duracion del paso" Style="{StaticResource MutedText}" />
                                    <TextBlock x:Name="StepValueText"
                                               Grid.Column="1"
                                               HorizontalAlignment="Right"
                                               Style="{StaticResource MutedText}" />
                                </Grid>
                                <Slider x:Name="StepSlider"
                                        Minimum="10"
                                        Maximum="5000"
                                        TickFrequency="10"
                                        ValueChanged="RuleFieldChanged" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Luces de fondo">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                    <Grid Margin="24" MinWidth="840">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="330" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,18">
                            <TextBlock Text="Luces de fondo"
                                       FontSize="28"
                                       Style="{StaticResource TitleText}"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Define los pines, cantidad de LEDs y el fondo del stream."
                                       Style="{StaticResource MutedText}"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <Border Grid.Row="1"
                                Grid.Column="0"
                                Style="{StaticResource Card}">
                            <DockPanel>
                                <StackPanel x:Name="StripActionsPanel"
                                            DockPanel.Dock="Bottom"
                                            Margin="0,12,0,0">
                                    <WrapPanel>
                                        <Button Content="Nueva" Click="AddStripButton_Click" />
                                        <Button Content="Duplicar" Click="DuplicateStripButton_Click" />
                                        <Button Content="Eliminar"
                                                Style="{StaticResource DangerButton}"
                                                Click="RemoveStripButton_Click" />
                                    </WrapPanel>
                                </StackPanel>

                                <StackPanel DockPanel.Dock="Top">
                                    <TextBlock Text="Salidas"
                                               FontSize="18"
                                               Style="{StaticResource TitleText}"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,10" />
                                    <Button x:Name="ArduinoOutputButton"
                                            Content="Arduino Tira led ws2812b"
                                            HorizontalContentAlignment="Left"
                                            Margin="0,0,0,8"
                                            ToolTip="Configura las tiras NeoPixel conectadas al Arduino."
                                            Click="ArduinoOutputButton_Click" />
                                    <Button x:Name="AlexaOutputButton"
                                            Content="Alexa"
                                            HorizontalContentAlignment="Left"
                                            Margin="0,0,0,12"
                                            ToolTip="Configura el fondo que se envia al relay de Alexa."
                                            Click="AlexaOutputButton_Click" />
                                    <TextBlock x:Name="StripsListLabel"
                                               Text="Tiras LED"
                                               Style="{StaticResource MutedText}"
                                               Margin="0,0,0,6" />
                                </StackPanel>

                                <ListBox x:Name="StripsList"
                                         BorderBrush="{DynamicResource ThemeBorderBrush}"
                                         MinHeight="220"
                                         SelectionChanged="StripsList_SelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="9" Margin="2,3" CornerRadius="7">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding DisplayLabel}"
                                                               Style="{StaticResource MutedText}"
                                                               FontSize="12"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>

                        <Border Grid.Row="1"
                                Grid.Column="2"
                                Style="{StaticResource Card}">
                            <Grid>
                                <StackPanel x:Name="ArduinoBackgroundPanel">
                                    <StackPanel x:Name="StripEditorPanel">
                                        <TextBlock Text="Detalle de tira"
                                                   FontSize="18"
                                                   Style="{StaticResource TitleText}"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,12" />

                                        <TextBlock Text="Nombre" Style="{StaticResource MutedText}" />
                                        <TextBox x:Name="StripNameBox" TextChanged="StripFieldChanged" />

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Pin Arduino" Style="{StaticResource MutedText}" />
                                                <TextBox x:Name="StripPinBox"
                                                         TextChanged="StripFieldChanged"
                                                         ToolTip="Pin digital donde esta conectado DIN de la tira." />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Cantidad de LEDs" Style="{StaticResource MutedText}" />
                                                <TextBox x:Name="StripLedCountBox" TextChanged="StripFieldChanged" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>

                                <Separator Margin="0,16,0,16" />

                                <TextBlock Text="Fondo"
                                           FontSize="18"
                                           Style="{StaticResource TitleText}"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,12" />
                                <CheckBox x:Name="BackgroundEnabledCheck"
                                          Content="Mantener luces de fondo"
                                          Checked="BackgroundFieldChanged"
                                          Unchecked="BackgroundFieldChanged" />

                                <TextBlock x:Name="BackgroundPinsLabel"
                                           Text="Pines de fondo"
                                           Style="{StaticResource MutedText}" />
                                <TextBox x:Name="BackgroundPinsBox"
                                         TextChanged="BackgroundFieldChanged"
                                         ToolTip="Dejalo vacio para usar todas las tiras." />

                                <Grid x:Name="BackgroundPatternGrid">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Patron de fondo" Style="{StaticResource MutedText}" />
                                        <ComboBox x:Name="BackgroundPatternBox"
                                                  SelectionChanged="BackgroundFieldChanged" />
                                    </StackPanel>
                                    <StackPanel x:Name="BackgroundBrightnessPanel"
                                                Grid.Column="2">
                                        <TextBlock Text="Brillo de fondo" Style="{StaticResource MutedText}" />
                                        <TextBlock x:Name="BackgroundBrightnessValueText"
                                                   HorizontalAlignment="Right"
                                                   Style="{StaticResource MutedText}" />
                                        <Slider x:Name="BackgroundBrightnessSlider"
                                                Minimum="0"
                                                Maximum="255"
                                                TickFrequency="1"
                                                ValueChanged="BackgroundFieldChanged" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock x:Name="BackgroundPrimaryColorLabel"
                                           Text="Color principal de fondo"
                                           Style="{StaticResource MutedText}" />
                                <DockPanel x:Name="BackgroundPrimaryColorPanel"
                                           LastChildFill="True"
                                           Margin="0,4,0,12">
                                    <Button x:Name="BackgroundPrimaryColorButton"
                                            DockPanel.Dock="Right"
                                            Width="38"
                                            Margin="8,0,0,0"
                                            ToolTip="Escoger color"
                                            Click="BackgroundPrimaryColorButton_Click" />
                                    <TextBox x:Name="BackgroundPrimaryColorBox"
                                             Margin="0"
                                             TextChanged="BackgroundFieldChanged" />
                                </DockPanel>

                                <TextBlock x:Name="BackgroundSecondaryColorLabel"
                                           Text="Color secundario de fondo"
                                           Style="{StaticResource MutedText}" />
                                <DockPanel x:Name="BackgroundSecondaryColorPanel"
                                           LastChildFill="True"
                                           Margin="0,4,0,12">
                                    <Button x:Name="BackgroundSecondaryColorButton"
                                            DockPanel.Dock="Right"
                                            Width="38"
                                            Margin="8,0,0,0"
                                            ToolTip="Escoger color"
                                            Click="BackgroundSecondaryColorButton_Click" />
                                    <TextBox x:Name="BackgroundSecondaryColorBox"
                                             Margin="0"
                                             TextChanged="BackgroundFieldChanged" />
                                </DockPanel>

                                <TextBlock x:Name="BackgroundTertiaryColorLabel"
                                           Text="Tercer color de fondo"
                                           Style="{StaticResource MutedText}" />
                                <DockPanel x:Name="BackgroundTertiaryColorPanel"
                                           LastChildFill="True"
                                           Margin="0,4,0,12">
                                    <Button x:Name="BackgroundTertiaryColorButton"
                                            DockPanel.Dock="Right"
                                            Width="38"
                                            Margin="8,0,0,0"
                                            ToolTip="Escoger color"
                                            Click="BackgroundTertiaryColorButton_Click" />
                                    <TextBox x:Name="BackgroundTertiaryColorBox"
                                             Margin="0"
                                             TextChanged="BackgroundFieldChanged" />
                                </DockPanel>

                                <Grid x:Name="BackgroundCycleGrid">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Delay de fondo" Style="{StaticResource MutedText}" />
                                    <TextBlock x:Name="BackgroundCycleValueText"
                                               Grid.Column="1"
                                               HorizontalAlignment="Right"
                                               Style="{StaticResource MutedText}" />
                                </Grid>
                                <Slider x:Name="BackgroundCycleSlider"
                                        Minimum="10"
                                        Maximum="2000"
                                        TickFrequency="10"
                                        ValueChanged="BackgroundFieldChanged" />

                                <Grid x:Name="BackgroundStepGrid">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Duracion del paso de fondo" Style="{StaticResource MutedText}" />
                                    <TextBlock x:Name="BackgroundStepValueText"
                                               Grid.Column="1"
                                               HorizontalAlignment="Right"
                                               Style="{StaticResource MutedText}" />
                                </Grid>
                                <Slider x:Name="BackgroundStepSlider"
                                        Minimum="10"
                                        Maximum="5000"
                                        TickFrequency="10"
                                        ValueChanged="BackgroundFieldChanged" />

                                <WrapPanel Margin="0,8,0,0">
                                    <Button x:Name="ApplyArduinoBackgroundButton"
                                            Content="Aplicar fondo LED"
                                            Style="{StaticResource PrimaryButton}"
                                            Click="ApplyArduinoBackgroundButton_Click" />
                                    <Button Content="Apagar tiras"
                                            Style="{StaticResource DangerButton}"
                                            Click="StopArduinoBackgroundButton_Click" />
                                </WrapPanel>
                                </StackPanel>

                                <StackPanel x:Name="AlexaBackgroundPanel"
                                            Visibility="Collapsed">
                                    <TextBlock Text="Fondo Alexa"
                                               FontSize="18"
                                               Style="{StaticResource TitleText}"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,12" />
                                    <TextBlock Text="Esta salida envia eventos al relay de Alexa para controlar rutinas o dispositivos configurados en tu skill."
                                               Style="{StaticResource MutedText}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,12" />
                                    <TextBlock x:Name="AlexaBackgroundUnavailableText"
                                               Text="Primero activa y configura Alexa en Conexiones para usar este fondo."
                                               Style="{StaticResource MutedText}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,12" />
                                    <CheckBox x:Name="BackgroundAlexaEnabledCheck"
                                              Content="Mantener fondo Alexa encendido"
                                              Checked="BackgroundFieldChanged"
                                              Unchecked="BackgroundFieldChanged" />
                                    <CheckBox x:Name="BackgroundAlexaTurnOffAfterEventCheck"
                                              Content="Apagar fondo Alexa al finalizar evento"
                                              Checked="BackgroundFieldChanged"
                                              Unchecked="BackgroundFieldChanged" />

                                    <Grid x:Name="BackgroundAlexaEventsGrid">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Evento Alexa encendido"
                                                       Style="{StaticResource MutedText}" />
                                            <TextBox x:Name="BackgroundAlexaOnEventBox"
                                                     TextChanged="BackgroundFieldChanged"
                                                     ToolTip="Evento que recibira el relay cuando el fondo Alexa debe quedar encendido." />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Evento Alexa apagado"
                                                       Style="{StaticResource MutedText}" />
                                            <TextBox x:Name="BackgroundAlexaOffEventBox"
                                                     TextChanged="BackgroundFieldChanged"
                                                     ToolTip="Evento que recibira el relay cuando el fondo Alexa debe quedar apagado." />
                                        </StackPanel>
                                    </Grid>

                                    <WrapPanel Margin="0,8,0,0">
                                        <Button x:Name="ApplyAlexaBackgroundButton"
                                                Content="Aplicar fondo Alexa"
                                                Style="{StaticResource PrimaryButton}"
                                                Click="ApplyAlexaBackgroundButton_Click" />
                                        <Button Content="Apagar fondo Alexa"
                                                x:Name="StopAlexaBackgroundButton"
                                                Style="{StaticResource DangerButton}"
                                                Click="StopAlexaBackgroundButton_Click" />
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Configuracion">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                    <Grid Margin="24" MinWidth="780">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,18">
                            <TextBlock Text="Configuracion"
                                       FontSize="28"
                                       Style="{StaticResource TitleText}"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Ajusta el comportamiento general, audio y cola de alertas."
                                       Style="{StaticResource MutedText}"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <Border Grid.Row="1"
                                Grid.Column="0"
                                Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Ventana y apariencia"
                                           FontSize="18"
                                           Style="{StaticResource TitleText}"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,10" />
                                <CheckBox x:Name="StartHiddenCheck"
                                          Content="Abrir minimizada"
                                          Checked="GlobalSettingsChanged"
                                          Unchecked="GlobalSettingsChanged" />
                                <CheckBox x:Name="CloseToTrayCheck"
                                          Content="Cerrar con X envia a segundo plano"
                                          Checked="GlobalSettingsChanged"
                                          Unchecked="GlobalSettingsChanged" />
                                <CheckBox x:Name="DarkModeCheck"
                                          Content="Modo oscuro"
                                          Checked="ThemeModeChanged"
                                          Unchecked="ThemeModeChanged" />
                                <TextBlock x:Name="SettingsPathText"
                                           Style="{StaticResource MutedText}"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1"
                                Grid.Column="2"
                                Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Audio"
                                           FontSize="18"
                                           Style="{StaticResource TitleText}"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,10" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="70" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Volumen de alertas" Style="{StaticResource MutedText}" />
                                    <TextBlock x:Name="AlertVolumeValueText"
                                               Grid.Column="1"
                                               HorizontalAlignment="Right"
                                               Style="{StaticResource MutedText}" />
                                </Grid>
                                <Slider x:Name="AlertVolumeSlider"
                                        Minimum="0"
                                        Maximum="100"
                                        TickFrequency="1"
                                        ValueChanged="GlobalSettingsChanged" />
                                <TextBlock Text="Este volumen se aplica a todos los audios reproducidos por las reglas."
                                           Style="{StaticResource MutedText}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2"
                                Grid.ColumnSpan="3"
                                Style="{StaticResource Card}"
                                Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="Cola de alertas"
                                           FontSize="18"
                                           Style="{StaticResource TitleText}"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,10" />
                                <TextBlock Text="Controla cuantas alertas se acumulan cuando Twitch manda muchas seguidas."
                                           Style="{StaticResource MutedText}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,12" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="Repetidas maximas en cola"
                                                   Style="{StaticResource MutedText}" />
                                        <TextBox x:Name="MaxQueuedSameRuleAlertsBox"
                                                 TextChanged="GlobalSettingsChanged"
                                                 ToolTip="Cuantas alertas de la misma regla pueden esperar mientras otra se reproduce. 1 es el valor recomendado." />

                                        <TextBlock Text="Tiempo minimo para repetir"
                                                   Style="{StaticResource MutedText}" />
                                        <TextBox x:Name="SameRuleQueueCooldownBox"
                                                 TextChanged="GlobalSettingsChanged"
                                                 ToolTip="Milisegundos desde que empezo una regla antes de permitir otra igual. Usa 0 para desactivar este filtro." />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Distintas maximas en cola"
                                                   Style="{StaticResource MutedText}" />
                                        <TextBox x:Name="MaxQueuedDifferentRuleAlertsBox"
                                                 TextChanged="GlobalSettingsChanged"
                                                 ToolTip="Cuantas alertas de reglas distintas pueden esperar mientras otra se reproduce." />

                                        <TextBlock Text="Tiempo minimo para distintas"
                                                   Style="{StaticResource MutedText}" />
                                        <TextBox x:Name="DifferentRuleQueueCooldownBox"
                                                 TextChanged="GlobalSettingsChanged"
                                                 ToolTip="Milisegundos desde que empezo una regla antes de permitir otra distinta. Usa 0 para desactivar este filtro." />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Actividad">
                <Grid Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="0,0,0,18">
                        <TextBlock Text="Actividad"
                                   FontSize="28"
                                   Style="{StaticResource TitleText}"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Historial completo de conexiones, eventos, pruebas y avisos."
                                   Style="{StaticResource MutedText}"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <Border Grid.Row="1"
                            Style="{StaticResource Card}">
                        <DockPanel>
                            <Button DockPanel.Dock="Top"
                                    HorizontalAlignment="Left"
                                    Content="Limpiar actividad"
                                    Click="ClearLogButton_Click" />
                            <ListBox x:Name="ActivityList"
                                     BorderBrush="{DynamicResource ThemeBorderBrush}"
                                     ItemTemplate="{StaticResource ActivityTemplate}" />
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <Border x:Name="MiniConsolePanel"
                Grid.Row="1"
                Grid.Column="1"
                Background="{DynamicResource ThemeConsoleBrush}"
                BorderBrush="{DynamicResource ThemeBorderBrush}"
                BorderThickness="1,1,0,0"
                Padding="14,10">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Consola en vivo"
                                   Foreground="White"
                                   FontWeight="SemiBold"
                                   Margin="0,0,10,0" />
                        <TextBlock Text="importante / twitch / alexa / evento / sistema"
                                   Foreground="#AFA4CC"
                                   FontSize="12" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="Limpiar"
                            MinHeight="26"
                            Padding="10,3"
                            Margin="8,0,0,0"
                            Click="ClearLogButton_Click" />
                </Grid>

                <ListBox x:Name="MiniActivityList"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemTemplate="{StaticResource MiniActivityTemplate}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
