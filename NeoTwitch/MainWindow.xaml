<Window x:Class="NeoTwitch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:NeoTwitch.Views"
        Title="Neo Twitch"
        Icon="Assets/AppIcon.ico"
        WindowStyle="None"
        ResizeMode="CanResize"
        Height="800"
        Width="1220"
        MinHeight="620"
        MinWidth="920"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Background="{DynamicResource ThemeWindowBrush}"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged">
    <Grid Background="{DynamicResource ThemeWindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="214" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border x:Name="TitleBarChrome"
                Grid.Row="0"
                Grid.ColumnSpan="2"
                Background="{DynamicResource ThemeSidebarBrush}"
                BorderBrush="{DynamicResource ThemeBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="14,0,10,0"
                MouseLeftButtonDown="CustomTitleDragArea_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Image Source="Assets/AppIcon.png"
                           Width="26"
                           Height="26"
                           Margin="0,0,10,0" />
                    <TextBlock Text="Neo Twitch"
                               Style="{StaticResource TitleText}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>
                <Button x:Name="TopProfileButton"
                        Grid.Column="1"
                        Padding="12,5"
                        Margin="0,0,12,0"
                        MinHeight="28"
                        VerticalAlignment="Center"
                        ToolTip="Abrir perfil de Twitch"
                        Click="OpenTwitchProfileButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="Assets/Icons/service_twitch.png"
                               Width="14"
                               Height="14"
                               Margin="0,0,7,0"
                               VerticalAlignment="Center" />
                        <TextBlock x:Name="TopProfileText"
                                   Text="Perfil"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button x:Name="MinimizeWindowButton"
                            Width="38"
                            MinHeight="30"
                            Padding="0"
                            Margin="0"
                            ToolTip="Minimizar"
                            Click="MinimizeWindowButton_Click">
                        <Path Width="12"
                              Height="12"
                              Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.7"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Data="M 1 6 L 11 6" />
                    </Button>
                    <Button x:Name="MaximizeWindowButton"
                            Width="38"
                            MinHeight="30"
                            Padding="0"
                            Margin="0"
                            ToolTip="Maximizar o restaurar"
                            Click="MaximizeWindowButton_Click">
                        <Path Width="12"
                              Height="12"
                              Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.5"
                              StrokeLineJoin="Round"
                              Data="M 2 2 H 10 V 10 H 2 Z" />
                    </Button>
                    <Button x:Name="CloseWindowButton"
                            Width="38"
                            MinHeight="30"
                            Padding="0"
                            Margin="0"
                            ToolTip="Cerrar"
                            Click="CloseWindowButton_Click">
                        <Path Width="12"
                              Height="12"
                              Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.7"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Data="M 2 2 L 10 10 M 10 2 L 2 10" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="SidebarChrome"
                Grid.Row="1"
                Grid.Column="0"
                Background="{DynamicResource ThemeSidebarBrush}"
                Padding="10">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Top"
                            HorizontalAlignment="Stretch"
                            Margin="0,8,0,0">
                    <Rectangle Height="1"
                               Fill="#331A0B2E"
                               Margin="0,0,0,12" />

                    <Button x:Name="NavSettingsButton"
                            Tag="0"
                            Style="{StaticResource NavButton}"
                            ToolTip="Panel principal"
                            Click="NavButton_Click" />
                    <Button x:Name="NavConnectionsButton"
                            Tag="1"
                            Style="{StaticResource NavButton}"
                            ToolTip="Conexiones"
                            Click="NavButton_Click" />
                    <Button x:Name="NavRulesButton"
                            Tag="2"
                            Style="{StaticResource NavButton}"
                            ToolTip="Alertas"
                            Click="NavButton_Click" />
                    <Button x:Name="NavStripsButton"
                            Tag="3"
                            Style="{StaticResource NavButton}"
                            ToolTip="Luces de fondo"
                            Click="NavButton_Click" />
                    <Button x:Name="NavAlexaButton"
                            Tag="4"
                            Style="{StaticResource NavButton}"
                            ToolTip="Alexa"
                            Click="NavButton_Click" />
                    <Button x:Name="NavAudioButton"
                            Tag="5"
                            Style="{StaticResource NavButton}"
                            ToolTip="Audio"
                            Click="NavButton_Click" />
                    <Button x:Name="NavImagesButton"
                            Tag="6"
                            Style="{StaticResource NavButton}"
                            ToolTip="Imagenes"
                            Click="NavButton_Click" />
                    <Button x:Name="NavVideosButton"
                            Tag="7"
                            Style="{StaticResource NavButton}"
                            ToolTip="Videos"
                            Click="NavButton_Click" />
                    <Button x:Name="NavObsButton"
                            Tag="8"
                            Style="{StaticResource NavButton}"
                            ToolTip="OBS"
                            Click="NavButton_Click" />
                    <Button x:Name="NavPreferencesButton"
                            Tag="9"
                            Style="{StaticResource NavButton}"
                            ToolTip="Configuracion"
                            Click="NavButton_Click" />
                    <Button x:Name="NavActivityButton"
                            Tag="10"
                            Style="{StaticResource NavButton}"
                            ToolTip="Actividad"
                            Click="NavButton_Click" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom"
                            HorizontalAlignment="Stretch">
                    <Rectangle Height="1"
                               Fill="#331A0B2E"
                               Margin="0,0,0,12" />
                    <Border BorderBrush="{DynamicResource ThemeBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="10"
                            Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="34"
                                    Height="34"
                                    CornerRadius="17"
                                    ClipToBounds="True"
                                    HorizontalAlignment="Left">
                                <Image x:Name="ChannelAvatarImage"
                                       Source="Assets/AppIcon.png"
                                       Stretch="UniformToFill" />
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="ChannelNameText"
                                           Text="Sin Twitch"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="ChannelLoginText"
                                           Text="Sin login"
                                           Style="{StaticResource MutedText}"
                                           FontSize="11"
                                           TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                    <Ellipse x:Name="TwitchLiveDot"
                                             Width="9"
                                             Height="9"
                                             StrokeThickness="1.5"
                                             Margin="0,2,6,0"
                                             ToolTip="Estado del directo" />
                                    <TextBlock x:Name="TwitchLiveStateText"
                                               Text="No esta en directo"
                                               FontSize="11" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Grid Visibility="Collapsed">
                        <TextBlock x:Name="TwitchConnectionText" Text="Sin conectar" />
                        <TextBlock x:Name="TwitchStatusText" />
                        <TextBlock x:Name="ArduinoConnectionText" Text="Sin conectar" />
                        <TextBlock x:Name="ArduinoStatusText" />
                        <TextBlock x:Name="AlexaConnectionText" Text="Sin conectar" />
                        <TextBlock x:Name="AlexaSidebarStatusText" />
                    </Grid>
                    <TextBlock x:Name="VersionText"
                               Text="V0.0.0"
                               FontSize="11"
                               Foreground="{DynamicResource ThemeSidebarMutedTextBrush}"
                               HorizontalAlignment="Left"
                               Margin="4,0,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <TabControl Grid.Row="1"
                    Grid.Column="1"
                    x:Name="MainTabs"
                    ItemContainerStyle="{StaticResource HiddenTabItem}"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    SelectionChanged="MainTabs_SelectionChanged">
            <TabItem Header="Panel">
                <views:DashboardView x:Name="DashboardView" />
            </TabItem>

            <TabItem Header="Conexiones">
                <views:ConnectionsView x:Name="ConnectionsView" />
            </TabItem>

            <TabItem Header="Alertas">
                <views:AlertsView x:Name="AlertsView" />
            </TabItem>

            <TabItem Header="Luces de fondo">
                <views:LightsView x:Name="LightsView" />
            </TabItem>

            <TabItem Header="Alexa">
                <views:AlexaView x:Name="AlexaView" />
            </TabItem>

            <TabItem Header="Audio">
                <views:AudioView x:Name="AudioView" />
            </TabItem>

            <TabItem Header="Imagenes">
                <views:ImagesView x:Name="ImagesView" />
            </TabItem>

            <TabItem Header="Videos">
                <views:VideosView x:Name="VideosView" />
            </TabItem>

            <TabItem Header="OBS">
                <views:ObsView x:Name="ObsView" />
            </TabItem>

            <TabItem Header="Configuracion">
                <views:SettingsView x:Name="SettingsView" />
            </TabItem>

            <TabItem Header="Actividad">
                <views:ActivityView x:Name="ActivityView" />
            </TabItem>
        </TabControl>

    </Grid>
</Window>
