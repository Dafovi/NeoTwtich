                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="42" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Image Source="Assets/Icons/nav_lights.png"
                                                               Width="26"
                                                               Height="26"
                                                               Stretch="Uniform" />
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="Luces"
                                                                       FontWeight="SemiBold" />
                                                            <TextBlock Text="Efectos y colores dinamicos."
                                                                       Style="{StaticResource MutedText}"
                                                                       FontSize="12" />
                                                        </StackPanel>
                                                        <CheckBox x:Name="UseLightsCheck"
                                                                  Grid.Column="2"
                                                                  Content=""
