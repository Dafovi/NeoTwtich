                                                <Border Width="34"
                                                        Height="34"
                                                        Background="#37C7F3"
                                                        Tag="StaticBrush">
                                                    <Border.OpacityMask>
                                                        <ImageBrush ImageSource="Assets/Icons/media_image.png"
                                                                    Stretch="Uniform" />
                                                    </Border.OpacityMask>
                                                </Border>
                                                <TextBlock Text="Seleccionar archivo de imagen"
                                                           Style="{StaticResource MutedText}"
                                                           Margin="0,8,0,0" />
                                            </StackPanel>
                                        </Button>
                                        <TextBlock Text="Archivo"
                                                   Style="{StaticResource MutedText}" />
                                        <TextBox x:Name="NewImagePathBox"
                                                 IsReadOnly="True" />
                                        <TextBlock Text="Nombre de la imagen"
                                                   Style="{StaticResource MutedText}"
                                                   Margin="0,8,0,0" />
                                        <TextBox x:Name="NewImageNameBox" />
                                        <TextBlock Text="Grupo"
                                                   Style="{StaticResource MutedText}"
                                                   Margin="0,8,0,0" />
                                        <ComboBox x:Name="NewImageGroupBox" />
