                                                <TextBox x:Name="StripPinBox"
                                                         TextChanged="StripFieldChanged"
                                                         ToolTip="Pin digital donde esta conectado DIN de la tira." />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Cantidad de LEDs" Style="{StaticResource MutedText}" />
                                                <TextBox x:Name="StripLedCountBox" TextChanged="StripFieldChanged" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>

                                <Separator Margin="0,16,0,16" />

                                <TextBlock Text="Fondo"
                                           FontSize="18"
                                           Style="{StaticResource TitleText}"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,12" />
                                <CheckBox x:Name="BackgroundEnabledCheck"
                                          Content="Mantener luces de fondo"
                                          Checked="BackgroundFieldChanged"
                                          Unchecked="BackgroundFieldChanged" />

                                <TextBlock x:Name="BackgroundPinsLabel"
                                           Text="Pines de fondo"
                                           Style="{StaticResource MutedText}"
                                           Visibility="Collapsed" />
                                <TextBox x:Name="BackgroundPinsBox"
                                         TextChanged="BackgroundFieldChanged"
                                         ToolTip="Dejalo vacio para usar todas las tiras."
                                         Visibility="Collapsed" />

                                <StackPanel x:Name="BackgroundPatternGrid">
                                    <StackPanel>
                                        <TextBlock Text="Patron de fondo" Style="{StaticResource MutedText}" />
                                        <ComboBox x:Name="BackgroundPatternBox"
                                                  Visibility="Collapsed"
                                                  SelectionChanged="BackgroundFieldChanged" />
                                        <Grid Margin="0,4,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="70" />
                                                <RowDefinition Height="8" />
                                                <RowDefinition Height="70" />
                                                <RowDefinition Height="8" />
                                                <RowDefinition Height="70" />
                                            </Grid.RowDefinitions>

                                            <Button x:Name="BackgroundPatternSolidTileButton"
                                                    Tag="Solid"
                                                    Click="BackgroundPatternTile_Click">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <Image Source="Assets/Icons/lights_fx_static.png" Width="22" Height="22" Margin="0,0,0,6" />
                                                    <TextBlock Text="Fijo" FontSize="12" FontWeight="SemiBold" TextAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="BackgroundPatternPulseTileButton"
                                                    Grid.Column="2"
                                                    Tag="Pulse"
                                                    Click="BackgroundPatternTile_Click">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <Image Source="Assets/Icons/lights_fx_pulse.png" Width="22" Height="22" Margin="0,0,0,6" />
                                                    <TextBlock Text="Pulso" FontSize="12" FontWeight="SemiBold" TextAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="BackgroundPatternRainbowTileButton"
                                                    Grid.Column="4"
                                                    Tag="Rainbow"
                                                    Click="BackgroundPatternTile_Click">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <Image Source="Assets/Icons/lights_fx_rainbow.png" Width="22" Height="22" Margin="0,0,0,6" />
                                                    <TextBlock Text="Arcoiris" FontSize="12" FontWeight="SemiBold" TextAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="BackgroundPatternChaseTileButton"
                                                    Grid.Row="2"
                                                    Tag="Chase"
                                                    Click="BackgroundPatternTile_Click">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <Image Source="Assets/Icons/lights_fx_wave.png" Width="22" Height="22" Margin="0,0,0,6" />
                                                    <TextBlock Text="Carrera" FontSize="12" FontWeight="SemiBold" TextAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="BackgroundPatternTheaterTileButton"
                                                    Grid.Row="2"
                                                    Grid.Column="2"
                                                    Tag="Theater"
                                                    Click="BackgroundPatternTile_Click">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <Image Source="Assets/Icons/lights_fx_breathe.png" Width="22" Height="22" Margin="0,0,0,6" />
                                                    <TextBlock Text="Teatro" FontSize="12" FontWeight="SemiBold" TextAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="BackgroundPatternSparkleTileButton"
                                                    Grid.Row="2"
                                                    Grid.Column="4"
                                                    Tag="Sparkle"
                                                    Click="BackgroundPatternTile_Click">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <Image Source="Assets/Icons/activity_notification_lime.png" Width="22" Height="22" Margin="0,0,0,6" />
                                                    <TextBlock Text="Destellos" FontSize="12" FontWeight="SemiBold" TextAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="BackgroundPatternRaveTileButton"
                                                    Grid.Row="4"
                                                    Grid.ColumnSpan="5"
                                                    Tag="Rave"
                                                    Click="BackgroundPatternTile_Click">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <Image Source="Assets/Icons/lights_fx_rave.png" Width="22" Height="22" Margin="0,0,0,6" />
                                                    <TextBlock Text="Rave" FontSize="12" FontWeight="SemiBold" TextAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel x:Name="BackgroundBrightnessPanel"
                                                Margin="0,2,0,0">
                                        <TextBlock Text="Brillo de fondo" Style="{StaticResource MutedText}" />
                                        <TextBlock x:Name="BackgroundBrightnessValueText"
                                                   HorizontalAlignment="Right"
                                                   Style="{StaticResource MutedText}" />
                                        <Slider x:Name="BackgroundBrightnessSlider"
                                                Minimum="0"
                                                Maximum="255"
                                                TickFrequency="1"
                                                ValueChanged="BackgroundFieldChanged" />
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock x:Name="BackgroundPrimaryColorLabel"
                                           Text="Color principal de fondo"
                                           Style="{StaticResource MutedText}" />
                                <DockPanel x:Name="BackgroundPrimaryColorPanel"
                                           LastChildFill="True"
                                           Margin="0,4,0,12">
                                    <Button x:Name="BackgroundPrimaryColorButton"
                                            DockPanel.Dock="Right"
                                            Width="38"
                                            Margin="8,0,0,0"
                                            ToolTip="Escoger color"
                                            Click="BackgroundPrimaryColorButton_Click" />
                                    <TextBox x:Name="BackgroundPrimaryColorBox"
                                             Margin="0"
                                             TextChanged="BackgroundFieldChanged" />
                                </DockPanel>

                                <TextBlock x:Name="BackgroundSecondaryColorLabel"
                                           Text="Color secundario de fondo"
                                           Style="{StaticResource MutedText}" />
                                <DockPanel x:Name="BackgroundSecondaryColorPanel"
                                           LastChildFill="True"
                                           Margin="0,4,0,12">
                                    <Button x:Name="BackgroundSecondaryColorButton"
                                            DockPanel.Dock="Right"
                                            Width="38"
                                            Margin="8,0,0,0"
                                            ToolTip="Escoger color"
                                            Click="BackgroundSecondaryColorButton_Click" />
                                    <TextBox x:Name="BackgroundSecondaryColorBox"
                                             Margin="0"
                                             TextChanged="BackgroundFieldChanged" />
                                </DockPanel>

                                <TextBlock x:Name="BackgroundTertiaryColorLabel"
                                           Text="Tercer color de fondo"
                                           Style="{StaticResource MutedText}" />
                                <DockPanel x:Name="BackgroundTertiaryColorPanel"
                                           LastChildFill="True"
                                           Margin="0,4,0,12">
                                    <Button x:Name="BackgroundTertiaryColorButton"
                                            DockPanel.Dock="Right"
                                            Width="38"
                                            Margin="8,0,0,0"
                                            ToolTip="Escoger color"
                                            Click="BackgroundTertiaryColorButton_Click" />
                                    <TextBox x:Name="BackgroundTertiaryColorBox"
                                             Margin="0"
                                             TextChanged="BackgroundFieldChanged" />
                                </DockPanel>

                                <Grid x:Name="BackgroundCycleGrid">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Delay de fondo" Style="{StaticResource MutedText}" />
                                    <TextBlock x:Name="BackgroundCycleValueText"
                                               Grid.Column="1"
                                               HorizontalAlignment="Right"
                                               Style="{StaticResource MutedText}" />
                                </Grid>
                                <Slider x:Name="BackgroundCycleSlider"
                                        Minimum="10"
                                        Maximum="2000"
                                        TickFrequency="10"
                                        ValueChanged="BackgroundFieldChanged" />

                                <Grid x:Name="BackgroundStepGrid">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Duracion del paso de fondo" Style="{StaticResource MutedText}" />
                                    <TextBlock x:Name="BackgroundStepValueText"
                                               Grid.Column="1"
                                               HorizontalAlignment="Right"
                                               Style="{StaticResource MutedText}" />
                                </Grid>
                                <Slider x:Name="BackgroundStepSlider"
                                        Minimum="10"
                                        Maximum="5000"
                                        TickFrequency="10"
                                        ValueChanged="BackgroundFieldChanged" />

                                <TextBlock Text="Simulacion"
                                           FontWeight="SemiBold"
                                           Margin="0,8,0,6" />
                                <Border x:Name="BackgroundLedPreviewPanel"
                                        BorderBrush="{DynamicResource ThemeBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="10"
                                        Background="{DynamicResource ThemeSurfaceBrush}"
                                        IsVisibleChanged="BackgroundLedPreviewPanel_IsVisibleChanged">
                                    <ItemsControl x:Name="BackgroundLedPreviewList">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Ellipse Width="16"
                                                         Height="16"
                                                         Fill="{Binding Fill}"
                                                         Stroke="#80FFFFFF"
                                                         StrokeThickness="1"
                                                         Margin="4">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect Color="{Binding GlowColor}"
                                                                          BlurRadius="{Binding GlowRadius}"
                                                                          ShadowDepth="0"
                                                                          Opacity="{Binding GlowOpacity}" />
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>

                                <WrapPanel Margin="0,8,0,0">
                                    <Button x:Name="ApplyArduinoBackgroundButton"
                                            Content="Aplicar fondo LED"
                                            Style="{StaticResource PrimaryButton}"
                                            Click="ApplyArduinoBackgroundButton_Click" />
                                    <Button Content="Apagar tiras"
                                            Style="{StaticResource DangerButton}"
                                            Click="StopArduinoBackgroundButton_Click" />
                                    <Button Content="Borrar salida"
                                            Style="{StaticResource DangerButton}"
                                            Click="RemoveStripButton_Click" />
                                </WrapPanel>

                                <Button Content="Agregar salida de pin digital"
                                        Style="{StaticResource PrimaryButton}"
                                        HorizontalContentAlignment="Center"
                                        Margin="0,12,0,0"
                                        Click="AddStripButton_Click" />

                                <Grid Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border BorderBrush="{DynamicResource ThemeBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="14"
                                            Background="{DynamicResource ThemeInputBrush}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="46" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Image Source="Assets/Icons/nav_arduino.png"
                                                   Width="30"
                                                   Height="30"
                                                   Stretch="Uniform"
                                                   VerticalAlignment="Top" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Sketch"
                                                           FontWeight="SemiBold"
                                                           FontSize="15" />
                                                <TextBlock Text="Tu Arduino necesita el sketch instalado para funcionar con Neo Twitch."
                                                           Style="{StaticResource MutedText}"
                                                           TextWrapping="Wrap"
                                                           FontSize="12"
                                                           Margin="0,4,0,10" />
                                                <WrapPanel>
                                                    <Button Content="Descargar ultimo sketch"
                                                            Style="{StaticResource PrimaryButton}"
                                                            Click="OpenArduinoSketchButton_Click" />
                                                    <Button Content="Ver guia"
                                                            Click="OpenArduinoGuideButton_Click" />
                                                </WrapPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Border Grid.Column="2"
                                            BorderBrush="{DynamicResource ThemeBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="14"
                                            Background="{DynamicResource ThemeInputBrush}">
                                        <StackPanel>
                                            <TextBlock Text="Estado actual"
                                                       FontWeight="SemiBold"
                                                       FontSize="15"
                                                       Margin="0,0,0,8" />
                                            <Grid Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Dispositivo" Style="{StaticResource MutedText}" />
                                                <TextBlock x:Name="LightsArduinoDeviceText"
                                                           Grid.Column="1"
                                                           FontWeight="SemiBold" />
                                            </Grid>
                                            <Grid Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Puerto actual" Style="{StaticResource MutedText}" />
                                                <TextBlock x:Name="LightsArduinoPortText"
                                                           Grid.Column="1"
                                                           FontWeight="SemiBold" />
                                            </Grid>
                                            <Grid Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="LEDs configurados" Style="{StaticResource MutedText}" />
                                                <TextBlock x:Name="LightsArduinoLedCountText"
                                                           Grid.Column="1"
                                                           FontWeight="SemiBold" />
                                            </Grid>
                                            <Grid Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Pines activos" Style="{StaticResource MutedText}" />
                                                <TextBlock x:Name="LightsArduinoPinsText"
                                                           Grid.Column="1"
                                                           FontWeight="SemiBold" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
            </TabItem>

            <TabItem Header="Alexa">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                    <Grid Margin="24" MinWidth="780">
                        <Border Style="{StaticResource Card}">
                            <StackPanel x:Name="AlexaBackgroundPanel">
                                    <TextBlock Text="Fondo Alexa"
                                               FontSize="18"
                                               Style="{StaticResource TitleText}"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,12" />
                                    <TextBlock Text="Esta salida envia eventos al relay de Alexa para controlar rutinas o dispositivos configurados en tu skill."
                                               Style="{StaticResource MutedText}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,12" />
                                    <TextBlock x:Name="AlexaBackgroundUnavailableText"
                                               Text="Primero activa y configura Alexa en Conexiones para usar este fondo."
                                               Style="{StaticResource MutedText}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,12" />
                                    <CheckBox x:Name="BackgroundAlexaEnabledCheck"
                                              Content="Mantener fondo Alexa encendido"
                                              Checked="BackgroundFieldChanged"
                                              Unchecked="BackgroundFieldChanged" />
                                    <CheckBox x:Name="BackgroundAlexaTurnOffAfterEventCheck"
                                              Content="Apagar fondo Alexa al finalizar evento"
                                              Checked="BackgroundFieldChanged"
                                              Unchecked="BackgroundFieldChanged" />

                                    <Grid x:Name="BackgroundAlexaEventsGrid">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Evento Alexa encendido"
                                                       Style="{StaticResource MutedText}" />
                                            <TextBox x:Name="BackgroundAlexaOnEventBox"
                                                     TextChanged="BackgroundFieldChanged"
                                                     ToolTip="Evento que recibira el relay cuando el fondo Alexa debe quedar encendido." />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Evento Alexa apagado"
                                                       Style="{StaticResource MutedText}" />
                                            <TextBox x:Name="BackgroundAlexaOffEventBox"
                                                     TextChanged="BackgroundFieldChanged"
                                                     ToolTip="Evento que recibira el relay cuando el fondo Alexa debe quedar apagado." />
                                        </StackPanel>
                                    </Grid>

                                    <WrapPanel Margin="0,8,0,0">
                                        <Button x:Name="ApplyAlexaBackgroundButton"
                                                Content="Aplicar fondo Alexa"
                                                Style="{StaticResource PrimaryButton}"
                                                Click="ApplyAlexaBackgroundButton_Click" />
                                        <Button Content="Apagar fondo Alexa"
                                                x:Name="StopAlexaBackgroundButton"
                                                Style="{StaticResource DangerButton}"
                                                Click="StopAlexaBackgroundButton_Click" />
                                    </WrapPanel>
                                </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Audio">
                <Grid Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="Audio"
                                       FontSize="28"
                                       Style="{StaticResource TitleText}"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Administra los audios de tu stream, su volumen y sus grupos."
                                       Style="{StaticResource MutedText}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1"
                          Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="70" />
                                </Grid.ColumnDefinitions>
                                <Border Width="48"
                                        Height="48"
                                        CornerRadius="12"
                                        Background="#1514B8A6"
                                        Tag="StaticBrush">
                                    <Border Width="28"
                                            Height="28"
                                            Background="#14B8A6"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Tag="StaticBrush">
                                        <Border.OpacityMask>
                                            <ImageBrush ImageSource="Assets/Icons/nav_audio.png"
                                                        Stretch="Uniform" />
                                        </Border.OpacityMask>
                                    </Border>
                                </Border>
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Volumen general"
                                               FontWeight="SemiBold" />
                                    <Slider x:Name="AlertVolumeSlider"
                                            Minimum="0"
                                            Maximum="100"
                                            TickFrequency="1"
                                            Margin="0,8,12,0"
                                            ValueChanged="GlobalSettingsChanged" />
                                </StackPanel>
                                <TextBlock x:Name="AlertVolumeValueText"
                                           Grid.Column="2"
                                           Text="100%"
                                           Foreground="#14B8A6"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right" />
                            </Grid>
                        </Border>

                        <Border Grid.Column="2"
                                Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="54" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="44"
                                        Height="44"
                                        CornerRadius="12"
                                        Background="#18B56CFF"
                                        Tag="StaticBrush">
                                    <Border Width="26"
                                            Height="26"
                                            Background="#B56CFF"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Tag="StaticBrush">
                                        <Border.OpacityMask>
                                            <ImageBrush ImageSource="Assets/Icons/sound_music.png"
                                                        Stretch="Uniform" />
                                        </Border.OpacityMask>
                                    </Border>
                                </Border>
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Audios guardados"
                                               Style="{StaticResource MutedText}" />
                                    <TextBlock x:Name="AudioSavedCountText"
                                               Text="0"
                                               Foreground="#B56CFF"
                                               FontSize="20"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Column="4"
                                Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="54" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="44"
                                        Height="44"
                                        CornerRadius="12"
                                        Background="#1814B8A6"
                                        Tag="StaticBrush">
                                    <Border Width="26"
                                            Height="26"
                                            Background="#14B8A6"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Tag="StaticBrush">
                                        <Border.OpacityMask>
                                            <ImageBrush ImageSource="Assets/Icons/sound_group.png"
                                                        Stretch="Uniform" />
                                        </Border.OpacityMask>
                                    </Border>
                                </Border>
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Grupos creados"
                                               Style="{StaticResource MutedText}" />
                                    <TextBlock x:Name="AudioGroupCountText"
                                               Text="0"
                                               Foreground="#14B8A6"
                                               FontSize="20"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Column="6"
                                Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="54" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="44"
                                        Height="44"
                                        CornerRadius="12"
                                        Background="#182FB4E9"
                                        Tag="StaticBrush">
                                    <Path Width="26"
                                          Height="26"
                                          Stretch="Uniform"
                                          Stroke="#2FB4E9"
                                          StrokeThickness="2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Data="M12,5 A7,7 0 1 0 19,12 M19,5 L19,12 L13,12" />
                                </Border>
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Último audio"
                                               Style="{StaticResource MutedText}" />
                                    <TextBlock x:Name="LastAudioText"
                                               Text="Sin uso"
                                               Foreground="#37C7F3"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Biblioteca de audios"
                                           FontSize="18"
                                           Style="{StaticResource TitleText}"
                                           FontWeight="SemiBold" />

                                <Grid Grid.Row="1"
                                      Margin="0,16,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="AudioSearchBox"
                                             TextChanged="AudioSearchBox_TextChanged"
                                             Margin="0"
                                             ToolTip="Buscar audio por nombre, grupo o alerta" />
                                    <WrapPanel Grid.Column="2">
                                        <Button x:Name="AudioFilterAllButton"
                                                Content="Todos"
                                                Tag="ALL"
                                                Click="AudioFilterButton_Click" />
                                        <Button x:Name="AudioFilterWithAlertButton"
                                                Content="Con alerta"
                                                Tag="WITH_ALERT"
                                                Click="AudioFilterButton_Click" />
                                        <Button x:Name="AudioFilterNoGroupButton"
                                                Content="Sin grupo"
                                                Tag="NO_GROUP"
                                                Click="AudioFilterButton_Click" />
                                    </WrapPanel>
                                </Grid>

                                <Grid Grid.Row="2"
                                      Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="1.35*" />
                                        <ColumnDefinition Width="1.1*" />
                                        <ColumnDefinition Width="82" />
                                        <ColumnDefinition Width="104" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Nombre del audio" Style="{StaticResource MutedText}" />
                                    <TextBlock Grid.Column="1" Text="Alerta asignada" Style="{StaticResource MutedText}" />
                                    <TextBlock Grid.Column="2" Text="Grupo" Style="{StaticResource MutedText}" />
                                    <TextBlock Grid.Column="3" Text="Duración" Style="{StaticResource MutedText}" />
                                    <TextBlock Grid.Column="4" Text="Acciones" Style="{StaticResource MutedText}" />
                                </Grid>

                                <ScrollViewer Grid.Row="3"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl x:Name="AudioLibraryList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource ThemeBorderBrush}"
                                                        BorderThickness="0,1,0,0"
                                                        Padding="0,10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="2*" />
                                                            <ColumnDefinition Width="1.35*" />
                                                            <ColumnDefinition Width="1.1*" />
                                                            <ColumnDefinition Width="82" />
                                                            <ColumnDefinition Width="104" />
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Orientation="Horizontal"
                                                                    VerticalAlignment="Center">
                                                            <Border Width="36"
                                                                    Height="36"
                                                                    CornerRadius="9"
                                                                    Background="#1714B8A6"
                                                                    Margin="0,0,10,0"
                                                                    Tag="StaticBrush">
                                                                <Border Width="21"
                                                                        Height="21"
                                                                        Background="#14B8A6"
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"
                                                                        Tag="StaticBrush">
                                                                    <Border.OpacityMask>
                                                                        <ImageBrush ImageSource="Assets/Icons/sound_file.png"
                                                                                    Stretch="Uniform" />
                                                                    </Border.OpacityMask>
                                                                </Border>
                                                            </Border>
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>

                                                        <Border Grid.Column="1"
                                                                Visibility="{Binding AssignedAlertVisibility}"
                                                                Background="{Binding AssignedAlertBackground}"
                                                                BorderBrush="{Binding AssignedAlertBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="7"
                                                                Padding="8,5"
                                                                Tag="StaticBrush"
                                                                HorizontalAlignment="Left"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding AssignedAlertText}"
                                                                       Foreground="{Binding AssignedAlertBrush}"
                                                                       FontWeight="SemiBold"
                                                                       FontSize="12"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </Border>

                                                        <ComboBox Grid.Column="2"
                                                                  MinHeight="32"
                                                                  Margin="0"
                                                                  ItemsSource="{Binding AudioGroupChoices, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  DisplayMemberPath="Name"
                                                                  SelectedValuePath="Id"
                                                                  SelectedValue="{Binding GroupId, Mode=OneWay}"
                                                                  Tag="{Binding Id}"
                                                                  DropDownClosed="AudioLibraryGroupBox_DropDownClosed" />
                                                        <TextBlock Grid.Column="3"
                                                                   Text="{Binding DurationText}"
                                                                   VerticalAlignment="Center" />
                                                        <StackPanel Grid.Column="4"
                                                                    Orientation="Horizontal"
                                                                    HorizontalAlignment="Right">
                                                            <Button Width="38"
                                                                    Height="36"
                                                                    Padding="0"
                                                                    Margin="0,0,6,0"
                                                                    Tag="{Binding Id}"
                                                                    ToolTipService.ShowDuration="6000"
                                                                    ToolTip="{Binding PlayToolTip}"
                                                                    Click="PreviewAudioButton_Click">
                                                                <Grid Width="18"
                                                                      Height="18">
                                                                    <Border Background="#14B8A6"
                                                                            Tag="StaticBrush"
                                                                            Visibility="{Binding PlayIconVisibility}">
                                                                        <Border.OpacityMask>
                                                                            <ImageBrush ImageSource="Assets/Icons/sound_play.png"
                                                                                        Stretch="Uniform" />
                                                                        </Border.OpacityMask>
                                                                    </Border>
                                                                    <Border Background="#14B8A6"
                                                                            Tag="StaticBrush"
                                                                            Visibility="{Binding PauseIconVisibility}">
                                                                        <Border.OpacityMask>
                                                                            <ImageBrush ImageSource="Assets/Icons/sound_pause.png"
                                                                                        Stretch="Uniform" />
                                                                        </Border.OpacityMask>
                                                                    </Border>
                                                                </Grid>
                                                            </Button>
                                                            <Button Width="38"
                                                                    Height="36"
                                                                    Padding="0"
                                                                    Margin="0"
                                                                    Background="{DynamicResource ThemeInputBrush}"
                                                                    BorderBrush="#F43F5E"
                                                                    Tag="{Binding Id}"
                                                                    ToolTip="Eliminar audio"
                                                                    Click="DeleteAudioButton_Click">
                                                                <Border Width="18"
                                                                        Height="18"
                                                                        Background="#F43F5E"
                                                                        Tag="StaticBrush">
                                                                    <Border.OpacityMask>
                                                                        <ImageBrush ImageSource="Assets/Icons/icon_delete.png"
                                                                                    Stretch="Uniform" />
                                                                    </Border.OpacityMask>
                                                                </Border>
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <TextBlock x:Name="AudioLibraryFooterText"
                                           Grid.Row="4"
                                           Text="Mostrando 0 de 0 audios"
                                           Style="{StaticResource MutedText}"
                                           Margin="0,12,0,0" />
                            </Grid>
                        </Border>

                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="3*" />
                                <RowDefinition Height="18" />
                                <RowDefinition Height="2*" />
                            </Grid.RowDefinitions>

                            <Border Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Añadir nuevo audio"
                                               FontSize="18"
                                               Style="{StaticResource TitleText}"
                                               FontWeight="SemiBold" />

                                    <Button Grid.Row="1"
                                            Margin="0,14,0,12"
                                            Padding="14"
                                            Background="{DynamicResource ThemeInputBrush}"
                                            BorderBrush="{DynamicResource ThemeBorderBrush}"
                                            BorderThickness="1"
                                            Click="BrowseNewAudioButton_Click">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Border Width="38"
                                                    Height="38"
                                                    Background="#14B8A6"
                                                    HorizontalAlignment="Center"
                                                    Tag="StaticBrush">
                                                <Border.OpacityMask>
                                                    <ImageBrush ImageSource="Assets/Icons/sound_file.png"
                                                                Stretch="Uniform" />
                                                </Border.OpacityMask>
                                            </Border>
                                            <TextBlock Text="Haz clic para seleccionar un archivo de audio"
                                                       Style="{StaticResource MutedText}"
                                                       TextAlignment="Center"
                                                       Margin="0,8,0,0" />
                                        </StackPanel>
                                    </Button>

                                    <ScrollViewer Grid.Row="2"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel>
                                            <TextBlock Text="Archivo seleccionado"
                                                       Style="{StaticResource MutedText}" />
                                            <TextBox x:Name="NewAudioPathBox"
                                                     IsReadOnly="True" />
                                            <TextBlock Text="Nombre del audio"
                                                       Style="{StaticResource MutedText}" />
                                            <TextBox x:Name="NewAudioNameBox"
                                                     ToolTip="Nombre corto para reconocerlo en las alertas" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="Alerta asignada"
                                                               Style="{StaticResource MutedText}" />
                                                    <ComboBox x:Name="NewAudioAlertBox" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Grupo"
                                                               Style="{StaticResource MutedText}" />
                                                    <ComboBox x:Name="NewAudioGroupBox" />
                                                </StackPanel>
                                            </Grid>
                                            <Button Style="{StaticResource PrimaryButton}"
                                                    Margin="0,8,0,0"
                                                    Click="SaveNewAudioButton_Click">
                                                <StackPanel Orientation="Horizontal"
                                                            HorizontalAlignment="Center">
                                                    <Border Width="18"
                                                            Height="18"
                                                            Background="White"
                                                            Tag="StaticBrush">
                                                        <Border.OpacityMask>
                                                            <ImageBrush ImageSource="Assets/Icons/icon_save.png"
                                                                        Stretch="Uniform" />
                                                        </Border.OpacityMask>
                                                    </Border>
                                                    <TextBlock Text="Guardar audio"
                                                               Foreground="White"
                                                               FontWeight="SemiBold"
                                                               Margin="8,0,0,0"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </Border>

                            <Border Grid.Row="2"
                                    Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Grupos de audio"
                                                       FontSize="18"
                                                       Style="{StaticResource TitleText}"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="Organiza varios audios para usarlos juntos."
                                                       Style="{StaticResource MutedText}" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid Grid.Row="1"
                                          Margin="0,14,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="NewAudioGroupNameBox"
                                                 Margin="0"
                                                 ToolTip="Nombre del nuevo grupo" />
                                        <Button Grid.Column="2"
                                                Content="Crear"
                                                Style="{StaticResource PrimaryButton}"
                                                MinWidth="92"
                                                Margin="0"
                                                Click="AddAudioGroupButton_Click" />
                                    </Grid>

                                    <ScrollViewer Grid.Row="2"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl x:Name="AudioGroupsList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{DynamicResource ThemeBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="10"
                                                            Padding="12"
                                                            Margin="0,0,0,8"
                                                            Background="{DynamicResource ThemeInputBrush}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="36" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="84" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Width="24"
                                                                    Height="24"
                                                                    Background="{Binding AccentBrush}"
                                                                    Tag="StaticBrush">
                                                                <Border.OpacityMask>
                                                                    <ImageBrush ImageSource="Assets/Icons/sound_group.png"
                                                                                Stretch="Uniform" />
                                                                </Border.OpacityMask>
                                                            </Border>
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding Name}"
                                                                       FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       VerticalAlignment="Center" />
                                                            <Border Grid.Column="2"
                                                                    CornerRadius="10"
                                                                    Padding="10,4"
                                                                    Background="#2214B8A6"
                                                                    Tag="StaticBrush">
                                                                <TextBlock Text="{Binding CountText}"
                                                                           Foreground="#14B8A6"
                                                                           FontWeight="SemiBold"
                                                                           FontSize="12" />
                                                            </Border>
                                                            <StackPanel Grid.Column="3"
                                                                        Orientation="Horizontal"
                                                                        HorizontalAlignment="Right"
                                                                        Margin="8,0,0,0">
                                                                <Button Width="34"
                                                                        Height="32"
                                                                        Padding="0"
                                                                        Margin="0,0,6,0"
                                                                        Tag="{Binding Id}"
                                                                        ToolTip="Ver audios del grupo"
                                                                        Click="ViewAudioGroupButton_Click">
                                                                    <Path Width="15"
                                                                          Height="15"
                                                                          Stretch="Uniform"
                                                                          Stroke="{Binding AccentBrush}"
                                                                          StrokeThickness="2"
                                                                          StrokeStartLineCap="Round"
                                                                          StrokeEndLineCap="Round"
                                                                          Data="M10.5,5 A5.5,5.5 0 1 1 10.5,16 A5.5,5.5 0 1 1 10.5,5 M15,15 L21,21" />
                                                                </Button>
                                                                <Button Width="34"
                                                                        Height="32"
                                                                        Padding="0"
                                                                        Margin="0"
                                                                        Background="{DynamicResource ThemeInputBrush}"
                                                                        BorderBrush="#F43F5E"
                                                                        Tag="{Binding Id}"
                                                                        ToolTip="Eliminar grupo"
                                                                        Click="DeleteAudioGroupButton_Click">
                                                                    <Border Width="16"
                                                                            Height="16"
                                                                            Background="#F43F5E"
                                                                            Tag="StaticBrush">
                                                                        <Border.OpacityMask>
                                                                            <ImageBrush ImageSource="Assets/Icons/icon_delete.png"
                                                                                        Stretch="Uniform" />
                                                                        </Border.OpacityMask>
                                                                    </Border>
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Imagenes">
                <Grid Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="0,0,0,18">
                        <TextBlock Text="Imagenes"
                                   FontSize="28"
                                   Style="{StaticResource TitleText}"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Administra imagenes para usarlas despues en alertas y escenas de OBS."
                                   Style="{StaticResource MutedText}"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <Grid Grid.Row="1"
                          Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="54" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="44"
                                        Height="44"
                                        CornerRadius="12"
                                        Background="#1837C7F3"
                                        Tag="StaticBrush">
                                    <Border Width="26"
                                            Height="26"
                                            Background="#37C7F3"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Tag="StaticBrush">
                                        <Border.OpacityMask>
                                            <ImageBrush ImageSource="Assets/Icons/media_image.png"
                                                        Stretch="Uniform" />
                                        </Border.OpacityMask>
                                    </Border>
                                </Border>
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Imagenes guardadas"
                                               Style="{StaticResource MutedText}" />
                                    <TextBlock x:Name="ImageSavedCountText"
                                               Text="0"
                                               Foreground="#37C7F3"
                                               FontSize="20"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2"
                                Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="54" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="44"
                                        Height="44"
                                        CornerRadius="12"
                                        Background="#1814B8A6"
                                        Tag="StaticBrush">
                                    <Border Width="26"
                                            Height="26"
                                            Background="#14B8A6"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Tag="StaticBrush">
                                        <Border.OpacityMask>
                                            <ImageBrush ImageSource="Assets/Icons/media_group.png"
                                                        Stretch="Uniform" />
                                        </Border.OpacityMask>
                                    </Border>
                                </Border>
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Grupos creados"
                                               Style="{StaticResource MutedText}" />
                                    <TextBlock x:Name="ImageGroupCountText"
                                               Text="0"
                                               Foreground="#14B8A6"
                                               FontSize="20"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Column="4"
                                Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="54" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="44"
                                        Height="44"
                                        CornerRadius="12"
                                        Background="#18B56CFF"
                                        Tag="StaticBrush">
                                    <Border Width="26"
                                            Height="26"
                                            Background="#B56CFF"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Tag="StaticBrush">
                                        <Border.OpacityMask>
                                            <ImageBrush ImageSource="Assets/Icons/icon_timer.png"
                                                        Stretch="Uniform" />
                                        </Border.OpacityMask>
                                    </Border>
                                </Border>
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Ultima imagen"
                                               Style="{StaticResource MutedText}" />
                                    <TextBlock x:Name="LastImageText"
                                               Text="Sin uso"
                                               Foreground="#B56CFF"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Biblioteca de imagenes"
                                           FontSize="18"
                                           Style="{StaticResource TitleText}"
                                           FontWeight="SemiBold" />
                                <Grid Grid.Row="1"
                                      Margin="0,16,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="ImageSearchBox"
                                             TextChanged="ImageSearchBox_TextChanged"
                                             Margin="0"
                                             ToolTip="Buscar imagen por nombre, grupo o ruta" />
