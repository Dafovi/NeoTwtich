                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Host"
                                                   Style="{StaticResource MutedText}" />
                                        <TextBlock Text="{Binding Text, ElementName=ObsHostBox}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Puerto"
                                                   Style="{StaticResource MutedText}" />
                                        <TextBlock Text="{Binding Text, ElementName=ObsPortBox}"
                                                   FontWeight="SemiBold" />
                                    </StackPanel>
                                </Grid>
                                <Separator Margin="0,16,0,14" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Version"
                                               Style="{StaticResource MutedText}" />
                                    <TextBlock x:Name="ObsVersionText"
                                               Grid.Column="1"
                                               Text="Sin version"
                                               FontWeight="SemiBold" />
                                </Grid>
                                <TextBlock x:Name="ObsStatusText"
                                           Style="{StaticResource MutedText}"
                                           TextWrapping="Wrap"
                                           Margin="0,12,0,14" />
                                <WrapPanel HorizontalAlignment="Right">
                                    <Button Content="Ver guia OBS"
                                            Click="OpenObsGuideButton_Click" />
                                    <Button x:Name="TestObsButtonPanel"
                                            Content="Actualizar escenas"
                                            Click="TestObsButton_Click" />
                                    <Button x:Name="ConnectObsButtonPanel"
                                            Content="Conectar OBS"
                                            Style="{StaticResource PrimaryButton}"
                                            Click="ConnectObsButton_Click" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2"
                                Style="{StaticResource Card}">
                            <DockPanel LastChildFill="True">
                                <Grid DockPanel.Dock="Top"
                                      Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="170" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Escenas disponibles"
                                                   FontSize="18"
                                                   Style="{StaticResource TitleText}"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="Cambia escenas o usa esta lista al configurar automatizaciones."
                                                   Style="{StaticResource MutedText}"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="Actualizar escenas"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Top"
                                            Click="TestObsButton_Click" />
                                </Grid>
                                <ListBox x:Name="ObsScenesList"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource ThemeBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="12"
                                                    Padding="12"
                                                    Margin="0,0,0,8"
                                                    Background="{DynamicResource ThemeInputBrush}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="52" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="120" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="40"
                                                            Height="40"
                                                            CornerRadius="12"
                                                            Background="#1A14B8A6"
                                                            Tag="StaticBrush">
                                                        <Border Width="22"
                                                                Height="22"
                                                                Background="#14B8A6"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Tag="StaticBrush">
                                                            <Border.OpacityMask>
                                                                <ImageBrush ImageSource="Assets/Icons/nav_obs.png"
                                                                            Stretch="Uniform" />
                                                            </Border.OpacityMask>
                                                        </Border>
                                                    </Border>
                                                    <StackPanel Grid.Column="1"
                                                                VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding StatusText}"
                                                                   Style="{StaticResource MutedText}"
                                                                   FontSize="12" />
                                                    </StackPanel>
                                                    <Button Grid.Column="2"
                                                            Content="Cambiar ahora"
                                                            Visibility="{Binding ChangeButtonVisibility}"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Center"
                                                            Click="ObsSceneChangeButton_Click" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Configuracion">
                <views:SettingsView x:Name="SettingsView" />
            </TabItem>

            <TabItem Header="Actividad">
                <views:ActivityView x:Name="ActivityView" />
            </TabItem>
        </TabControl>

    </Grid>
</Window>
