                                             Height="9"
                                             StrokeThickness="1.5"
                                             Margin="0,2,6,0"
                                             ToolTip="Estado del directo" />
                                    <TextBlock x:Name="TwitchLiveStateText"
                                               Text="No esta en directo"
                                               FontSize="11" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Grid Visibility="Collapsed">
                        <TextBlock x:Name="TwitchConnectionText" Text="Sin conectar" />
                        <TextBlock x:Name="TwitchStatusText" />
                        <TextBlock x:Name="ArduinoConnectionText" Text="Sin conectar" />
                        <TextBlock x:Name="ArduinoStatusText" />
                        <TextBlock x:Name="AlexaConnectionText" Text="Sin conectar" />
                        <TextBlock x:Name="AlexaSidebarStatusText" />
                    </Grid>
                    <TextBlock x:Name="VersionText"
                               Text="V0.0.0"
                               FontSize="11"
                               Foreground="{DynamicResource ThemeSidebarMutedTextBrush}"
                               HorizontalAlignment="Left"
                               Margin="4,0,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <TabControl Grid.Row="1"
                    Grid.Column="1"
                    x:Name="MainTabs"
                    ItemContainerStyle="{StaticResource HiddenTabItem}"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    SelectionChanged="MainTabs_SelectionChanged">
            <TabItem Header="Panel">
                <views:DashboardView x:Name="DashboardView" />
            </TabItem>

            <TabItem Header="Conexiones">
                <views:ConnectionsView x:Name="ConnectionsView" />
            </TabItem>

            <TabItem Header="Alertas">
                    <Grid Margin="24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="0" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="430" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.ColumnSpan="3" Margin="0" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="Alertas"
                                           FontSize="28"
                                           Style="{StaticResource TitleText}"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="Crea reglas para seguidores, subs, raids, bits, chat y canjes."
                                           Style="{StaticResource MutedText}"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="1"
                                Grid.Column="0"
                                Style="{StaticResource Card}">
                            <DockPanel LastChildFill="True">
                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                    <Grid Margin="0,0,0,12">
                                        <TextBlock Text="Mis alertas"
                                                   FontSize="18"
                                                   Style="{StaticResource TitleText}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                        <Button Content="Nueva alerta"
                                                Style="{StaticResource PrimaryButton}"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Click="AddRuleButton_Click" />
                                    </Grid>

                                    <TextBox x:Name="RuleSearchBox"
                                             MinHeight="38"
                                             Margin="0,0,0,10"
                                             TextChanged="RuleSearchBox_TextChanged"
                                             ToolTip="Buscar alertas por nombre, evento o comando." />

                                    <WrapPanel Margin="0,0,0,8">
                                        <ToggleButton x:Name="RuleFilterAllButton"
                                                      Content="Todas"
                                                      Tag="ALL"
                                                      IsChecked="True"
                                                      Style="{StaticResource ActivityFilterButton}"
                                                      Click="RuleStatusFilterButton_Click" />
                                        <ToggleButton x:Name="RuleFilterActiveButton"
                                                      Content="Activas"
                                                      Tag="ACTIVE"
                                                      Style="{StaticResource ActivityFilterButton}"
                                                      Click="RuleStatusFilterButton_Click" />
                                        <ToggleButton x:Name="RuleFilterInactiveButton"
                                                      Content="Inactivas"
                                                      Tag="INACTIVE"
                                                      Style="{StaticResource ActivityFilterButton}"
                                                      Click="RuleStatusFilterButton_Click" />
                                    </WrapPanel>

                                    <ComboBox x:Name="RuleCategoryFilterBox"
                                              SelectionChanged="RuleCategoryFilterBox_SelectionChanged" />
                                </StackPanel>

                                <TextBlock x:Name="RulesCountText"
                                           DockPanel.Dock="Bottom"
                                           Style="{StaticResource MutedText}"
                                           FontSize="12"
                                           Margin="0,8,0,0" />

                                <ListBox x:Name="RulesList"
                                         BorderBrush="{DynamicResource ThemeBorderBrush}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         SelectionChanged="RulesList_SelectionChanged">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}" />
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="SelectedRuleFrame"
                                                                BorderBrush="Transparent"
                                                                BorderThickness="2"
                                                                CornerRadius="14"
                                                                Padding="2"
                                                                Margin="0,0,0,6">
                                                            <ContentPresenter />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="SelectedRuleFrame" Property="BorderBrush" Value="{DynamicResource ThemeSelectionBrush}" />
                                                                <Setter TargetName="SelectedRuleFrame" Property="Background" Value="#2214B8A6" />
                                                            </Trigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="SelectedRuleFrame" Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
                                                            </Trigger>
                                                            <MultiTrigger>
                                                                <MultiTrigger.Conditions>
                                                                    <Condition Property="IsSelected" Value="True" />
                                                                    <Condition Property="IsMouseOver" Value="True" />
                                                                </MultiTrigger.Conditions>
                                                                <Setter TargetName="SelectedRuleFrame" Property="BorderBrush" Value="{DynamicResource ThemeSelectionBrush}" />
                                                                <Setter TargetName="SelectedRuleFrame" Property="Background" Value="#2214B8A6" />
                                                            </MultiTrigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource ThemeBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="12"
                                                    Padding="10"
                                                    Margin="0"
                                                    Background="{DynamicResource ThemeInputBrush}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="44" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border Width="36"
                                                            Height="36"
                                                            CornerRadius="12"
                                                            Background="{Binding EventAccentColor}"
                                                            Opacity="0.18" />
                                                    <Image Width="24"
                                                           Height="24"
                                                           Source="{Binding EventIconPath}"
                                                           Stretch="Uniform"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />

                                                    <StackPanel Grid.Column="1"
                                                                Margin="8,0,10,0">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding DisplayLabel}"
                                                                   Style="{StaticResource MutedText}"
                                                                   FontSize="12"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding DisplayLabel}"
                                                                   Margin="0,2,0,0" />
                                                        <WrapPanel Margin="0,6,0,0">
                                                            <Image Source="Assets/Icons/nav_lights.png"
                                                                   Width="16"
                                                                   Height="16"
                                                                   Margin="0,0,10,0"
                                                                   Opacity="{Binding LightsActionOpacity}"
                                                                   ToolTip="{Binding LightsActionToolTip}"
                                                                   Visibility="{Binding LightsActionVisibility}" />
                                                            <Image Source="Assets/Icons/service_audio.png"
                                                                   Width="16"
                                                                   Height="16"
                                                                   Margin="0,0,10,0"
                                                                   Visibility="{Binding AudioActionVisibility}" />
                                                            <Image Source="Assets/Icons/action_message_green.png"
                                                                   Width="16"
                                                                   Height="16"
                                                                   Margin="0,0,10,0"
                                                                   Visibility="{Binding ChatActionVisibility}" />
                                                            <Image Source="Assets/Icons/service_alexa.png"
                                                                   Width="16"
                                                                   Height="16"
                                                                   Margin="0,0,10,0"
                                                                   Opacity="{Binding AlexaActionOpacity}"
                                                                   ToolTip="{Binding AlexaActionToolTip}"
                                                                   Visibility="{Binding AlexaActionVisibility}" />
                                                            <Image Source="Assets/ServiceObs.png"
                                                                   Width="16"
                                                                   Height="16"
                                                                   Margin="0,0,10,0"
                                                                   Opacity="{Binding ObsActionOpacity}"
                                                                   ToolTip="{Binding ObsActionToolTip}"
                                                                   Visibility="{Binding ObsActionVisibility}" />
                                                        </WrapPanel>
                                                    </StackPanel>

                                                    <Border Grid.Column="2"
                                                            Padding="8,3"
                                                            CornerRadius="10"
                                                            Background="{Binding StatusColor}"
                                                            Opacity="0.92"
                                                            VerticalAlignment="Top">
                                                        <TextBlock Text="{Binding StatusText}"
                                                                   Foreground="White"
                                                                   Tag="StaticBrush"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>

                        <Border Grid.Row="1"
                                Grid.Column="2"
                                Style="{StaticResource Card}">
                            <DockPanel LastChildFill="True">
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Configurar alerta"
                                                   FontSize="18"
                                                   Style="{StaticResource TitleText}"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="Define el evento y las acciones que se ejecutan."
                                                   Style="{StaticResource MutedText}"
                                                   FontSize="12"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                    <WrapPanel Grid.Column="1"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Top">
                                        <Button Content="Duplicar" Click="DuplicateRuleButton_Click" />
                                        <Button x:Name="RuleTestButton"
                                                Content="Probar alerta"
                                                Style="{StaticResource PrimaryButton}"
                                                Click="RuleTestButton_Click" />
                                        <Button Content="Guardar cambios"
                                                Style="{StaticResource PrimaryButton}"
                                                Click="SaveButton_Click" />
                                    </WrapPanel>
                                </Grid>

                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="RuleEditorPanel">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="18" />
                                                <ColumnDefinition Width="170" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Nombre de la alerta"
                                                           Style="{StaticResource MutedText}" />
                                                <TextBox x:Name="RuleNameBox"
                                                         TextChanged="RuleFieldChanged" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Estado"
                                                           Style="{StaticResource MutedText}" />
                                                <CheckBox x:Name="RuleEnabledCheck"
                                                          Content="Activa"
                                                          Checked="RuleFieldChanged"
                                                          Unchecked="RuleFieldChanged" />
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="Tipo de evento"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Margin="0,6,0,2" />
                                        <TextBlock Text="Elige cuando se activa esta alerta."
                                                   Style="{StaticResource MutedText}"
                                                   FontSize="12" />
                                        <ComboBox x:Name="EventKindBox"
                                                  Visibility="Collapsed"
                                                  SelectionChanged="RuleFieldChanged" />

                                        <Grid Margin="0,8,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="92" />
                                                <RowDefinition Height="10" />
                                                <RowDefinition Height="92" />
                                            </Grid.RowDefinitions>

                                            <Button x:Name="EventFollowTileButton"
                                                    Tag="Follow"
                                                    Click="EventKindTile_Click">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <Image Source="Assets/Icons/action_follower_teal.png"
                                                           Width="26"
                                                           Height="26"
                                                           Margin="0,0,0,8" />
                                                    <TextBlock Text="Nuevo seguidor"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               TextAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="EventSubscriptionTileButton"
                                                    Grid.Column="2"
                                                    Tag="Subscription"
                                                    Click="EventKindTile_Click">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <Image Source="Assets/Icons/action_subscription_purple.png"
                                                           Width="26"
                                                           Height="26"
                                                           Margin="0,0,0,8" />
                                                    <TextBlock Text="Nueva suscripcion"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               TextAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="EventRaidTileButton"
                                                    Grid.Column="4"
                                                    Tag="Raid"
                                                    Click="EventKindTile_Click">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <Image Source="Assets/Icons/activity_notification.png"
                                                           Width="26"
                                                           Height="26"
                                                           Margin="0,0,0,8" />
                                                    <TextBlock Text="Raid recibida"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               TextAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="EventCheerTileButton"
                                                    Grid.Row="2"
                                                    Tag="Cheer"
                                                    Click="EventKindTile_Click">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <Image Source="Assets/Icons/action_bits_blue.png"
                                                           Width="26"
                                                           Height="26"
                                                           Margin="0,0,0,8" />
                                                    <TextBlock Text="Bits"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               TextAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="EventChatCommandTileButton"
                                                    Grid.Row="2"
                                                    Grid.Column="2"
                                                    Tag="ChatCommand"
                                                    Click="EventKindTile_Click">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <Image Source="Assets/Icons/action_message_green.png"
                                                           Width="26"
                                                           Height="26"
                                                           Margin="0,0,0,8" />
                                                    <TextBlock Text="Comando de chat"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               TextAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="EventRedemptionTileButton"
                                                    Grid.Row="2"
                                                    Grid.Column="4"
                                                    Tag="ChannelPointRedemption"
                                                    Click="EventKindTile_Click">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <Image Source="Assets/Icons/activity_notification_lime.png"
                                                           Width="26"
                                                           Height="26"
                                                           Margin="0,0,0,8" />
                                                    <TextBlock Text="Canje de puntos"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               TextAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>

                                        <StackPanel>
                                            <TextBlock x:Name="RewardTitleLabel"
                                                       Text="Canje especifico"
                                                       Style="{StaticResource MutedText}" />
                                            <TextBox x:Name="RewardTitleBox"
                                                     TextChanged="RuleFieldChanged"
                                                     ToolTip="Dejalo vacio para aceptar cualquier canje personalizado." />

                                            <TextBlock x:Name="MinimumBitsLabel"
                                                       Text="Bits minimos"
                                                       Style="{StaticResource MutedText}" />
                                            <TextBox x:Name="MinimumBitsBox"
                                                     TextChanged="RuleFieldChanged"
                                                     ToolTip="Para bits, usa el mayor umbral que sea menor o igual a la cantidad recibida." />
                                        </StackPanel>

                                        <TextBlock x:Name="ChatCommandLabel"
                                                   Text="Comando de chat"
                                                   Style="{StaticResource MutedText}" />
                                        <TextBox x:Name="ChatCommandBox"
                                                 TextChanged="RuleFieldChanged"
                                                 ToolTip="Ejemplo: !baile. La regla se activa cuando el mensaje empieza con ese comando." />

                                        <StackPanel Margin="0,10,0,0">
                                            <TextBlock Text="Acciones opcionales"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,0,2" />
                                            <TextBlock Text="Activa lo que quieres ejecutar cuando llegue el evento."
                                                       Style="{StaticResource MutedText}"
                                                       FontSize="12"
                                                       Margin="0,0,0,8" />

                                            <Border x:Name="UseLightsActionCard"
                                                    BorderBrush="{DynamicResource ThemeBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="12"
                                                    Padding="12"
                                                    Margin="0,0,0,10"
                                                    Background="{DynamicResource ThemeInputBrush}">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="42" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Image Source="Assets/Icons/nav_lights.png"
                                                               Width="26"
                                                               Height="26"
                                                               Stretch="Uniform" />
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="Luces"
                                                                       FontWeight="SemiBold" />
                                                            <TextBlock Text="Efectos y colores dinamicos."
                                                                       Style="{StaticResource MutedText}"
                                                                       FontSize="12" />
                                                        </StackPanel>
                                                        <CheckBox x:Name="UseLightsCheck"
                                                                  Grid.Column="2"
                                                                  Content=""
                                                                  Checked="RuleFieldChanged"
                                                                  Unchecked="RuleFieldChanged" />
                                                    </Grid>

                                                    <Expander x:Name="LightConfigurationPanel"
                                                              Header="Configuracion de luces"
                                                              IsExpanded="True"
                                                              Foreground="{DynamicResource ThemeTextBrush}"
                                                              Margin="42,10,0,0">
                                                        <StackPanel Margin="0,10,0,0">
                                                            <TextBlock Text="Se muestran solo las opciones que usa el patron."
                                                                       Style="{StaticResource MutedText}"
                                                                       FontSize="12"
                                                                       Margin="0,0,0,10" />

                                                            <Separator x:Name="LightOptionsSeparator"
                                                                       Margin="0,0,0,12" />

                                                            <TextBlock x:Name="TargetPinsLabel"
                                                                       Text="Pines de salida"
                                                                       Style="{StaticResource MutedText}" />
                                                            <TextBox x:Name="TargetPinsBox"
                                                                     TextChanged="RuleFieldChanged"
                                                                     ToolTip="Dejalo vacio para usar todas las tiras. Ejemplo: 6, 7" />

                                                            <StackPanel x:Name="PatternGrid">
                                                                <TextBlock Text="Patron" Style="{StaticResource MutedText}" />
                                                                <ComboBox x:Name="PatternBox"
                                                                          Visibility="Collapsed"
                                                                          SelectionChanged="RuleFieldChanged" />
                                                                <Grid Margin="0,4,0,12">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="8" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="8" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="8" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="72" />
                                                                        <RowDefinition Height="8" />
                                                                        <RowDefinition Height="72" />
                                                                    </Grid.RowDefinitions>

                                                                    <Button x:Name="PatternSolidTileButton"
                                                                            Tag="Solid"
                                                                            Click="PatternTile_Click">
                                                                        <StackPanel HorizontalAlignment="Center">
                                                                            <Image Source="Assets/Icons/lights_fx_static.png"
