                                                            </DockPanel>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>

                                            <Border BorderBrush="{DynamicResource ThemeBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="12"
                                                    Padding="12"
                                                    Margin="0,0,0,10"
                                                    Background="{DynamicResource ThemeInputBrush}">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="42" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Image Source="Assets/Icons/action_message_green.png"
                                                               Width="26"
                                                               Height="26"
                                                               Stretch="Uniform" />
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="Mensaje de chat"
                                                                       FontWeight="SemiBold" />
                                                            <TextBlock Text="Envia respuesta automatica."
                                                                       Style="{StaticResource MutedText}"
                                                                       FontSize="12" />
                                                        </StackPanel>
                                                        <CheckBox x:Name="ChatMessageCheck"
                                                                  Grid.Column="2"
                                                                  Content=""
                                                                  Checked="RuleFieldChanged"
                                                                  Unchecked="RuleFieldChanged" />
                                                    </Grid>

                                                    <StackPanel x:Name="ChatDetailsPanel"
                                                                Margin="42,12,0,0">
                                                            <TextBlock x:Name="ChatMessageLabel"
                                                                       Text="Mensaje al chat"
                                                                       Style="{StaticResource MutedText}" />
