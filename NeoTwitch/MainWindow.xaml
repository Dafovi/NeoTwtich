                                                                       Style="{StaticResource MutedText}"
                                                                       FontSize="12" />
                                                        </StackPanel>
                                                        <CheckBox x:Name="AlexaEventCheck"
                                                                  Grid.Column="2"
                                                                  Content=""
                                                                  Checked="RuleFieldChanged"
                                                                  Unchecked="RuleFieldChanged" />
                                                    </Grid>
                                                    <StackPanel x:Name="AlexaDetailsPanel"
                                                                Margin="42,12,0,0">
                                                        <TextBlock x:Name="AlexaRuleHintText"
