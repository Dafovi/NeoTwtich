                                                                <Border Width="21"
                                                                        Height="21"
                                                                        Background="{Binding AccentBrush}"
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center">
                                                                    <Border.OpacityMask>
                                                                        <ImageBrush ImageSource="{Binding IconPath}"
                                                                                    Stretch="Uniform" />
                                                                    </Border.OpacityMask>
                                                                </Border>
                                                            </Border>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Name}"
