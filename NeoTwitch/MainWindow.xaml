                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>

                                            <Border x:Name="AlexaActionCard"
                                                    BorderBrush="{DynamicResource ThemeBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="12"
                                                    Padding="12"
                                                    Margin="0,0,0,10"
                                                    Background="{DynamicResource ThemeInputBrush}">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="42" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Image Source="Assets/Icons/service_alexa.png"
                                                               Width="26"
                                                               Height="26"
                                                               Stretch="Uniform" />
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="Alexa"
                                                                       FontWeight="SemiBold" />
