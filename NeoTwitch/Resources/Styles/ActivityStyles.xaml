<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="ActivityListItem" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>

    <Style x:Key="ActivityFilterButton" TargetType="ToggleButton">
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="{DynamicResource ThemeInputBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeMutedTextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="ActivityTemplate">
        <Border BorderBrush="{DynamicResource ThemeBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="72" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding Time}"
                           Foreground="{DynamicResource ThemeMutedTextBrush}"
                           FontSize="12"
                           VerticalAlignment="Center" />

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,16,0">
                    <Border Width="28"
                            Height="28"
                            CornerRadius="8"
                            Background="Transparent"
                            Margin="0,0,9,0">
                        <Grid>
                            <Image Source="{Binding SourceIconImageSource}"
                                   Visibility="{Binding SourceImageVisibility}"
                                   Stretch="Uniform"
                                   Margin="2" />
                            <Viewbox Margin="6"
                                     Visibility="{Binding SourceVectorVisibility}">
                                <Path Data="{Binding SourceIconGeometry}"
                                      Stroke="{Binding SourceBrush}"
                                      StrokeThickness="2.4"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" />
                            </Viewbox>
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding SourceName}"
                               Foreground="{DynamicResource ThemeTextBrush}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="2"
                            VerticalAlignment="Center"
                            Margin="0,0,18,0">
                    <TextBlock Text="{Binding Title}"
                               Foreground="{DynamicResource ThemeTextBrush}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Description}"
                               Foreground="{DynamicResource ThemeMutedTextBrush}"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,2,0,0" />
                </StackPanel>

                <Border Grid.Column="3"
                        Width="24"
                        Height="24"
                        Background="{Binding StatusBrush}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        ToolTip="{Binding StatusText}">
                    <Border.OpacityMask>
                        <ImageBrush ImageSource="{Binding StatusIconImageSource}"
                                    Stretch="Uniform" />
                    </Border.OpacityMask>
                </Border>
            </Grid>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="MiniActivityTemplate">
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="38" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="46" />
            </Grid.ColumnDefinitions>

            <Border Width="30"
                    Height="30"
                    CornerRadius="9"
                    Background="{Binding IconBackgroundBrush}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top">
                <Grid>
                    <Image Source="{Binding IconImageSource}"
                           Visibility="{Binding OriginalImageIconVisibility}"
                           Stretch="Uniform"
                           Margin="5" />
                    <Border Visibility="{Binding TintedImageIconVisibility}"
                            Background="{Binding AccentBrush}"
                            Margin="5">
                        <Border.OpacityMask>
                            <ImageBrush ImageSource="{Binding IconImageSource}"
                                        Stretch="Uniform" />
                        </Border.OpacityMask>
                    </Border>
                    <Viewbox Margin="7"
                             Visibility="{Binding VectorIconVisibility}">
                        <Path Data="{Binding IconGeometry}"
                              Stroke="{Binding AccentBrush}"
                              StrokeThickness="2.4"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" />
                    </Viewbox>
                </Grid>
            </Border>

            <StackPanel Grid.Column="1"
                        Margin="0,0,8,0">
                <TextBlock Text="{Binding Title}"
                           Foreground="{DynamicResource ThemeTextBrush}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Description}"
                           Foreground="{DynamicResource ThemeMutedTextBrush}"
                           FontSize="12"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <TextBlock Grid.Column="2"
                       Text="{Binding Time}"
                       Foreground="{DynamicResource ThemeMutedTextBrush}"
                       FontSize="12"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Top" />
        </Grid>
    </DataTemplate>
</ResourceDictionary>
