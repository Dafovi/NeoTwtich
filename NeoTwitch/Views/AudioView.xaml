<views:NeoTwitchView x:Class="NeoTwitch.Views.AudioView"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     xmlns:views="clr-namespace:NeoTwitch.Views"
                     mc:Ignorable="d">
                <Grid Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="Audio"
                                       FontSize="28"
                                       Style="{StaticResource TitleText}"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Administra los audios de tu stream, su volumen y sus grupos."
                                       Style="{StaticResource MutedText}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1"
                          Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="70" />
                                </Grid.ColumnDefinitions>
                                <Border Width="48"
                                        Height="48"
                                        CornerRadius="12"
                                        Background="#1514B8A6"
                                        Tag="StaticBrush">
                                    <Border Width="28"
                                            Height="28"
                                            Background="#14B8A6"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Tag="StaticBrush">
                                        <Border.OpacityMask>
                                            <ImageBrush ImageSource="/Assets/Icons/nav_audio.png"
                                                        Stretch="Uniform" />
                                        </Border.OpacityMask>
                                    </Border>
                                </Border>
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Volumen general"
                                               FontWeight="SemiBold" />
                                    <Slider Minimum="0"
                                            Maximum="100"
                                            TickFrequency="1"
                                            Value="{Binding VolumePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Margin="0,8,12,0"
                                            />
                                </StackPanel>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding VolumeText}"
                                           Foreground="#14B8A6"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right" />
                            </Grid>
                        </Border>

                        <Border Grid.Column="2"
                                Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="54" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="44"
                                        Height="44"
                                        CornerRadius="12"
                                        Background="#18B56CFF"
                                        Tag="StaticBrush">
                                    <Border Width="26"
                                            Height="26"
                                            Background="#B56CFF"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Tag="StaticBrush">
                                        <Border.OpacityMask>
                                            <ImageBrush ImageSource="/Assets/Icons/sound_music.png"
                                                        Stretch="Uniform" />
                                        </Border.OpacityMask>
                                    </Border>
                                </Border>
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Audios guardados"
                                               Style="{StaticResource MutedText}" />
                                    <TextBlock Text="{Binding AssetCountText}"
                                               Foreground="#B56CFF"
                                               FontSize="20"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Column="4"
                                Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="54" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="44"
                                        Height="44"
                                        CornerRadius="12"
                                        Background="#1814B8A6"
                                        Tag="StaticBrush">
                                    <Border Width="26"
                                            Height="26"
                                            Background="#14B8A6"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Tag="StaticBrush">
                                        <Border.OpacityMask>
                                            <ImageBrush ImageSource="/Assets/Icons/sound_group.png"
                                                        Stretch="Uniform" />
                                        </Border.OpacityMask>
                                    </Border>
                                </Border>
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Grupos creados"
                                               Style="{StaticResource MutedText}" />
                                    <TextBlock Text="{Binding GroupCountText}"
                                               Foreground="#14B8A6"
                                               FontSize="20"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Column="6"
                                Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="54" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="44"
                                        Height="44"
                                        CornerRadius="12"
                                        Background="#182FB4E9"
                                        Tag="StaticBrush">
                                    <Border Width="26"
                                            Height="26"
                                            Background="#2FB4E9"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Tag="StaticBrush">
                                        <Border.OpacityMask>
                                            <ImageBrush ImageSource="/Assets/Icons/icon_timer.png"
                                                        Stretch="Uniform" />
                                        </Border.OpacityMask>
                                    </Border>
                                </Border>
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Último audio"
                                               Style="{StaticResource MutedText}" />
                                    <TextBlock Text="{Binding LastAssetText}"
                                               Foreground="#37C7F3"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Biblioteca de audios"
                                           FontSize="18"
                                           Style="{StaticResource TitleText}"
                                           FontWeight="SemiBold" />

                                <Grid Grid.Row="1"
                                      Margin="0,16,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="AudioSearchBox"
                                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0"
                                             ToolTip="Buscar audio por nombre, grupo o alerta" />
                                    <WrapPanel Grid.Column="2">
                                        <Button x:Name="AudioFilterAllButton"
                                                Content="Todos"
                                                Tag="ALL"
                                                Command="{Binding SelectFilterCommand}"
                                                CommandParameter="ALL" />
                                        <Button x:Name="AudioFilterWithAlertButton"
                                                Content="Con alerta"
                                                Tag="WITH_ALERT"
                                                Command="{Binding SelectFilterCommand}"
                                                CommandParameter="WITH_ALERT" />
                                        <Button x:Name="AudioFilterNoGroupButton"
                                                Content="Sin grupo"
                                                Tag="NO_GROUP"
                                                Command="{Binding SelectFilterCommand}"
                                                CommandParameter="NO_GROUP" />
                                    </WrapPanel>
                                </Grid>

                                <Grid Grid.Row="2"
                                      Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="1.35*" />
                                        <ColumnDefinition Width="1.1*" />
                                        <ColumnDefinition Width="82" />
                                        <ColumnDefinition Width="104" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Nombre del audio" Style="{StaticResource MutedText}" />
                                    <TextBlock Grid.Column="1" Text="Alerta asignada" Style="{StaticResource MutedText}" />
                                    <TextBlock Grid.Column="2" Text="Grupo" Style="{StaticResource MutedText}" />
                                    <TextBlock Grid.Column="3" Text="Duración" Style="{StaticResource MutedText}" />
                                    <TextBlock Grid.Column="4" Text="Acciones" Style="{StaticResource MutedText}" />
                                </Grid>

                                <ScrollViewer Grid.Row="3"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl x:Name="AudioLibraryList"
                                                  ItemsSource="{Binding AssetRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource ThemeBorderBrush}"
                                                        BorderThickness="0,1,0,0"
                                                        Padding="0,10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="2*" />
                                                            <ColumnDefinition Width="1.35*" />
                                                            <ColumnDefinition Width="1.1*" />
                                                            <ColumnDefinition Width="82" />
                                                            <ColumnDefinition Width="104" />
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Orientation="Horizontal"
                                                                    VerticalAlignment="Center">
                                                            <Border Width="36"
                                                                    Height="36"
                                                                    CornerRadius="9"
                                                                    Background="#1714B8A6"
                                                                    Margin="0,0,10,0"
                                                                    Tag="StaticBrush">
                                                                <Border Width="21"
                                                                        Height="21"
                                                                        Background="#14B8A6"
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"
                                                                        Tag="StaticBrush">
                                                                    <Border.OpacityMask>
                                                                        <ImageBrush ImageSource="/Assets/Icons/sound_file.png"
                                                                                    Stretch="Uniform" />
                                                                    </Border.OpacityMask>
                                                                </Border>
                                                            </Border>
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>

                                                        <Border Grid.Column="1"
                                                                Visibility="{Binding AssignedAlertVisibility}"
                                                                Background="{Binding AssignedAlertBackground}"
                                                                BorderBrush="{Binding AssignedAlertBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="7"
                                                                Padding="8,5"
                                                                Tag="StaticBrush"
                                                                HorizontalAlignment="Left"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding AssignedAlertText}"
                                                                       Foreground="{Binding AssignedAlertBrush}"
                                                                       FontWeight="SemiBold"
                                                                       FontSize="12"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </Border>

                                                        <ComboBox Grid.Column="2"
                                                                  MinHeight="32"
                                                                  Margin="0"
                                                                  ItemsSource="{Binding DataContext.NewAssetGroupChoices, RelativeSource={RelativeSource AncestorType={x:Type views:NeoTwitchView}}}"
                                                                  DisplayMemberPath="Name"
                                                                  SelectedValuePath="Id"
                                                                  SelectedValue="{Binding GroupId, Mode=OneWay}"
                                                                  Tag="{Binding Id}"
                                                                  DropDownClosed="AudioLibraryGroupBox_DropDownClosed" />
                                                        <TextBlock Grid.Column="3"
                                                                   Text="{Binding DurationText}"
                                                                   VerticalAlignment="Center" />
                                                        <StackPanel Grid.Column="4"
                                                                    Orientation="Horizontal"
                                                                    HorizontalAlignment="Right">
                                                            <Button Width="38"
                                                                    Height="36"
                                                                    Padding="0"
                                                                    Margin="0,0,6,0"
                                                                    Tag="{Binding Id}"
                                                                    ToolTipService.ShowDuration="6000"
                                                                    ToolTip="{Binding PlayToolTip}"
                                                                    Command="{Binding DataContext.PreviewAssetCommand, RelativeSource={RelativeSource AncestorType=views:NeoTwitchView}}"
                                                                    CommandParameter="{Binding Id}">
                                                                <Grid Width="18"
                                                                      Height="18">
                                                                    <Border Background="#14B8A6"
                                                                            Tag="StaticBrush"
                                                                            Visibility="{Binding PlayIconVisibility}">
                                                                        <Border.OpacityMask>
                                                                            <ImageBrush ImageSource="/Assets/Icons/sound_play.png"
                                                                                        Stretch="Uniform" />
                                                                        </Border.OpacityMask>
                                                                    </Border>
                                                                    <Border Background="#14B8A6"
                                                                            Tag="StaticBrush"
                                                                            Visibility="{Binding PauseIconVisibility}">
                                                                        <Border.OpacityMask>
                                                                            <ImageBrush ImageSource="/Assets/Icons/sound_pause.png"
                                                                                        Stretch="Uniform" />
                                                                        </Border.OpacityMask>
                                                                    </Border>
                                                                </Grid>
                                                            </Button>
                                                            <Button Width="38"
                                                                    Height="36"
                                                                    Padding="0"
                                                                    Margin="0"
                                                                    Background="{DynamicResource ThemeInputBrush}"
                                                                    BorderBrush="#F43F5E"
                                                                    Tag="{Binding Id}"
                                                                    ToolTip="Eliminar audio"
                                                                    Command="{Binding DataContext.DeleteAssetCommand, RelativeSource={RelativeSource AncestorType=views:NeoTwitchView}}"
                                                                    CommandParameter="{Binding Id}">
                                                                <Border Width="18"
                                                                        Height="18"
                                                                        Background="#F43F5E"
                                                                        Tag="StaticBrush">
                                                                    <Border.OpacityMask>
                                                                        <ImageBrush ImageSource="/Assets/Icons/icon_delete.png"
                                                                                    Stretch="Uniform" />
                                                                    </Border.OpacityMask>
                                                                </Border>
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <TextBlock Grid.Row="4"
                                           Text="{Binding FooterText}"
                                           Style="{StaticResource MutedText}"
                                           Margin="0,12,0,0" />
                            </Grid>
                        </Border>

                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="3*" />
                                <RowDefinition Height="18" />
                                <RowDefinition Height="2*" />
                            </Grid.RowDefinitions>

                            <Border Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Añadir nuevo audio"
                                               FontSize="18"
                                               Style="{StaticResource TitleText}"
                                               FontWeight="SemiBold" />

                                    <Button Grid.Row="1"
                                            Margin="0,14,0,12"
                                            Padding="14"
                                            Background="{DynamicResource ThemeInputBrush}"
                                            BorderBrush="{DynamicResource ThemeBorderBrush}"
                                            BorderThickness="1"
                                            Command="{Binding BrowseAssetCommand}">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Border Width="38"
                                                    Height="38"
                                                    Background="#14B8A6"
                                                    HorizontalAlignment="Center"
                                                    Tag="StaticBrush">
                                                <Border.OpacityMask>
                                                    <ImageBrush ImageSource="/Assets/Icons/sound_file.png"
                                                                Stretch="Uniform" />
                                                </Border.OpacityMask>
                                            </Border>
                                            <TextBlock Text="Haz clic para seleccionar un archivo de audio"
                                                       Style="{StaticResource MutedText}"
                                                       TextAlignment="Center"
                                                       Margin="0,8,0,0" />
                                        </StackPanel>
                                    </Button>

                                    <ScrollViewer Grid.Row="2"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel>
                                            <TextBlock Text="Archivo seleccionado"
                                                       Style="{StaticResource MutedText}" />
                                            <TextBox Text="{Binding NewAssetPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     IsReadOnly="True" />
                                            <TextBlock Text="Nombre del audio"
                                                       Style="{StaticResource MutedText}" />
                                            <TextBox Text="{Binding NewAssetName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="Nombre corto para reconocerlo en las alertas" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="Alerta asignada"
                                                               Style="{StaticResource MutedText}" />
                                                    <ComboBox ItemsSource="{Binding NewAssetAlertChoices}"
                                                              DisplayMemberPath="Name"
                                                              SelectedValuePath="Id"
                                                              SelectedValue="{Binding NewAssetAlertId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Grupo"
                                                               Style="{StaticResource MutedText}" />
                                                    <ComboBox ItemsSource="{Binding NewAssetGroupChoices}"
                                                              DisplayMemberPath="Name"
                                                              SelectedValuePath="Id"
                                                              SelectedValue="{Binding NewAssetGroupId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                            </Grid>
                                            <Button Style="{StaticResource PrimaryButton}"
                                                    Margin="0,8,0,0"
                                                    Command="{Binding SaveAssetCommand}">
                                                <StackPanel Orientation="Horizontal"
                                                            HorizontalAlignment="Center">
                                                    <Border Width="18"
                                                            Height="18"
                                                            Background="White"
                                                            Tag="StaticBrush">
                                                        <Border.OpacityMask>
                                                            <ImageBrush ImageSource="/Assets/Icons/icon_save.png"
                                                                        Stretch="Uniform" />
                                                        </Border.OpacityMask>
                                                    </Border>
                                                    <TextBlock Text="Guardar audio"
                                                               Foreground="White"
                                                               FontWeight="SemiBold"
                                                               Margin="8,0,0,0"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </Border>

                            <Border Grid.Row="2"
                                    Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Grupos de audio"
                                                       FontSize="18"
                                                       Style="{StaticResource TitleText}"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="Organiza varios audios para usarlos juntos."
                                                       Style="{StaticResource MutedText}" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid Grid.Row="1"
                                          Margin="0,14,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding NewGroupName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0"
                                                 ToolTip="Nombre del nuevo grupo" />
                                        <Button Grid.Column="2"
                                                Content="Crear"
                                                Style="{StaticResource PrimaryButton}"
                                                MinWidth="92"
                                                Margin="0"
                                                Command="{Binding AddGroupCommand}" />
                                    </Grid>

                                    <ScrollViewer Grid.Row="2"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl x:Name="AudioGroupsList"
                                                      ItemsSource="{Binding GroupRows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{DynamicResource ThemeBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="10"
                                                            Padding="12"
                                                            Margin="0,0,0,8"
                                                            Background="{DynamicResource ThemeInputBrush}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="36" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="84" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Width="24"
                                                                    Height="24"
                                                                    Background="{Binding AccentBrush}"
                                                                    Tag="StaticBrush">
                                                                <Border.OpacityMask>
                                                                    <ImageBrush ImageSource="/Assets/Icons/sound_group.png"
                                                                                Stretch="Uniform" />
                                                                </Border.OpacityMask>
                                                            </Border>
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding Name}"
                                                                       FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       VerticalAlignment="Center" />
                                                            <Border Grid.Column="2"
                                                                    CornerRadius="10"
                                                                    Padding="10,4"
                                                                    Background="#2214B8A6"
                                                                    Tag="StaticBrush">
                                                                <TextBlock Text="{Binding CountText}"
                                                                           Foreground="#14B8A6"
                                                                           FontWeight="SemiBold"
                                                                           FontSize="12" />
                                                            </Border>
                                                            <StackPanel Grid.Column="3"
                                                                        Orientation="Horizontal"
                                                                        HorizontalAlignment="Right"
                                                                        Margin="8,0,0,0">
                                                                <Button Width="34"
                                                                        Height="32"
                                                                        Padding="0"
                                                                        Margin="0,0,6,0"
                                                                        Tag="{Binding Id}"
                                                                        ToolTip="Ver audios del grupo"
                                                                        Command="{Binding DataContext.ViewGroupCommand, RelativeSource={RelativeSource AncestorType=views:NeoTwitchView}}"
                                                                        CommandParameter="{Binding Id}">
                                                                    <Path Width="15"
                                                                          Height="15"
                                                                          Stretch="Uniform"
                                                                          Stroke="{Binding AccentBrush}"
                                                                          StrokeThickness="2"
                                                                          StrokeStartLineCap="Round"
                                                                          StrokeEndLineCap="Round"
                                                                          Data="M10.5,5 A5.5,5.5 0 1 1 10.5,16 A5.5,5.5 0 1 1 10.5,5 M15,15 L21,21" />
                                                                </Button>
                                                                <Button Width="34"
                                                                        Height="32"
                                                                        Padding="0"
                                                                        Margin="0"
                                                                        Background="{DynamicResource ThemeInputBrush}"
                                                                        BorderBrush="#F43F5E"
                                                                        Tag="{Binding Id}"
                                                                        ToolTip="Eliminar grupo"
                                                                        Command="{Binding DataContext.DeleteGroupCommand, RelativeSource={RelativeSource AncestorType=views:NeoTwitchView}}"
                                                                        CommandParameter="{Binding Id}">
                                                                    <Border Width="16"
                                                                            Height="16"
                                                                            Background="#F43F5E"
                                                                            Tag="StaticBrush">
                                                                        <Border.OpacityMask>
                                                                            <ImageBrush ImageSource="/Assets/Icons/icon_delete.png"
                                                                                        Stretch="Uniform" />
                                                                        </Border.OpacityMask>
                                                                    </Border>
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
</views:NeoTwitchView>
