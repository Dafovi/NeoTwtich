<Window x:Class="NeoTwitch.Views.ColorPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Selector de color"
        Width="780"
        Height="520"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Background="Transparent"
        AllowsTransparency="True">
    <Window.Resources>
        <SolidColorBrush x:Key="ColorPickerWindowBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="ColorPickerTitleBarBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="ColorPickerInputBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ColorPickerButtonBrush" Color="#EEF2F6" />
        <SolidColorBrush x:Key="ColorPickerBorderBrush" Color="#CBD5E1" />
        <SolidColorBrush x:Key="ColorPickerTextBrush" Color="#0F172A" />
        <SolidColorBrush x:Key="ColorPickerMutedTextBrush" Color="#475569" />
        <SolidColorBrush x:Key="ColorPickerAccentBrush" Color="#14B8A6" />

        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource ColorPickerTextBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        </Style>

        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource ColorPickerInputBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ColorPickerTextBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource ColorPickerTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ColorPickerBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="{DynamicResource ColorPickerTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource ColorPickerButtonBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ColorPickerBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonFrame"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonFrame" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonFrame" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonFrame" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootCard"
            CornerRadius="18"
            BorderThickness="1"
            Background="{DynamicResource ColorPickerWindowBrush}"
            BorderBrush="{DynamicResource ColorPickerBorderBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border x:Name="TitleBar"
                    Height="48"
                    BorderThickness="0,0,0,1"
                    Background="{DynamicResource ColorPickerTitleBarBrush}"
                    BorderBrush="{DynamicResource ColorPickerBorderBrush}"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <TextBlock x:Name="DialogTitleText"
                               Text="Selector de color"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Margin="18,0,0,0"
                               VerticalAlignment="Center" />

                    <Button x:Name="CloseButton"
                            Width="46"
                            Height="46"
                            Padding="0"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Foreground="{DynamicResource ColorPickerMutedTextBrush}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Click="CancelButton_Click">
                        <Grid Width="14"
                              Height="14">
                            <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Data="M 1 1 L 13 13 M 13 1 L 1 13" />
                        </Grid>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1"
                  Margin="24,16,24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="390" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Canvas x:Name="ColorCanvas"
                        Width="390"
                        Height="260"
                        ClipToBounds="False"
                        MouseDown="ColorCanvas_MouseDown"
                        MouseMove="ColorCanvas_MouseMove"
                        MouseUp="PickerCanvas_MouseUp">
                    <Rectangle x:Name="HueSurface"
                               Width="390"
                               Height="260"
                               RadiusX="9"
                               RadiusY="9" />
                    <Rectangle Width="390"
                               Height="260"
                               RadiusX="9"
                               RadiusY="9">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0"
                                                 EndPoint="1,0">
                                <GradientStop Color="#FFFFFFFF"
                                              Offset="0" />
                                <GradientStop Color="#00FFFFFF"
                                              Offset="1" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Rectangle Width="390"
                               Height="260"
                               RadiusX="9"
                               RadiusY="9">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0"
                                                 EndPoint="0,1">
                                <GradientStop Color="#00000000"
                                              Offset="0" />
                                <GradientStop Color="#FF000000"
                                              Offset="1" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Ellipse x:Name="ColorThumb"
                             Width="22"
                             Height="22"
                             Stroke="White"
                             StrokeThickness="3"
                             Fill="Transparent" />
                </Canvas>

                <Canvas x:Name="HueCanvas"
                        Grid.Column="2"
                        Width="42"
                        Height="260"
                        ClipToBounds="False"
                        MouseDown="HueCanvas_MouseDown"
                        MouseMove="HueCanvas_MouseMove"
                        MouseUp="PickerCanvas_MouseUp">
                    <Border Width="42"
                            Height="260"
                            CornerRadius="10">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0"
                                                 EndPoint="0,1">
                                <GradientStop Color="#FFFF0000"
                                              Offset="0.00" />
                                <GradientStop Color="#FFFF00FF"
                                              Offset="0.17" />
                                <GradientStop Color="#FF0000FF"
                                              Offset="0.33" />
                                <GradientStop Color="#FF00FFFF"
                                              Offset="0.50" />
                                <GradientStop Color="#FF00FF00"
                                              Offset="0.67" />
                                <GradientStop Color="#FFFFFF00"
                                              Offset="0.83" />
                                <GradientStop Color="#FFFF0000"
                                              Offset="1.00" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Border x:Name="HueThumb"
                            Width="52"
                            Height="7"
                            CornerRadius="3"
                            Background="#FFFFFFFF"
                            BorderBrush="{DynamicResource ColorPickerBorderBrush}"
                            BorderThickness="1"
                            Canvas.Left="-5" />
                </Canvas>

                <StackPanel Grid.Column="4">
                    <TextBlock Text="Vista previa"
                               FontSize="18"
                               Margin="0,0,0,12" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="70" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Nuevo"
                                   FontSize="17"
                                   VerticalAlignment="Center" />
                        <Border x:Name="NewColorPreview"
                                Grid.Column="1"
                                Width="60"
                                Height="40"
                                CornerRadius="8" />
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="70" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Actual"
                                   FontSize="17"
                                   VerticalAlignment="Center" />
                        <Border x:Name="CurrentColorPreview"
                                Grid.Column="1"
                                Width="60"
                                Height="40"
                                CornerRadius="8" />
                    </Grid>

                    <TextBlock Text="HEX"
                               FontSize="16"
                               Margin="0,0,0,6" />
                    <TextBox x:Name="HexBox"
                             FontSize="16"
                             TextChanged="HexBox_TextChanged" />

                    <TextBlock Text="RGB"
                               FontSize="16"
                               Margin="0,10,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <TextBox x:Name="RedBox"
                                     Padding="26,0,6,0"
                                     FontSize="15"
                                     TextChanged="RgbBox_TextChanged" />
                            <TextBlock Text="R"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False" />
                        </Grid>
                        <Grid Grid.Column="2">
                            <TextBox x:Name="GreenBox"
                                     Padding="26,0,6,0"
                                     FontSize="15"
                                     TextChanged="RgbBox_TextChanged" />
                            <TextBlock Text="G"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False" />
                        </Grid>
                        <Grid Grid.Column="4">
                            <TextBox x:Name="BlueBox"
                                     Padding="26,0,6,0"
                                     FontSize="15"
                                     TextChanged="RgbBox_TextChanged" />
                            <TextBlock Text="B"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False" />
                        </Grid>
                    </Grid>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2"
                  Margin="24,14,24,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border x:Name="Divider"
                        Height="1"
                        Opacity="0.35"
                        Background="{DynamicResource ColorPickerBorderBrush}"
                        Margin="0,0,0,10" />
                <TextBlock Grid.Row="1"
                           Text="Colores recientes"
                           FontSize="16"
                           Margin="0,0,0,8" />
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="138" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="200" />
                    </Grid.ColumnDefinitions>
                    <WrapPanel x:Name="RecentColorsPanel"
                               VerticalAlignment="Center" />
                    <Button x:Name="CancelDialogButton"
                            Grid.Column="1"
                            Height="48"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Background="{DynamicResource ColorPickerButtonBrush}"
                            BorderBrush="{DynamicResource ColorPickerBorderBrush}"
                            Foreground="{DynamicResource ColorPickerTextBrush}"
                            Click="CancelButton_Click">
                        <TextBlock x:Name="CancelButtonText"
                                   Text="Cancelar"
                                   Foreground="{DynamicResource ColorPickerTextBrush}"
                                   FontWeight="SemiBold" />
                    </Button>
                    <Button x:Name="ApplyColorButton"
                            Grid.Column="3"
                            Height="48"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Background="{DynamicResource ColorPickerAccentBrush}"
                            BorderBrush="{DynamicResource ColorPickerAccentBrush}"
                            Foreground="White"
                            Click="ApplyButton_Click">
                        <TextBlock x:Name="ApplyButtonText"
                                   Text="Aplicar color"
                                   Foreground="White"
                                   FontWeight="SemiBold" />
                    </Button>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
