<views:NeoTwitchView x:Class="NeoTwitch.Views.LightsView"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     xmlns:views="clr-namespace:NeoTwitch.Views"
                     mc:Ignorable="d">
                    <Grid Margin="24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0" />
                            <ColumnDefinition Width="0" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,18">
                            <TextBlock Text="Luces de fondo"
                                       FontSize="28"
                                       Style="{StaticResource TitleText}"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Define los pines, cantidad de LEDs y el fondo del stream."
                                       Style="{StaticResource MutedText}"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <Border Grid.Row="1"
                                Grid.Column="0"
                                Style="{StaticResource Card}">
                            <DockPanel>
                                <StackPanel x:Name="StripActionsPanel"
                                            DockPanel.Dock="Bottom"
                                            Margin="0,12,0,0">
                                    <WrapPanel>
                                        <Button Content="Nueva" Command="{Binding AddStripCommand}" />
                                        <Button Content="Duplicar" Command="{Binding DuplicateStripCommand}" />
                                        <Button Content="Eliminar"
                                                Style="{StaticResource DangerButton}"
                                                Command="{Binding RemoveStripCommand}" />
                                    </WrapPanel>
                                </StackPanel>

                                <StackPanel DockPanel.Dock="Top">
                                    <TextBlock Text="Salidas"
                                               FontSize="18"
                                               Style="{StaticResource TitleText}"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,10" />
                                    <Button x:Name="ArduinoOutputButton"
                                            Content="Arduino Tira led ws2812b"
                                            HorizontalContentAlignment="Left"
                                            Margin="0,0,0,8"
                                            ToolTip="Configura las tiras NeoPixel conectadas al Arduino." />
                                    <Button x:Name="AlexaOutputButton"
                                            Content="Alexa"
                                            HorizontalContentAlignment="Left"
                                            Margin="0,0,0,12"
                                            ToolTip="Configura el fondo que se envia al relay de Alexa." />
                                    <TextBlock x:Name="StripsListLabel"
                                               Text="Tiras LED"
                                               Style="{StaticResource MutedText}"
                                               Margin="0,0,0,6" />
                                </StackPanel>

                                <ListBox x:Name="LegacyStripsList"
                                         BorderBrush="{DynamicResource ThemeBorderBrush}"
                                         MinHeight="220"
                                         SelectionChanged="StripsList_SelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="9" Margin="2,3" CornerRadius="7">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding DisplayLabel}"
                                                               Style="{StaticResource MutedText}"
                                                               FontSize="12"
                                                               TextTrimming="CharacterEllipsis"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>

                        <Border Grid.Row="1"
                                Grid.Column="2"
                                Style="{StaticResource Card}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="ArduinoBackgroundPanel">
                                    <StackPanel x:Name="StripEditorPanel"
                                                IsEnabled="{Binding IsStripEditorEnabled}">
                                        <TextBlock Text="Pines de salida"
                                                   FontSize="18"
                                                   Style="{StaticResource TitleText}"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,12" />

                                        <ListBox x:Name="StripsList"
                                                 ItemsSource="{Binding LedStripsView}"
                                                 BorderBrush="{DynamicResource ThemeBorderBrush}"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 MaxHeight="150"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 SelectionChanged="StripsList_SelectionChanged">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{DynamicResource ThemeBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="12"
                                                            Padding="10"
                                                            Margin="0,0,0,8"
                                                            Background="{DynamicResource ThemeInputBrush}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="42" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Image Source="/Assets/Icons/service_arduino.png"
                                                                   Width="26"
                                                                   Height="26"
                                                                   Stretch="Uniform"
                                                                   VerticalAlignment="Center" />
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="{Binding Name}"
                                                                           FontWeight="SemiBold"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding DisplayLabel}"
                                                                           Style="{StaticResource MutedText}"
                                                                           FontSize="12"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <TextBlock Text="Nombre" Style="{StaticResource MutedText}" />
                                        <TextBox x:Name="StripNameBox"
                                                 Text="{Binding SelectedStripName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 TextChanged="StripFieldChanged" />

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Pin Arduino" Style="{StaticResource MutedText}" />
                                                <TextBox x:Name="StripPinBox"
                                                         Text="{Binding SelectedStripPinText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         TextChanged="StripFieldChanged"
                                                         ToolTip="Pin digital donde esta conectado DIN de la tira." />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Cantidad de LEDs" Style="{StaticResource MutedText}" />
                                                <TextBox x:Name="StripLedCountBox"
                                                         Text="{Binding SelectedStripLedCountText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         TextChanged="StripFieldChanged" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>

                                <Separator Margin="0,16,0,16" />

                                <TextBlock Text="Fondo"
                                           FontSize="18"
                                           Style="{StaticResource TitleText}"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,12" />
                                <CheckBox x:Name="BackgroundEnabledCheck"
                                          Content="Mantener luces de fondo"
                                          IsChecked="{Binding BackgroundEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Checked="BackgroundFieldChanged"
                                          Unchecked="BackgroundFieldChanged" />

                                <TextBlock x:Name="BackgroundPinsLabel"
                                           Text="Pines de fondo"
                                           Style="{StaticResource MutedText}"
                                           Visibility="Collapsed" />
                                <TextBox x:Name="BackgroundPinsBox"
                                         Text="{Binding BackgroundTargetPins, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         TextChanged="BackgroundFieldChanged"
                                         ToolTip="Dejalo vacio para usar todas las tiras."
                                         Visibility="Collapsed" />

                                <StackPanel x:Name="BackgroundPatternGrid">
                                    <StackPanel>
                                        <TextBlock Text="Patron de fondo" Style="{StaticResource MutedText}" />
                                        <ComboBox x:Name="BackgroundPatternBox"
                                                  ItemsSource="{Binding BackgroundPatternChoices}"
                                                  DisplayMemberPath="Label"
                                                  SelectedValuePath="Value"
                                                  Visibility="Collapsed"
                                                  SelectedValue="{Binding BackgroundPattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  SelectionChanged="BackgroundFieldChanged" />
                                        <Grid Margin="0,4,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="70" />
                                                <RowDefinition Height="8" />
                                                <RowDefinition Height="70" />
                                                <RowDefinition Height="8" />
                                                <RowDefinition Height="70" />
                                            </Grid.RowDefinitions>

                                            <Button x:Name="BackgroundPatternSolidTileButton"
                                                    Tag="Solid"
                                                    Command="{Binding SelectBackgroundPatternCommand}"
                                                    CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <Rectangle Width="22"
                                                               Height="22"
                                                               Margin="0,0,0,6"
                                                               Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                                                        <Rectangle.OpacityMask>
                                                            <ImageBrush ImageSource="/Assets/Icons/lights_fx_static.png"
                                                                        Stretch="Uniform" />
                                                        </Rectangle.OpacityMask>
                                                    </Rectangle>
                                                    <TextBlock Text="Fijo" FontSize="12" FontWeight="SemiBold" TextAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="BackgroundPatternPulseTileButton"
                                                    Grid.Column="2"
                                                    Tag="Pulse"
                                                    Command="{Binding SelectBackgroundPatternCommand}"
                                                    CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <Rectangle Width="22"
                                                               Height="22"
                                                               Margin="0,0,0,6"
                                                               Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                                                        <Rectangle.OpacityMask>
                                                            <ImageBrush ImageSource="/Assets/Icons/lights_fx_pulse.png"
                                                                        Stretch="Uniform" />
                                                        </Rectangle.OpacityMask>
                                                    </Rectangle>
                                                    <TextBlock Text="Pulso" FontSize="12" FontWeight="SemiBold" TextAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="BackgroundPatternRainbowTileButton"
                                                    Grid.Column="4"
                                                    Tag="Rainbow"
                                                    Command="{Binding SelectBackgroundPatternCommand}"
                                                    CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <Rectangle Width="22"
                                                               Height="22"
                                                               Margin="0,0,0,6"
                                                               Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                                                        <Rectangle.OpacityMask>
                                                            <ImageBrush ImageSource="/Assets/Icons/lights_fx_rainbow.png"
                                                                        Stretch="Uniform" />
                                                        </Rectangle.OpacityMask>
                                                    </Rectangle>
                                                    <TextBlock Text="Arcoiris" FontSize="12" FontWeight="SemiBold" TextAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="BackgroundPatternChaseTileButton"
                                                    Grid.Row="2"
                                                    Tag="Chase"
                                                    Command="{Binding SelectBackgroundPatternCommand}"
                                                    CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <Rectangle Width="22"
                                                               Height="22"
                                                               Margin="0,0,0,6"
                                                               Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                                                        <Rectangle.OpacityMask>
                                                            <ImageBrush ImageSource="/Assets/Icons/lights_fx_wave.png"
                                                                        Stretch="Uniform" />
                                                        </Rectangle.OpacityMask>
                                                    </Rectangle>
                                                    <TextBlock Text="Carrera" FontSize="12" FontWeight="SemiBold" TextAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="BackgroundPatternTheaterTileButton"
                                                    Grid.Row="2"
                                                    Grid.Column="2"
                                                    Tag="Theater"
                                                    Command="{Binding SelectBackgroundPatternCommand}"
                                                    CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <Rectangle Width="22"
                                                               Height="22"
                                                               Margin="0,0,0,6"
                                                               Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                                                        <Rectangle.OpacityMask>
                                                            <ImageBrush ImageSource="/Assets/Icons/lights_fx_breathe.png"
                                                                        Stretch="Uniform" />
                                                        </Rectangle.OpacityMask>
                                                    </Rectangle>
                                                    <TextBlock Text="Teatro" FontSize="12" FontWeight="SemiBold" TextAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="BackgroundPatternSparkleTileButton"
                                                    Grid.Row="2"
                                                    Grid.Column="4"
                                                    Tag="Sparkle"
                                                    Command="{Binding SelectBackgroundPatternCommand}"
                                                    CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <Rectangle Width="22"
                                                               Height="22"
                                                               Margin="0,0,0,6"
                                                               Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                                                        <Rectangle.OpacityMask>
                                                            <ImageBrush ImageSource="/Assets/Icons/activity_notification_lime.png"
                                                                        Stretch="Uniform" />
                                                        </Rectangle.OpacityMask>
                                                    </Rectangle>
                                                    <TextBlock Text="Destellos" FontSize="12" FontWeight="SemiBold" TextAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="BackgroundPatternRaveTileButton"
                                                    Grid.Row="4"
                                                    Grid.ColumnSpan="5"
                                                    Tag="Rave"
                                                    Command="{Binding SelectBackgroundPatternCommand}"
                                                    CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <Rectangle Width="22"
                                                               Height="22"
                                                               Margin="0,0,0,6"
                                                               Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                                                        <Rectangle.OpacityMask>
                                                            <ImageBrush ImageSource="/Assets/Icons/lights_fx_rave.png"
                                                                        Stretch="Uniform" />
                                                        </Rectangle.OpacityMask>
                                                    </Rectangle>
                                                    <TextBlock Text="Rave" FontSize="12" FontWeight="SemiBold" TextAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Margin="0,10,0,6">
                                    <Grid x:Name="BackgroundColorOptionsGrid"
                                          MinWidth="0"
                                          HorizontalAlignment="Stretch"
                                          Margin="0,0,0,12">
                                        <Border BorderBrush="{DynamicResource ThemeBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="14"
                                                Padding="12"
                                                Background="{DynamicResource ThemeSurfaceBrush}">
                                            <StackPanel>
                                                <TextBlock Text="Colores de fondo"
                                                           FontWeight="SemiBold"
                                                           Margin="0,0,0,10" />
                                                <TextBlock x:Name="BackgroundPrimaryColorLabel"
                                                           Text="Color principal"
                                                           Style="{StaticResource MutedText}" />
                                                <DockPanel x:Name="BackgroundPrimaryColorPanel"
                                                           LastChildFill="True"
                                                           Margin="0,4,0,10">
                                                    <Button x:Name="BackgroundPrimaryColorButton"
                                                            DockPanel.Dock="Left"
                                                            Width="38"
                                                            Margin="0,0,10,0"
                                                            ToolTip="Escoger color"
                                                            Tag="Primary"
                                                            Command="{Binding PickBackgroundLightColorCommand}"
                                                            CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}" />
                                                    <Button Content="Editar color"
                                                            DockPanel.Dock="Right"
                                                            MinWidth="104"
                                                            Margin="10,0,0,0"
                                                            Tag="Primary"
                                                            Command="{Binding PickBackgroundLightColorCommand}"
                                                            CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}" />
                                                    <TextBox x:Name="BackgroundPrimaryColorBox"
                                                             Margin="0"
                                                             Text="{Binding BackgroundPrimaryColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             TextChanged="BackgroundFieldChanged" />
                                                </DockPanel>

                                                <TextBlock x:Name="BackgroundSecondaryColorLabel"
                                                           Text="Color secundario"
                                                           Style="{StaticResource MutedText}" />
                                                <DockPanel x:Name="BackgroundSecondaryColorPanel"
                                                           LastChildFill="True"
                                                           Margin="0,4,0,10">
                                                    <Button x:Name="BackgroundSecondaryColorButton"
                                                            DockPanel.Dock="Left"
                                                            Width="38"
                                                            Margin="0,0,10,0"
                                                            ToolTip="Escoger color"
                                                            Tag="Secondary"
                                                            Command="{Binding PickBackgroundLightColorCommand}"
                                                            CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}" />
                                                    <Button Content="Editar color"
                                                            DockPanel.Dock="Right"
                                                            MinWidth="104"
                                                            Margin="10,0,0,0"
                                                            Tag="Secondary"
                                                            Command="{Binding PickBackgroundLightColorCommand}"
                                                            CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}" />
                                                    <TextBox x:Name="BackgroundSecondaryColorBox"
                                                             Margin="0"
                                                             Text="{Binding BackgroundSecondaryColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             TextChanged="BackgroundFieldChanged" />
                                                </DockPanel>

                                                <TextBlock x:Name="BackgroundTertiaryColorLabel"
                                                           Text="Tercer color"
                                                           Style="{StaticResource MutedText}" />
                                                <DockPanel x:Name="BackgroundTertiaryColorPanel"
                                                           LastChildFill="True"
                                                           Margin="0,4,0,0">
                                                    <Button x:Name="BackgroundTertiaryColorButton"
                                                            DockPanel.Dock="Left"
                                                            Width="38"
                                                            Margin="0,0,10,0"
                                                            ToolTip="Escoger color"
                                                            Tag="Tertiary"
                                                            Command="{Binding PickBackgroundLightColorCommand}"
                                                            CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}" />
                                                    <Button Content="Editar color"
                                                            DockPanel.Dock="Right"
                                                            MinWidth="104"
                                                            Margin="10,0,0,0"
                                                            Tag="Tertiary"
                                                            Command="{Binding PickBackgroundLightColorCommand}"
                                                            CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}" />
                                                    <TextBox x:Name="BackgroundTertiaryColorBox"
                                                             Margin="0"
                                                             Text="{Binding BackgroundTertiaryColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             TextChanged="BackgroundFieldChanged" />
                                                </DockPanel>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Grid x:Name="BackgroundBrightnessPanel"
                                          MinWidth="0"
                                          HorizontalAlignment="Stretch"
                                          Margin="0,0,0,12">
                                        <Border BorderBrush="{DynamicResource ThemeBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="14"
                                                Padding="14"
                                                Background="{DynamicResource ThemeSurfaceBrush}">
                                            <Grid MinHeight="174">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="104" />
                                                    <RowDefinition Height="18" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Slider x:Name="BackgroundBrightnessSlider"
                                                        Minimum="0"
                                                        Maximum="255"
                                                        TickFrequency="1"
                                                        Visibility="Collapsed"
                                                        Value="{Binding BackgroundBrightness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        ValueChanged="BackgroundFieldChanged" />
                                                <Grid Height="104"
                                                      Grid.Row="0"
                                                      HorizontalAlignment="Center">
                                                    <Ellipse Width="104"
                                                             Height="104"
                                                             Stroke="#3014B8A6"
                                                             StrokeThickness="12"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Top" />
                                                    <Path x:Name="BackgroundBrightnessArc"
                                                          Stroke="#14B8A6"
                                                          StrokeThickness="12"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          Width="104"
                                                          Height="104"
                                                          Stretch="None"
                                                          Fill="Transparent"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Top" />
                                                    <TextBlock x:Name="BackgroundBrightnessValueText"
                                                               FontSize="24"
                                                               FontWeight="SemiBold"
                                                               Margin="0,36,0,0"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Top" />
                                                </Grid>
                                                <StackPanel Orientation="Horizontal"
                                                            Grid.Row="2"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Top">
                                                    <Button Content="-"
                                                            Width="34"
                                                            Height="30"
                                                            Margin="0,0,6,0"
                                                            Tag="Brightness:-15"
                                                            Command="{Binding AdjustBackgroundLightValueCommand}"
                                                            CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}" />
                                                    <Button Content="+"
                                                            Width="34"
                                                            Height="30"
                                                            Tag="Brightness:15"
                                                            Command="{Binding AdjustBackgroundLightValueCommand}"
                                                            CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </StackPanel>

                                <TextBlock Text="Tiempos de fondo"
                                           FontWeight="SemiBold"
                                           Margin="0,4,0,8" />
                                <WrapPanel Margin="0,0,0,12">
                                    <Grid x:Name="BackgroundCycleGrid"
                                          MinWidth="220"
                                          Width="250"
                                          Margin="0,0,10,10">
                                        <Border BorderBrush="{DynamicResource ThemeBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="12"
                                                Padding="10"
                                                Background="{DynamicResource ThemeSurfaceBrush}">
                                            <StackPanel>
                                                <TextBlock Text="Delay de fondo"
                                                           Style="{StaticResource MutedText}" />
                                                <DockPanel Margin="0,8,0,8">
                                                    <Button Content="-"
                                                            DockPanel.Dock="Left"
                                                            Width="32"
                                                            Tag="Cycle:-10"
                                                            Command="{Binding AdjustBackgroundLightValueCommand}"
                                                            CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}" />
                                                    <Button Content="+"
                                                            DockPanel.Dock="Right"
                                                            Width="32"
                                                            Tag="Cycle:10"
                                                            Command="{Binding AdjustBackgroundLightValueCommand}"
                                                            CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}" />
                                                    <StackPanel Orientation="Horizontal"
                                                                HorizontalAlignment="Center"
                                                                MinWidth="106">
                                                        <TextBox x:Name="BackgroundCycleValueText"
                                                                 Width="70"
                                                                 TextAlignment="Center"
                                                                 FontWeight="SemiBold"
                                                                 TextChanged="BackgroundLightNumberBox_TextChanged" />
                                                        <Border BorderBrush="{DynamicResource ThemeBorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="6"
                                                                Padding="8,0"
                                                                Margin="4,0,0,0">
                                                            <TextBlock Text="ms"
                                                                       VerticalAlignment="Center"
                                                                       Style="{StaticResource MutedText}" />
                                                        </Border>
                                                    </StackPanel>
                                                </DockPanel>
                                                <Slider x:Name="BackgroundCycleSlider"
                                                        Minimum="10"
                                                        Maximum="2000"
                                                        TickFrequency="10"
                                                        Visibility="Collapsed"
                                                        Value="{Binding BackgroundCycleMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        ValueChanged="BackgroundFieldChanged" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <Grid x:Name="BackgroundStepGrid"
                                          MinWidth="220"
                                          Width="250"
                                          Margin="0,0,10,10">
                                        <Border BorderBrush="{DynamicResource ThemeBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="12"
                                                Padding="10"
                                                Background="{DynamicResource ThemeSurfaceBrush}">
                                            <StackPanel>
                                                <TextBlock Text="Duracion del paso de fondo"
                                                           Style="{StaticResource MutedText}" />
                                                <DockPanel Margin="0,8,0,8">
                                                    <Button Content="-"
                                                            DockPanel.Dock="Left"
                                                            Width="32"
                                                            Tag="Step:-10"
                                                            Command="{Binding AdjustBackgroundLightValueCommand}"
                                                            CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}" />
                                                    <Button Content="+"
                                                            DockPanel.Dock="Right"
                                                            Width="32"
                                                            Tag="Step:10"
                                                            Command="{Binding AdjustBackgroundLightValueCommand}"
                                                            CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}" />
                                                    <StackPanel Orientation="Horizontal"
                                                                HorizontalAlignment="Center"
                                                                MinWidth="106">
                                                        <TextBox x:Name="BackgroundStepValueText"
                                                                 Width="70"
                                                                 TextAlignment="Center"
                                                                 FontWeight="SemiBold"
                                                                 TextChanged="BackgroundLightNumberBox_TextChanged" />
                                                        <Border BorderBrush="{DynamicResource ThemeBorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="6"
                                                                Padding="8,0"
                                                                Margin="4,0,0,0">
                                                            <TextBlock Text="ms"
                                                                       VerticalAlignment="Center"
                                                                       Style="{StaticResource MutedText}" />
                                                        </Border>
                                                    </StackPanel>
                                                </DockPanel>
                                                <Slider x:Name="BackgroundStepSlider"
                                                        Minimum="10"
                                                        Maximum="5000"
                                                        TickFrequency="10"
                                                        Visibility="Collapsed"
                                                        Value="{Binding BackgroundStepMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        ValueChanged="BackgroundFieldChanged" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <Border BorderBrush="{DynamicResource ThemeBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="10"
                                            MinWidth="260"
                                            Margin="0,0,10,10"
                                            Background="{DynamicResource ThemeSurfaceBrush}">
                                        <StackPanel>
                                            <TextBlock Text="Presets rapidos"
                                                       Style="{StaticResource MutedText}"
                                                       Margin="0,0,0,8" />
                                            <UniformGrid Columns="3">
                                                <Button Content="Suave"
                                                        Tag="Soft"
                                                        Command="{Binding SelectBackgroundLightPresetCommand}"
                                                        CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}" />
                                                <Button Content="Medio"
                                                        Tag="Medium"
                                                        Command="{Binding SelectBackgroundLightPresetCommand}"
                                                        CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}" />
                                                <Button Content="Rapido"
                                                        Tag="Fast"
                                                        Command="{Binding SelectBackgroundLightPresetCommand}"
                                                        CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}" />
                                            </UniformGrid>
                                        </StackPanel>
                                    </Border>
                                </WrapPanel>

                                <TextBlock Text="Simulacion"
                                           FontWeight="SemiBold"
                                           Margin="0,8,0,6" />
                                <Border x:Name="BackgroundLedPreviewPanel"
                                        BorderBrush="{DynamicResource ThemeBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="10"
                                        Background="{DynamicResource ThemeSurfaceBrush}"
                                        IsVisibleChanged="BackgroundLedPreviewPanel_IsVisibleChanged">
                                    <ItemsControl x:Name="BackgroundLedPreviewList"
                                                  ItemsSource="{Binding BackgroundLedPreviewDots}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Ellipse Width="16"
                                                         Height="16"
                                                         Fill="{Binding Fill}"
                                                         Stroke="#80FFFFFF"
                                                         StrokeThickness="1"
                                                         Margin="4">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect Color="{Binding GlowColor}"
                                                                          BlurRadius="{Binding GlowRadius}"
                                                                          ShadowDepth="0"
                                                                          Opacity="{Binding GlowOpacity}" />
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>

                                <WrapPanel Margin="0,8,0,0">
                                    <Button x:Name="ApplyArduinoBackgroundButton"
                                            Content="Aplicar cambios a Arduino"
                                            Style="{StaticResource PrimaryButton}"
                                            MinWidth="210"
                                            Command="{Binding ApplyBackgroundCommand}" />
                                    <Button Content="Apagar tiras"
                                            Style="{StaticResource DangerButton}"
                                            Command="{Binding StopBackgroundCommand}" />
                                    <Button Content="Borrar salida"
                                            Style="{StaticResource DangerButton}"
                                            Command="{Binding RemoveStripCommand}" />
                                </WrapPanel>

                                <Border BorderBrush="{DynamicResource ThemeBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="14"
                                        Margin="0,18,0,0"
                                        Background="{DynamicResource ThemeInputBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Nueva salida de pin"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="Agrega otro pin digital para controlar otra tira desde el mismo Arduino."
                                                       Style="{StaticResource MutedText}"
                                                       FontSize="12"
                                                       TextWrapping="Wrap"
                                                       Margin="0,3,16,0" />
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Content="Agregar pin"
                                                Style="{StaticResource PrimaryButton}"
                                                VerticalAlignment="Center"
                                                Command="{Binding AddStripCommand}" />
                                    </Grid>
                                </Border>

                                <Grid Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border BorderBrush="{DynamicResource ThemeBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="14"
                                            Background="{DynamicResource ThemeInputBrush}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="46" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Image Source="/Assets/Icons/nav_arduino.png"
                                                   Width="30"
                                                   Height="30"
                                                   Stretch="Uniform"
                                                   VerticalAlignment="Top" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Sketch"
                                                           FontWeight="SemiBold"
                                                           FontSize="15" />
                                                <TextBlock Text="Tu Arduino necesita el sketch instalado para funcionar con Neo Twitch."
                                                           Style="{StaticResource MutedText}"
                                                           TextWrapping="Wrap"
                                                           FontSize="12"
                                                           Margin="0,4,0,10" />
                                                <WrapPanel>
                                                    <Button Content="Descargar ultimo sketch"
                                                            Style="{StaticResource PrimaryButton}"
                                                            Command="{Binding OpenSketchCommand}" />
                                                    <Button Content="Ver guia"
                                                            Command="{Binding OpenGuideCommand}" />
                                                </WrapPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Border Grid.Column="2"
                                            BorderBrush="{DynamicResource ThemeBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="14"
                                            Background="{DynamicResource ThemeInputBrush}">
                                        <StackPanel>
                                            <TextBlock Text="Estado actual"
                                                       FontWeight="SemiBold"
                                                       FontSize="15"
                                                       Margin="0,0,0,8" />
                                            <Grid Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Dispositivo" Style="{StaticResource MutedText}" />
                                                <TextBlock x:Name="LightsArduinoDeviceText"
                                                           Grid.Column="1"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding ArduinoDeviceText}" />
                                            </Grid>
                                            <Grid Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Puerto actual" Style="{StaticResource MutedText}" />
                                                <TextBlock x:Name="LightsArduinoPortText"
                                                           Grid.Column="1"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding ArduinoPortText}" />
                                            </Grid>
                                            <Grid Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="LEDs configurados" Style="{StaticResource MutedText}" />
                                                <TextBlock x:Name="LightsArduinoLedCountText"
                                                           Grid.Column="1"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding ArduinoLedCountText}" />
                                            </Grid>
                                            <Grid Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Pines activos" Style="{StaticResource MutedText}" />
                                                <TextBlock x:Name="LightsArduinoPinsText"
                                                           Grid.Column="1"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding ArduinoPinsText}" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
</views:NeoTwitchView>
