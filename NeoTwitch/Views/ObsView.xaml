<views:NeoTwitchView x:Class="NeoTwitch.Views.ObsView"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     xmlns:views="clr-namespace:NeoTwitch.Views"
                     mc:Ignorable="d">
                <Grid Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="0,0,0,18">
                        <TextBlock Text="OBS"
                                   FontSize="28"
                                   Style="{StaticResource TitleText}"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Conecta Neo Twitch con OBS Studio y controla escenas desde tus alertas."
                                   Style="{StaticResource MutedText}"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <Grid Grid.Row="1"
                          Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="58" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="48"
                                        Height="48"
                                        CornerRadius="16"
                                        Background="#1A22C55E">
                                    <Image Source="/Assets/ServiceObs.png"
                                           Stretch="Uniform"
                                           Margin="8" />
                                </Border>
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Estado OBS"
                                               FontWeight="SemiBold" />
                                    <TextBlock x:Name="ObsConnectionStateText"
                                               Text="Desconectado"
                                               Foreground="#F43F5E"
                                               FontWeight="SemiBold"
                                               Margin="0,5,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2"
                                Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="38"
                                        Height="38"
                                        Background="#14B8A6"
                                        Tag="StaticBrush">
                                    <Border.OpacityMask>
                                        <ImageBrush ImageSource="/Assets/Icons/nav_obs.png"
                                                    Stretch="Uniform" />
                                    </Border.OpacityMask>
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Escena actual"
                                               Style="{StaticResource MutedText}"
                                               FontSize="12" />
                                    <TextBlock x:Name="ObsCurrentSceneText"
                                               Text="Sin escena"
                                               Foreground="#14B8A6"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Column="4"
                                Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="38"
                                        Height="38"
                                        Background="#B56CFF"
                                        Tag="StaticBrush">
                                    <Border.OpacityMask>
                                        <ImageBrush ImageSource="/Assets/Icons/media_group.png"
                                                    Stretch="Uniform" />
                                    </Border.OpacityMask>
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Escenas disponibles"
                                               Style="{StaticResource MutedText}"
                                               FontSize="12" />
                                    <TextBlock x:Name="ObsSceneCountText"
                                               Text="0"
                                               Foreground="#B56CFF"
                                               FontSize="20"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Column="6"
                                Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="38"
                                        Height="38"
                                        Background="#FACC15"
                                        Tag="StaticBrush">
                                    <Border.OpacityMask>
                                        <ImageBrush ImageSource="/Assets/Icons/icon_sync.png"
                                                    Stretch="Uniform" />
                                    </Border.OpacityMask>
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Modo estudio"
                                               Style="{StaticResource MutedText}"
                                               FontSize="12" />
                                    <TextBlock x:Name="ObsStudioModeText"
                                               Text="Desactivado"
                                               Foreground="#FACC15"
                                               FontSize="16"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.05*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="1.4*" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Conexión con OBS"
                                           FontSize="18"
                                           Style="{StaticResource TitleText}"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="Usa la configuración de Conexiones. OBS Studio debe tener WebSocket activo."
                                           Style="{StaticResource MutedText}"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,16" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Host"
                                                   Style="{StaticResource MutedText}" />
                                        <TextBlock x:Name="ObsHostSummaryText"
                                                   Text="127.0.0.1"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Puerto"
                                                   Style="{StaticResource MutedText}" />
                                        <TextBlock x:Name="ObsPortSummaryText"
                                                   Text="4455"
                                                   FontWeight="SemiBold" />
                                    </StackPanel>
                                </Grid>
                                <Separator Margin="0,16,0,14" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Version"
                                               Style="{StaticResource MutedText}" />
                                    <TextBlock x:Name="ObsVersionText"
                                               Grid.Column="1"
                                               Text="Sin version"
                                               FontWeight="SemiBold" />
                                </Grid>
                                <TextBlock x:Name="ObsStatusText"
                                           Style="{StaticResource MutedText}"
                                           TextWrapping="Wrap"
                                           Margin="0,12,0,14" />
                                <WrapPanel HorizontalAlignment="Right">
                                    <Button Content="Ver guia OBS"
                                            Click="OpenObsGuideButton_Click" />
                                    <Button x:Name="TestObsButtonPanel"
                                            Content="Actualizar escenas"
                                            Click="TestObsButton_Click" />
                                    <Button x:Name="ConnectObsButtonPanel"
                                            Content="Conectar OBS"
                                            Style="{StaticResource PrimaryButton}"
                                            Click="ConnectObsButton_Click" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2"
                                Style="{StaticResource Card}">
                            <DockPanel LastChildFill="True">
                                <Grid DockPanel.Dock="Top"
                                      Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="170" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Escenas disponibles"
                                                   FontSize="18"
                                                   Style="{StaticResource TitleText}"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="Cambia escenas o usa esta lista al configurar automatizaciones."
                                                   Style="{StaticResource MutedText}"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="Actualizar escenas"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Top"
                                            Click="TestObsButton_Click" />
                                </Grid>
                                <ListBox x:Name="ObsScenesList"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource ThemeBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="12"
                                                    Padding="12"
                                                    Margin="0,0,0,8"
                                                    Background="{DynamicResource ThemeInputBrush}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="52" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="210" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="40"
                                                            Height="40"
                                                            CornerRadius="12"
                                                            Background="#1A14B8A6"
                                                            Tag="StaticBrush">
                                                        <Border Width="22"
                                                                Height="22"
                                                                Background="#14B8A6"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Tag="StaticBrush">
                                                            <Border.OpacityMask>
                                                                <ImageBrush ImageSource="/Assets/Icons/nav_obs.png"
                                                                            Stretch="Uniform" />
                                                            </Border.OpacityMask>
                                                        </Border>
                                                    </Border>
                                                    <StackPanel Grid.Column="1"
                                                                VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding StatusText}"
                                                                   Style="{StaticResource MutedText}"
                                                                   FontSize="12" />
                                                    </StackPanel>
                                                    <WrapPanel Grid.Column="2"
                                                               HorizontalAlignment="Right"
                                                               VerticalAlignment="Center">
                                                        <Button Content="Probar 5s"
                                                                Visibility="{Binding ChangeButtonVisibility}"
                                                                Click="ObsScenePreviewButton_Click" />
                                                        <Button Content="Cambiar"
                                                                Visibility="{Binding ChangeButtonVisibility}"
                                                                Style="{StaticResource PrimaryButton}"
                                                                Click="ObsSceneChangeButton_Click" />
                                                    </WrapPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
</views:NeoTwitchView>
