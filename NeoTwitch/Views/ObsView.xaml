<views:NeoTwitchView x:Class="NeoTwitch.Views.ObsView"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     xmlns:views="clr-namespace:NeoTwitch.Views"
                     mc:Ignorable="d">
                <Grid Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="0,0,0,18">
                        <TextBlock Text="OBS"
                                   FontSize="28"
                                   Style="{StaticResource TitleText}"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Conecta Neo Twitch con OBS Studio y controla escenas desde tus alertas."
                                   Style="{StaticResource MutedText}"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <Grid Grid.Row="1"
                          Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="58" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="48"
                                        Height="48"
                                        CornerRadius="16"
                                        Background="#1A22C55E">
                                    <Image Source="/Assets/ServiceObs.png"
                                           Stretch="Uniform"
                                           Margin="8" />
                                </Border>
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Estado OBS"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ConnectionState}"
                                               Foreground="#F43F5E"
                                               FontWeight="SemiBold"
                                               Margin="0,5,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2"
                                Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="38"
                                        Height="38"
                                        Background="#14B8A6"
                                        Tag="StaticBrush">
                                    <Border.OpacityMask>
                                        <ImageBrush ImageSource="/Assets/Icons/nav_obs.png"
                                                    Stretch="Uniform" />
                                    </Border.OpacityMask>
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Escena actual"
                                               Style="{StaticResource MutedText}"
                                               FontSize="12" />
                                    <TextBlock Text="{Binding CurrentScene}"
                                               Foreground="#14B8A6"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Column="4"
                                Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="38"
                                        Height="38"
                                        Background="#B56CFF"
                                        Tag="StaticBrush">
                                    <Border.OpacityMask>
                                        <ImageBrush ImageSource="/Assets/Icons/media_group.png"
                                                    Stretch="Uniform" />
                                    </Border.OpacityMask>
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Escenas disponibles"
                                               Style="{StaticResource MutedText}"
                                               FontSize="12" />
                                    <TextBlock Text="{Binding SceneCount}"
                                               Foreground="#B56CFF"
                                               FontSize="20"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Column="6"
                                Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="38"
                                        Height="38"
                                        Background="#FACC15"
                                        Tag="StaticBrush">
                                    <Border.OpacityMask>
                                        <ImageBrush ImageSource="/Assets/Icons/icon_sync.png"
                                                    Stretch="Uniform" />
                                    </Border.OpacityMask>
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Modo estudio"
                                               Style="{StaticResource MutedText}"
                                               FontSize="12" />
                                    <TextBlock Text="{Binding StudioMode}"
                                               Foreground="#FACC15"
                                               FontSize="16"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.05*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="1.4*" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Fuente de navegador"
                                           FontSize="18"
                                           Style="{StaticResource TitleText}"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="Usa este enlace si quieres preparar un overlay de medios en OBS."
                                           Style="{StaticResource MutedText}"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,16" />
                                <TextBlock Text="URL para OBS"
                                           Style="{StaticResource MutedText}" />
                                <Grid Margin="0,4,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="ObsOverlayUrlBox"
                                             IsReadOnly="True"
                                             Margin="0" />
                                    <Button Grid.Column="2"
                                            Content="Copiar"
                                            Margin="0"
                                            Command="{Binding CopyOverlayUrlCommand}" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Ancho overlay"
                                                   Style="{StaticResource MutedText}" />
                                        <TextBox x:Name="ObsOverlayWidthBox"
                                                 TextChanged="ObsOverlaySettingsChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Alto overlay"
                                                   Style="{StaticResource MutedText}" />
                                        <TextBox x:Name="ObsOverlayHeightBox"
                                                 TextChanged="ObsOverlaySettingsChanged" />
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Ancho medio"
                                                   Style="{StaticResource MutedText}" />
                                        <TextBox x:Name="ObsOverlayMediaWidthBox"
                                                 TextChanged="ObsOverlaySettingsChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Alto medio"
                                                   Style="{StaticResource MutedText}" />
                                        <TextBox x:Name="ObsOverlayMediaHeightBox"
                                                 TextChanged="ObsOverlaySettingsChanged" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="Posición"
                                           Style="{StaticResource MutedText}"
                                           Margin="0,8,0,0" />
                                <ComboBox x:Name="ObsOverlayPositionBox"
                                          Margin="0,4,0,8"
                                          SelectedValuePath="Tag"
                                          SelectionChanged="ObsOverlaySettingsChanged">
                                    <ComboBoxItem Content="Centrada" Tag="Center" />
                                    <ComboBoxItem Content="Aleatoria" Tag="Random" />
                                    <ComboBoxItem Content="Personalizada" Tag="Custom" />
                                </ComboBox>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="X"
                                                   Style="{StaticResource MutedText}" />
                                        <TextBox x:Name="ObsOverlayXBox"
                                                 TextChanged="ObsOverlaySettingsChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Y"
                                                   Style="{StaticResource MutedText}" />
                                        <TextBox x:Name="ObsOverlayYBox"
                                                 TextChanged="ObsOverlaySettingsChanged" />
                                    </StackPanel>
                                </Grid>
                                <Separator Margin="0,16,0,14" />
                                <TextBlock Text="Estado de conexión"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding StatusText}"
                                           Style="{StaticResource MutedText}"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,10" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Host: " />
                                        <TextBlock Text="{Binding Host}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal">
                                        <TextBlock Text="Puerto: " />
                                        <TextBlock Text="{Binding Port}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2"
                                                Orientation="Horizontal">
                                        <TextBlock Text="Version: " />
                                        <TextBlock Text="{Binding Version}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2"
                                Style="{StaticResource Card}">
                            <DockPanel LastChildFill="True">
                                <Grid DockPanel.Dock="Top"
                                      Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="170" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Escenas disponibles"
                                                   FontSize="18"
                                                   Style="{StaticResource TitleText}"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="Cambia escenas o usa esta lista al configurar automatizaciones."
                                                   Style="{StaticResource MutedText}"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="Actualizar escenas"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Top"
                                            Command="{Binding RefreshScenesCommand}" />
                                </Grid>
                                <ListBox x:Name="ObsScenesList"
                                         ItemsSource="{Binding SceneRows}"
                                         IsEnabled="{Binding IsScenesEnabled}"
                                         Opacity="{Binding ScenesOpacity}"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource ThemeBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="12"
                                                    Padding="12"
                                                    Margin="0,0,0,8"
                                                    Background="{DynamicResource ThemeInputBrush}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="52" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="210" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="40"
                                                            Height="40"
                                                            CornerRadius="12"
                                                            Background="#1A14B8A6"
                                                            Tag="StaticBrush">
                                                        <Border Width="22"
                                                                Height="22"
                                                                Background="#14B8A6"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Tag="StaticBrush">
                                                            <Border.OpacityMask>
                                                                <ImageBrush ImageSource="/Assets/Icons/nav_obs.png"
                                                                            Stretch="Uniform" />
                                                            </Border.OpacityMask>
                                                        </Border>
                                                    </Border>
                                                    <StackPanel Grid.Column="1"
                                                                VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding StatusText}"
                                                                   Style="{StaticResource MutedText}"
                                                                   FontSize="12" />
                                                    </StackPanel>
                                                    <WrapPanel Grid.Column="2"
                                                               HorizontalAlignment="Right"
                                                               VerticalAlignment="Center">
                                                        <Button Content="Probar 5s"
                                                                Visibility="{Binding ChangeButtonVisibility}"
                                                                Command="{Binding DataContext.PreviewSceneCommand, RelativeSource={RelativeSource AncestorType=views:NeoTwitchView}}"
                                                                CommandParameter="{Binding Name}" />
                                                        <Button Content="Cambiar"
                                                                Visibility="{Binding ChangeButtonVisibility}"
                                                                Style="{StaticResource PrimaryButton}"
                                                                Command="{Binding DataContext.ChangeSceneCommand, RelativeSource={RelativeSource AncestorType=views:NeoTwitchView}}"
                                                                CommandParameter="{Binding Name}" />
                                                    </WrapPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
</views:NeoTwitchView>
