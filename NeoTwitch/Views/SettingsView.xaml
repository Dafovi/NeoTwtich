<views:NeoTwitchView x:Class="NeoTwitch.Views.SettingsView"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     xmlns:views="clr-namespace:NeoTwitch.Views"
                     mc:Ignorable="d">
                <Grid Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="0,0,0,18">
                        <TextBlock Text="Configuración"
                                   FontSize="28"
                                   Style="{StaticResource TitleText}"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Personaliza Neo Twitch a tu estilo."
                                   Style="{StaticResource MutedText}"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Row="0"
                                Grid.ColumnSpan="3"
                                Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Opciones generales"
                                           FontSize="16"
                                           Style="{StaticResource TitleText}"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,12" />
                                <Separator Margin="0,0,0,10" />

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="38"
                                            Height="38"
                                            CornerRadius="10"
                                            Background="#1514B8A6"
                                            Tag="StaticBrush">
                                        <Border Width="22"
                                                Height="22"
                                                Background="#14B8A6"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Tag="StaticBrush">
                                            <Border.OpacityMask>
                                                <ImageBrush ImageSource="/Assets/Icons/nav_settings.png"
                                                            Stretch="Uniform" />
                                            </Border.OpacityMask>
                                        </Border>
                                    </Border>
                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="Abrir minimizada"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="Abrir Neo Twitch en segundo plano al iniciar la app."
                                                   Style="{StaticResource MutedText}"
                                                   FontSize="12" />
                                    </StackPanel>
                                    <CheckBox x:Name="StartHiddenCheck"
                                              Grid.Column="2"
                                              Content=""
                                              Checked="GlobalSettingsChanged"
                                              Unchecked="GlobalSettingsChanged" />
                                </Grid>

                                <Separator Margin="0,0,0,10" />
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="38"
                                            Height="38"
                                            CornerRadius="10"
                                            Background="#1514B8A6"
                                            Tag="StaticBrush">
                                        <Border Width="22"
                                                Height="22"
                                                Background="#14B8A6"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Tag="StaticBrush">
                                            <Border.OpacityMask>
                                                <ImageBrush ImageSource="/Assets/Icons/nav_settings.png"
                                                            Stretch="Uniform" />
                                            </Border.OpacityMask>
                                        </Border>
                                    </Border>
                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="Iniciar con Windows"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="Abre Neo Twitch automáticamente al iniciar sesión."
                                                   Style="{StaticResource MutedText}"
                                                   FontSize="12" />
                                    </StackPanel>
                                    <CheckBox x:Name="StartWithWindowsCheck"
                                              Grid.Column="2"
                                              Content=""
                                              Checked="GlobalSettingsChanged"
                                              Unchecked="GlobalSettingsChanged" />
                                </Grid>

                                <Separator Margin="0,0,0,10" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="220" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="38"
                                            Height="38"
                                            CornerRadius="10"
                                            Background="#1514B8A6"
                                            Tag="StaticBrush">
                                        <Border Width="22"
                                                Height="22"
                                                Background="#14B8A6"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Tag="StaticBrush">
                                            <Border.OpacityMask>
                                                <ImageBrush ImageSource="/Assets/Icons/activity_theme.png"
                                                            Stretch="Uniform" />
                                            </Border.OpacityMask>
                                        </Border>
                                    </Border>
                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="Tema de la aplicación"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="Elige entre sistema, modo claro u oscuro."
                                                   Style="{StaticResource MutedText}"
                                                   FontSize="12" />
                                    </StackPanel>
                                    <ComboBox x:Name="ThemeModeBox"
                                              Grid.Column="2"
                                              SelectionChanged="ThemeModeChanged" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Grid Grid.Row="1"
                              Grid.ColumnSpan="3"
                              Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Importar / Exportar"
                                               FontSize="16"
                                               Style="{StaticResource TitleText}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="Transfiere tu configuración entre equipos fácilmente."
                                               Style="{StaticResource MutedText}"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Margin="0,8,0,14" />
                                    <Button Content="Importar configuracion"
                                            Click="ImportSettingsButton_Click" />
                                    <Button Content="Exportar configuracion"
                                            Click="ExportSettingsButton_Click" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2"
                                    Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Backups"
                                               FontSize="16"
                                               Style="{StaticResource TitleText}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="Guarda y restaura tus ajustes y configuraciones."
                                               Style="{StaticResource MutedText}"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Margin="0,8,0,14" />
                                    <Button Content="Crear backup ahora"
                                            Click="CreateBackupButton_Click" />
                                    <Button Content="Restaurar backup"
                                            Click="RestoreBackupButton_Click" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="4"
                                    Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Modo diagnóstico"
                                               FontSize="16"
                                               Style="{StaticResource TitleText}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="Herramientas útiles para resolver problemas."
                                               Style="{StaticResource MutedText}"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Margin="0,8,0,14" />
                                    <Button Content="Ejecutar diagnostico"
                                            Click="RunDiagnosticsButton_Click" />
                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,10,0,0">
                                        <Ellipse Width="10"
                                                 Height="10"
                                                 Fill="#22C55E"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,8,0" />
                                        <TextBlock x:Name="SettingsDiagnosticStatusText"
                                                   Text="Estado: Todo en orden"
                                                   Tag="Success"
                                                   Foreground="#22C55E"
                                                   FontSize="12"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="2"
                              Grid.ColumnSpan="3"
                              Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Comportamiento al cerrar"
                                               FontSize="16"
                                               Style="{StaticResource TitleText}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="Elige qué debe hacer la aplicación al cerrarse."
                                               Style="{StaticResource MutedText}"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Margin="0,6,0,14" />
                                    <CheckBox x:Name="CloseToTrayCheck"
                                              Visibility="Collapsed"
                                              Checked="GlobalSettingsChanged"
                                              Unchecked="GlobalSettingsChanged" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="CloseToTrayCard"
                                                BorderBrush="{DynamicResource ThemeSelectionBrush}"
                                                BorderThickness="1"
                                                CornerRadius="12"
                                                Padding="14"
                                                Background="{DynamicResource ThemeInputBrush}">
                                            <StackPanel>
                                                <RadioButton x:Name="CloseToTrayRadio"
                                                             Content=""
                                                             IsChecked="{Binding IsChecked, ElementName=CloseToTrayCheck}"
                                                             Checked="CloseBehaviorRadio_Checked" />
                                                <TextBlock Text="Minimizar a la bandeja"
                                                           FontWeight="SemiBold"
                                                           FontSize="12"
                                                           Margin="0,8,0,4" />
                                                <TextBlock Text="La app seguirá funcionando en segundo plano."
                                                           Style="{StaticResource MutedText}"
                                                           FontSize="11"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                        <Border x:Name="CloseAppCard"
                                                Grid.Column="2"
                                                BorderBrush="{DynamicResource ThemeBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="12"
                                                Padding="14"
                                                Background="{DynamicResource ThemeInputBrush}">
                                            <StackPanel>
                                                <RadioButton x:Name="CloseAppRadio"
                                                             Content=""
                                                             Checked="CloseBehaviorRadio_Checked" />
                                                <TextBlock Text="Cerrar aplicación"
                                                           FontWeight="SemiBold"
                                                           FontSize="12"
                                                           Margin="0,8,0,4" />
                                                <TextBlock Text="Finaliza completamente Neo Twitch."
                                                           Style="{StaticResource MutedText}"
                                                           FontSize="11"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2"
                                    Style="{StaticResource Card}">
                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Estado de la aplicación"
                                               FontSize="16"
                                               Style="{StaticResource TitleText}"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               Margin="0,0,0,16" />
                                    <Image x:Name="SettingsAppStateIcon"
                                           Source="/Assets/Icons/appstate_ok.png"
                                           Width="82"
                                           Height="82"
                                           Stretch="Uniform" />
                                    <TextBlock Text="Todo funcionando correctamente"
                                               Foreground="#22C55E"
                                               FontWeight="SemiBold"
                                               FontSize="12"
                                               HorizontalAlignment="Center"
                                               Margin="0,14,0,4" />
                                    <TextBlock Text="Neo Twitch está actualizado."
                                               Style="{StaticResource MutedText}"
                                               FontSize="12"
                                               HorizontalAlignment="Center" />
                                    <Border CornerRadius="10"
                                            Background="#2022C55E"
                                            Padding="8,3"
                                            Margin="0,12,0,0"
                                            Tag="StaticBrush">
                                        <TextBlock x:Name="SettingsVersionText"
                                                   Text="V"
                                                   Tag="Success"
                                                   Foreground="#22C55E"
                                                   FontWeight="SemiBold"
                                                   FontSize="11" />
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Grid.Row="3"
                                Grid.ColumnSpan="3"
                                Style="{StaticResource Card}"
                                Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="Cola de alertas"
                                           FontSize="16"
                                           Style="{StaticResource TitleText}"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,12" />
                                <TextBlock Text="Controla cuántas alertas se acumulan cuando Twitch manda muchas seguidas."
                                           Style="{StaticResource MutedText}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,12" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Repetidas maximas en cola"
                                                   Style="{StaticResource MutedText}" />
                                        <TextBox x:Name="MaxQueuedSameRuleAlertsBox"
                                                 TextChanged="GlobalSettingsChanged"
                                                 ToolTip="Cuantas alertas de la misma regla pueden esperar mientras otra se reproduce. 1 es el valor recomendado." />
                                        <TextBlock Text="Tiempo minimo para repetir"
                                                   Style="{StaticResource MutedText}" />
                                        <TextBox x:Name="SameRuleQueueCooldownBox"
                                                 TextChanged="GlobalSettingsChanged"
                                                 ToolTip="Milisegundos desde que empezo una regla antes de permitir otra igual. Usa 0 para desactivar este filtro." />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Distintas maximas en cola"
                                                   Style="{StaticResource MutedText}" />
                                        <TextBox x:Name="MaxQueuedDifferentRuleAlertsBox"
                                                 TextChanged="GlobalSettingsChanged"
                                                 ToolTip="Cuantas alertas de reglas distintas pueden esperar mientras otra se reproduce." />
                                        <TextBlock Text="Tiempo minimo para distintas"
                                                   Style="{StaticResource MutedText}" />
                                        <TextBox x:Name="DifferentRuleQueueCooldownBox"
                                                 TextChanged="GlobalSettingsChanged"
                                                 ToolTip="Milisegundos desde que empezo una regla antes de permitir otra distinta. Usa 0 para desactivar este filtro." />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="4"
                                Grid.ColumnSpan="3"
                                Style="{StaticResource Card}"
                                Margin="0,18,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="220" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Conexión automática"
                                               FontSize="16"
                                               Style="{StaticResource TitleText}"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,10" />
                                    <CheckBox x:Name="AutoTwitchCheck"
                                              Content="Conectar Twitch al abrir"
                                              Checked="GlobalSettingsChanged"
                                              Unchecked="GlobalSettingsChanged" />
                                    <CheckBox x:Name="AutoArduinoCheck"
                                              Content="Conectar Arduino al abrir"
                                              Checked="GlobalSettingsChanged"
                                              Unchecked="GlobalSettingsChanged" />
                                    <CheckBox x:Name="ObsAutoReconnectCheck"
                                              Content="Conectar OBS al abrir"
                                              Checked="GlobalSettingsChanged"
                                              Unchecked="GlobalSettingsChanged" />
                                    <TextBlock Text="Estas opciones intentan conectar los servicios apenas abre Neo Twitch."
                                               Style="{StaticResource MutedText}"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Margin="0,8,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Archivos de configuración"
                                               FontSize="16"
                                               Style="{StaticResource TitleText}"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,10" />
                                    <TextBlock x:Name="SettingsPathText"
                                               Style="{StaticResource MutedText}"
                                               FontSize="11"
                                               TextWrapping="Wrap" />
                                    <TextBlock x:Name="BackupPathText"
                                               Style="{StaticResource MutedText}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Margin="0,6,0,0" />
                                </StackPanel>
                                <Button Grid.Column="3"
                                        Content="Guardar configuracion"
                                        Style="{StaticResource PrimaryButton}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Click="SaveButton_Click" />
                            </Grid>
                        </Border>
                    </Grid>
                </ScrollViewer>
                </Grid>
</views:NeoTwitchView>
